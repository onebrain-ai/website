---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "OneBrain — Your AI Thinking Partner",
  description = "OneBrain — your AI thinking partner. A unified intelligence where human and AI agent co-evolve inside your Obsidian vault, learning from you as you learn from it.",
  image = "/og.png",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/brain.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://onebrain.run" />
    <meta property="og:image" content={new URL(image, Astro.site ?? Astro.url)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site ?? Astro.url)} />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,400;0,500;0,600;0,700;1,700&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- Neutral background base -->
    <div class="fixed inset-0 bg-[#020204] -z-[10]"></div>
    <canvas id="neural-canvas"></canvas>
    <slot />

    <script is:inline>
      // Site-wide neural canvas. Tuned for Safari: pauses when tab hidden,
      // pauses when canvas is offscreen, throttles mousemove, and skips frames
      // on slow devices. Nothing else on this canvas — keep it cheap.
      (function() {
        const canvas = document.getElementById('neural-canvas');
        if (!canvas) return;
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const ctx = canvas.getContext('2d', { alpha: true });
        let width, height, dpr;
        let nodes = [];
        const nodeCount = 40;
        const maxDistanceSq = 200 * 200;
        const mouse = { x: null, y: null, radius: 150 };
        let running = true;
        let visible = true;
        let rafId = 0;

        function init() {
          dpr = Math.min(window.devicePixelRatio || 1, 1.5);
          width = window.innerWidth;
          height = window.innerHeight;
          canvas.width = width * dpr;
          canvas.height = height * dpr;
          ctx.setTransform(1, 0, 0, 1, 0, 0);
          ctx.scale(dpr, dpr);
          canvas.style.width = width + 'px';
          canvas.style.height = height + 'px';
          nodes = [];
          for (let i = 0; i < nodeCount; i++) {
            nodes.push({
              x: Math.random() * width,
              y: Math.random() * height,
              vx: (Math.random() - 0.5) * 0.4,
              vy: (Math.random() - 0.5) * 0.4,
            });
          }
        }

        function draw() {
          rafId = 0;
          if (!running || !visible || reduced) return;
          ctx.clearRect(0, 0, width, height);
          for (const node of nodes) {
            node.x += node.vx;
            node.y += node.vy;
            if (mouse.x !== null) {
              const dx = node.x - mouse.x;
              const dy = node.y - mouse.y;
              const distSq = dx * dx + dy * dy;
              if (distSq < mouse.radius * mouse.radius) {
                const dist = Math.sqrt(distSq);
                const force = (mouse.radius - dist) / mouse.radius;
                node.x += (dx / dist) * force * 2;
                node.y += (dy / dist) * force * 2;
              }
            }
            if (node.x < 0 || node.x > width) node.vx *= -1;
            if (node.y < 0 || node.y > height) node.vy *= -1;
            ctx.beginPath();
            ctx.arc(node.x, node.y, 1.5, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(255, 255, 255, 0.15)';
            ctx.fill();
          }
          ctx.lineWidth = 0.5;
          for (let i = 0; i < nodes.length; i++) {
            const ni = nodes[i];
            for (let j = i + 1; j < nodes.length; j++) {
              const nj = nodes[j];
              const dx = ni.x - nj.x;
              const dy = ni.y - nj.y;
              const distSq = dx * dx + dy * dy;
              if (distSq < maxDistanceSq) {
                const opacity = (1 - Math.sqrt(distSq) / 200) * 0.1;
                ctx.beginPath();
                ctx.moveTo(ni.x, ni.y);
                ctx.lineTo(nj.x, nj.y);
                ctx.strokeStyle = 'rgba(255, 255, 255, ' + opacity + ')';
                ctx.stroke();
              }
            }
          }
          rafId = requestAnimationFrame(draw);
        }

        function start() {
          if (!rafId && running && visible && !reduced) rafId = requestAnimationFrame(draw);
        }

        // Pause when tab is hidden — Safari especially benefits.
        document.addEventListener('visibilitychange', () => {
          visible = !document.hidden;
          if (visible) start();
        });
        // Pause when canvas is fully off-screen (page scrolled past hero area).
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver((entries) => {
            running = entries[0].isIntersecting;
            if (running) start();
          }, { rootMargin: '200px' });
          io.observe(canvas);
        }
        // Throttle mousemove to ~30Hz so Safari isn't burning a full frame on each input event.
        let mouseTick = 0;
        window.addEventListener('mousemove', (e) => {
          const now = performance.now();
          if (now - mouseTick < 32) return;
          mouseTick = now;
          mouse.x = e.clientX;
          mouse.y = e.clientY;
        }, { passive: true });
        window.addEventListener('resize', init);
        init();
        start();
      })();

      (function() {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) entry.target.classList.add('active');
          });
        }, { threshold: 0.1 });
        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
      })();
    </script>
  </body>
</html>
