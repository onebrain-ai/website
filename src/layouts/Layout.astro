---
import "../styles/global.css";
import Brain from "../components/Brain.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "OneBrain — AI Thinking Partner for Obsidian",
  description = "OneBrain is a living intelligence layer inside your Obsidian vault — you teach the agent, the agent extends you, both evolve.",
  image = "/og.jpg",
} = Astro.props;
const canonical = "https://onebrain.run/";
const ogImageUrl = `https://onebrain.run${image}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/brain.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@onebrain_run" />
    <meta name="twitter:creator" content="@onebrain_run" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://onebrain.run/#organization",
          "name": "OneBrain",
          "url": canonical,
          "logo": "https://onebrain.run/brain.svg",
          "sameAs": [
            "https://github.com/onebrain-ai",
            "https://x.com/onebrain_run",
            "https://www.npmjs.com/package/@onebrain-ai/cli"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://onebrain.run/#website",
          "url": canonical,
          "name": "OneBrain",
          "description": description,
          "publisher": { "@id": "https://onebrain.run/#organization" },
          "inLanguage": "en"
        },
        {
          "@type": "SoftwareApplication",
          "name": "OneBrain",
          "applicationCategory": "DeveloperApplication",
          "operatingSystem": "macOS, Linux, Windows",
          "url": canonical,
          "description": description,
          "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
          "publisher": { "@id": "https://onebrain.run/#organization" }
        }
      ]
    })} />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <!-- Font weights trimmed to actually-used set: Chakra Petch
         italic 700 (every cyber-h2 + the LCP hero h1) plus regular
         700 for the nav wordmark; Inter regular + 700 for body
         emphasis; JetBrains Mono regular + 700 for code/UI mono.
         Old set loaded 14 weights — ~150KB of font CSS — the trim
         drops the LCP critical path by ~80KB.

         The `media="print" onload="this.media='all'"` trick fetches
         the stylesheet immediately as a low-priority resource (no
         render-block), then promotes it to "all" media on load so
         the styles take effect. Tried adding `<link rel="preload"
         as="style">` to bump the priority but the browser raises a
         "preload not used within seconds of load" warning because
         the consumer link starts with media="print" and doesn't
         match the preload as a consumer until the onload swap.
         The non-preload version is the cleanest path — preconnect
         already shaved the DNS + TLS handshake. -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,700;1,700&family=Inter:wght@400;700&family=JetBrains+Mono:wght@400;700&display=swap" media="print" onload="this.media='all'">
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,700;1,700&family=Inter:wght@400;700&family=JetBrains+Mono:wght@400;700&display=swap">
    </noscript>

    <!-- Stash any incoming hash before the browser performs its default scroll-to-id.
         The main script will replay it as a warp on load. Has to live in <head>
         so it runs before paint. Also pin scroll restoration to manual so a
         refresh always lands at the top of the document (or the hash target),
         not at whatever scroll position the browser remembered from last visit. -->
    <script is:inline>
      (function () {
        if ('scrollRestoration' in history) {
          history.scrollRestoration = 'manual';
        }
        if (location.hash && location.hash.length > 1) {
          window.__obPendingHash = location.hash;
          history.replaceState(null, '', location.pathname + location.search);
        }
      })();
    </script>
  </head>
  <body>
    <!-- Neutral background base -->
    <div class="fixed inset-0 bg-[#020204] -z-[10]"></div>
    <canvas id="neural-canvas"></canvas>

    <!-- Section spine — fixed right-edge HUD that visualizes scroll position
         and ties every section together with a gradient through their accents. -->
    <aside id="page-spine" class="page-spine" aria-hidden="true">
      <div class="page-spine-track"></div>
      <ol class="page-spine-dots">
        <li data-target="#top"      style="--dot-accent: #ff2d92;"><span></span></li>
        <li data-target="#features" style="--dot-accent: #00ff9d;"><span></span></li>
        <li data-target="#synergy"  style="--dot-accent: #ff2d92;"><span></span></li>
        <li data-target="#stack"    style="--dot-accent: #00f3ff;"><span></span></li>
        <li data-target="#workflow" style="--dot-accent: #7c3aed;"><span></span></li>
        <li data-target="#session"  style="--dot-accent: #c8ff00;"><span></span></li>
        <li data-target="#commands" style="--dot-accent: #ff5e3a;"><span></span></li>
        <li data-target="#cloud"    style="--dot-accent: #00bfff;"><span></span></li>
      </ol>
    </aside>

    <!-- Warp overlay — fullscreen scanline that sweeps up to clear the current
         section, then a hash jump teleports to the target. The new section's
         own boot-sequence scanline sweeps down on arrival. -->
    <div id="warp-overlay" class="warp-overlay" aria-hidden="true"></div>
    <div id="warp-blackout" class="warp-blackout" aria-hidden="true">
      <div class="warp-grid" aria-hidden="true"></div>
      <div class="warp-mark">
        <div class="warp-mark-brain"><Brain size={108} /></div>
        <span class="warp-mark-text">OneBrain</span>
        <span class="warp-mark-status">
          <span class="warp-mark-dot"></span>
          <span>WARP // SECTION_TRANSFER</span>
        </span>
      </div>
    </div>

    <slot />

    <script is:inline>
      // Site-wide neural canvas. Tuned for Safari: pauses when tab hidden,
      // pauses when canvas is offscreen, throttles mousemove, and skips frames
      // on slow devices. Nothing else on this canvas — keep it cheap.
      // Whole boot is deferred to requestIdleCallback so canvas init +
      // particle alloc don't compete with the LCP h1 paint.
      function __obNeuralBoot() {
        const canvas = document.getElementById('neural-canvas');
        if (!canvas) return;
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const ctx = canvas.getContext('2d', { alpha: true });
        let width, height, dpr;
        let nodes = [];
        const nodeCount = 28;
        const maxDistanceSq = 200 * 200;
        const mouse = { x: null, y: null, radius: 150 };
        // Derive from mouse.radius so a future tweak doesn't drift —
        // dropped a hand-coded `150 * 150` literal that could go stale.
        const mouseRadiusSq = mouse.radius * mouse.radius;
        let running = true;
        let visible = true;
        let rafId = 0;
        let lastFrame = 0;

        function init() {
          if (reduced) return;
          if (rafId) { cancelAnimationFrame(rafId); rafId = 0; }
          dpr = Math.min(window.devicePixelRatio || 1, 1.5);
          width = window.innerWidth;
          height = window.innerHeight;
          if (!width || !height) return;
          canvas.width = width * dpr;
          canvas.height = height * dpr;
          ctx.setTransform(1, 0, 0, 1, 0, 0);
          ctx.scale(dpr, dpr);
          canvas.style.width = width + 'px';
          canvas.style.height = height + 'px';
          nodes = [];
          for (let i = 0; i < nodeCount; i++) {
            nodes.push({
              x: Math.random() * width,
              y: Math.random() * height,
              vx: (Math.random() - 0.5) * 0.4,
              vy: (Math.random() - 0.5) * 0.4,
            });
          }
        }

        // Throttle to ~30 fps. Background ambience doesn't need 60.
        function draw(now) {
          rafId = 0;
          if (!running || !visible || reduced) return;
          if (now && now - lastFrame < 33) {
            rafId = requestAnimationFrame(draw);
            return;
          }
          lastFrame = now || 0;
          ctx.clearRect(0, 0, width, height);
          const len = nodes.length;
          const mx = mouse.x;
          const my = mouse.y;
          const mr = mouse.radius;
          for (let i = 0; i < len; i++) {
            const node = nodes[i];
            node.x += node.vx;
            node.y += node.vy;
            if (mx !== null) {
              const dx = node.x - mx;
              const dy = node.y - my;
              const distSq = dx * dx + dy * dy;
              // distSq > 0 guards a NaN drift if cursor lands exactly on a node.
              if (distSq < mouseRadiusSq && distSq > 0) {
                const dist = Math.sqrt(distSq);
                const force = (mr - dist) / mr;
                node.x += (dx / dist) * force * 2;
                node.y += (dy / dist) * force * 2;
              }
            }
            if (node.x < 0 || node.x > width) node.vx *= -1;
            if (node.y < 0 || node.y > height) node.vy *= -1;
            ctx.beginPath();
            ctx.arc(node.x, node.y, 1.5, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(255, 255, 255, 0.15)';
            ctx.fill();
          }
          ctx.lineWidth = 0.5;
          for (let i = 0; i < len; i++) {
            const ni = nodes[i];
            for (let j = i + 1; j < len; j++) {
              const nj = nodes[j];
              const dx = ni.x - nj.x;
              const dy = ni.y - nj.y;
              const distSq = dx * dx + dy * dy;
              if (distSq < maxDistanceSq) {
                const opacity = (1 - Math.sqrt(distSq) / 200) * 0.1;
                ctx.beginPath();
                ctx.moveTo(ni.x, ni.y);
                ctx.lineTo(nj.x, nj.y);
                ctx.strokeStyle = 'rgba(255, 255, 255, ' + opacity + ')';
                ctx.stroke();
              }
            }
          }
          rafId = requestAnimationFrame(draw);
        }

        function start() {
          if (!rafId && running && visible && !reduced) rafId = requestAnimationFrame(draw);
        }
        function stopRaf() { if (rafId) { cancelAnimationFrame(rafId); rafId = 0; } }

        // Pause when tab is hidden — Safari especially benefits.
        document.addEventListener('visibilitychange', () => {
          visible = !document.hidden;
          if (visible) start(); else stopRaf();
        });
        // The canvas itself is fixed/viewport-sized so it would always be
        // "intersecting" — observe the hero element instead. Once the user
        // scrolls past the hero, the background ambience is no longer
        // visible (other sections have their own grid/orb bg) so we stop
        // running entirely. Massive main-thread win on long scrolls.
        if ('IntersectionObserver' in window) {
          const heroEl = document.getElementById('top') || canvas;
          const io = new IntersectionObserver((entries) => {
            running = entries[0].isIntersecting;
            if (running) start(); else stopRaf();
          }, { rootMargin: '0px' });
          io.observe(heroEl);
        }
        // Throttle mousemove to ~30Hz so Safari isn't burning a full frame on each input event.
        let mouseTick = 0;
        window.addEventListener('mousemove', (e) => {
          const now = performance.now();
          if (now - mouseTick < 32) return;
          mouseTick = now;
          mouse.x = e.clientX;
          mouse.y = e.clientY;
        }, { passive: true });
        // Debounced resize — mobile address-bar slides + dev-tools
        // toggles otherwise reallocate the GPU buffer + re-randomise
        // nodes on every event.
        let resizeTimer = 0;
        window.addEventListener('resize', () => {
          if (resizeTimer) clearTimeout(resizeTimer);
          resizeTimer = setTimeout(init, 200);
        }, { passive: true });
        init();
        start();
      }
      if ('requestIdleCallback' in window) {
        requestIdleCallback(__obNeuralBoot, { timeout: 1500 });
      } else {
        setTimeout(__obNeuralBoot, 200);
      }

      (function() {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) entry.target.classList.add('active');
          });
        }, { threshold: 0.1 });
        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
      })();

      // ────────────────────────────────────────────────────────────
      // Pill TYPEWRITER — types each section's eyebrow text in
      // character-by-character when the section first scrolls into
      // view (and again on warp arrival, see warpTo below).
      // Pre-clears every cyber-pill text span on load so it starts
      // blank, then types in once per section. The blinking caret
      // shows while data-typing="1" via CSS in global.css.
      // Skipped entirely when prefers-reduced-motion is set or when
      // the page has no cyber-pills (e.g. /404).
      // ────────────────────────────────────────────────────────────
      (function () {
        // Only pre-clear pills that the IntersectionObserver below will
        // re-type. Pills outside a `.cyber-section.reveal` (e.g. the
        // `ONEBRAIN // LEGAL` pill on /privacy) would otherwise be
        // cleared and never restored, leaving an empty pill on screen.
        const pills = document.querySelectorAll('.cyber-section.reveal .cyber-pill > span:not(.cyber-pill-dot)');
        if (!pills.length) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        pills.forEach((span) => {
          if (span.dataset.original != null) return;
          span.dataset.original = span.textContent || '';
          span.textContent = '';
        });

        function typeInSection(section) {
          const span = section.querySelector('.cyber-pill > span:not(.cyber-pill-dot)');
          if (!span) return;
          const target = span.dataset.original || '';
          if (!target) return;
          const pill = span.parentElement;
          if (pill) pill.dataset.typing = '1';
          span.textContent = '';
          let i = 0;
          // Match the pill fade-rise delay (0.1s) + a small buffer so
          // the first character appears as the pill becomes visible.
          setTimeout(function step() {
            if (i <= target.length) {
              span.textContent = target.slice(0, i);
              i++;
              setTimeout(step, 22);
            } else {
              if (pill) pill.dataset.typing = '0';
            }
          }, 220);
        }

        // Expose so warpTo can re-fire on warp arrival.
        window.__obTypewriter = typeInSection;

        // Each section types only once on first reveal — subsequent
        // re-entries (scroll back) keep the already-typed text static.
        const typed = new WeakSet();
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver((entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting && !typed.has(e.target)) {
                typed.add(e.target);
                typeInSection(e.target);
              }
            });
          }, { threshold: 0.1 });
          document.querySelectorAll('.cyber-section.reveal').forEach((s) => io.observe(s));
        }
        // Also expose the typed registry so warpTo can clear it for the
        // target section, forcing a re-type on warp arrival.
        window.__obTypedSet = typed;
      })();

      // Section visibility: tag every <section> with data-vis="off" while it
      // is outside the viewport, and "on" while it is intersecting. CSS rules
      // in global.css use this attribute to drop animation-name to none on
      // every continuous CSS animation in that section, releasing the
      // animation pipeline (no compositor work, no keyframe interpolation,
      // no memory) while the user is reading another part of the page.
      // rootMargin:200px so animations spin up just before the section
      // scrolls into view — no visible "boot" lag.
      (function() {
        const sections = document.querySelectorAll('section[id]');
        if (!sections.length) return;
        sections.forEach((s) => { s.dataset.vis = 'off'; });
        const visObs = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            e.target.dataset.vis = e.isIntersecting ? 'on' : 'off';
          });
        }, { rootMargin: '200px 0px', threshold: 0 });
        sections.forEach((s) => visObs.observe(s));
      })();

      // Section spine: highlight the active dot via IntersectionObserver.
      // The active dot itself is the indicator — it grows + glows in the
      // section's accent and stays snapped to the section it represents.
      (function () {
        const spine = document.getElementById('page-spine');
        if (!spine) return;
        const dots = Array.from(spine.querySelectorAll('.page-spine-dots li'));
        const sections = dots.map((d) => document.querySelector(d.dataset.target)).filter(Boolean);
        if (!sections.length) return;

        // Every header nav link (desktop + mobile drawer) tagged with
        // its href, so the active-section observer can highlight the
        // matching links as the user scrolls (or after a spine-dot
        // click). Both copies of each link get the class — Map-by-
        // href would have collapsed the desktop+drawer pair into one
        // and missed the visible desktop link. Hero (#top) has no
        // header link — when hero is active every link clears.
        const navLinks = Array.from(
          document.querySelectorAll('header a[href^="#"]')
        ).map((a) => ({ el: a, href: a.getAttribute('href') }));

        let activeIdx = -1;
        function setActive(i) {
          if (i === activeIdx) return;
          activeIdx = i;
          dots.forEach((d, j) => d.classList.toggle('active', j === i));
          // Body tint: lets future global accents (e.g. cursor glow) follow current section.
          document.body.style.setProperty('--page-accent', dots[i].style.getPropertyValue('--dot-accent'));
          // Mirror active state on the header nav so scroll + spine-
          // dot clicks (not just header clicks) highlight the right
          // menu item.
          const activeHref = dots[i].dataset.target;
          navLinks.forEach(({ el, href }) => {
            el.classList.toggle('is-active', href === activeHref);
          });
        }

        const io = new IntersectionObserver((entries) => {
          // Pick the entry with the largest intersection ratio.
          let best = null;
          for (const e of entries) {
            if (e.isIntersecting && (!best || e.intersectionRatio > best.intersectionRatio)) best = e;
          }
          if (best) {
            const idx = sections.indexOf(best.target);
            if (idx >= 0) setActive(idx);
          }
          // threshold: [0.5] means each section fires its callback once
          // crossing the 50% mark instead of three times (25/50/75).
          // Cuts spine-IO callback volume per scroll transit by ~3×;
          // visual behavior identical because setActive() always picks
          // the section with the highest ratio, and a section only
          // becomes "active" once it owns ≥50% of the viewport anyway.
        }, { threshold: 0.5 });
        sections.forEach((s) => io.observe(s));

        // Click-to-jump uses the warp transition.
        dots.forEach((d) => {
          d.addEventListener('click', () => warpTo(d.dataset.target));
        });
      })();

      // Warp transition — bottom→top scanline clears the current section,
      // page jumps instantly, the new section's own boot-sequence handles
      // the top→bottom reveal. Used by header nav links, spine dots, and
      // any external/initial hash navigation.
      let warpInFlight = false;
      // Hero uses scroll-margin-top:-64px so it underlaps the sticky nav by
      // design — but scrollIntoView in Safari mishandles negative scroll-
      // margins together with scroll-snap mandatory, leaving content tucked
      // partly under the nav after a warp. Force an explicit scroll-to-top
      // for #top instead; every other section uses scrollIntoView with the
      // standard scroll-padding-top:64 baseline.
      function jumpTo(t, targetSel) {
        if (targetSel === '#top') {
          window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
        } else {
          t.scrollIntoView({ block: 'start', behavior: 'instant' });
        }
      }
      // Cache once at script init so the click → warp hot path does
      // zero DOM lookups. Saves a getElementById × 2, a querySelector,
      // and a matchMedia query per click — small in absolute time but
      // measurable on Safari's main thread when other animations are
      // already contending for the paint slot.
      const _warpOverlay = document.getElementById('warp-overlay');
      const _warpBlackout = document.getElementById('warp-blackout');
      const _reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
      function warpTo(targetSel) {
        if (warpInFlight) return;
        const t = document.querySelector(targetSel);
        if (!t) return;
        if (_reducedMotion.matches) {
          jumpTo(t, targetSel);
          return;
        }
        warpInFlight = true;
        if (_warpOverlay) _warpOverlay.classList.add('warp-out');
        if (_warpBlackout) _warpBlackout.classList.add('warp-on');
        // Jump mid-hold (sweep up done at ~0.8s, blackout fully opaque
        // 0.8–1.5s). Hash jump + boot replay happen at 1.2s so the new
        // section's scanline starts under cover and emerges as the
        // blackout fades — sweep-down + content-rise read as one beat.
        setTimeout(() => {
          jumpTo(t, targetSel);
          // Always replay the boot scanline on arrival — strip + reflow
          // + add. Hero gets .active here too (it never had .active
          // applied otherwise, since hero relies on its own intro
          // animations on initial load), which fires its own ::after
          // scanline and makes the warp arrival read identically across
          // every section.
          t.classList.remove('active');
          void t.offsetWidth;
          t.classList.add('active');
          // Re-fire the eyebrow typewriter on warp arrival. The
          // intersection-driven observer only types each section once;
          // a deliberate warp click is a "re-enter the section" gesture
          // that should replay the choreography, including the type-in.
          if (window.__obTypewriter && t.classList.contains('cyber-section')) {
            if (window.__obTypedSet) window.__obTypedSet.delete(t);
            window.__obTypewriter(t);
          }
        }, 1200);
        setTimeout(() => {
          if (_warpOverlay) _warpOverlay.classList.remove('warp-out');
          if (_warpBlackout) _warpBlackout.classList.remove('warp-on');
          warpInFlight = false;
        }, 1720);
      }

      // Pre-resolve every header link's hash target into a WeakMap so
      // the click hot path is just one Map.get + one warpTo call —
      // no closest() walk, no getAttribute, no querySelector.
      const _headerLinks = new WeakMap();
      document.querySelectorAll('header a[href^="#"]').forEach((a) => {
        const href = a.getAttribute('href');
        if (!href || href === '#') return;
        if (!document.querySelector(href)) return;
        _headerLinks.set(a, href);
      });
      // Document-level mousedown at the capture phase — fires before
      // any per-element handler in the entire DOM tree. Crucially we
      // do NOT call e.preventDefault(): preventDefault on a mousedown
      // that lands on an <a> makes Safari run extra link-activation
      // gating before the handler is allowed to do anything else.
      // Navigation is suppressed by the click handler below where it
      // actually matters; warpInFlight absorbs the click re-fire.
      document.addEventListener('mousedown', (e) => {
        if (e.button !== 0) return;
        // parentElement walk is faster than closest() with a CSS
        // selector — header is shallow (4–5 levels max), and we only
        // accept exact <a> hits that are pre-registered in the map.
        let n = e.target;
        while (n && n.tagName !== 'A') n = n.parentElement;
        if (!n) return;
        const href = _headerLinks.get(n);
        if (!href) return;
        warpTo(href);
      }, { capture: true });
      // Click runs after release; warpInFlight has already latched,
      // so this is here to suppress the native hash navigation that
      // mousedown deliberately didn't prevent. Keyboard activation
      // (Enter/Space on a focused link) lands here too — keyboard
      // users get warpTo from this path.
      document.addEventListener('click', (e) => {
        let n = e.target;
        while (n && n.tagName !== 'A') n = n.parentElement;
        if (!n) return;
        const href = _headerLinks.get(n);
        if (!href) return;
        e.preventDefault();
        warpTo(href);
        // Safari macOS keeps `:hover` sticky on the clicked link until
        // the pointer moves. With arrow-key scrolling the pointer
        // never moves, so the original link still renders its hover
        // brackets while the IntersectionObserver flips `.is-active`
        // to a different link — two active-looking items at once.
        //
        // Toggling `pointer-events: none` is the most reliable
        // browser-portable fix: it forces the browser to recompute
        // hit-testing, drops `:hover` off the just-clicked element,
        // and the next paint shows it without brackets. We restore
        // pointer-events on the next animation frame so a second
        // click is responsive immediately. We also blur to release
        // focus, and tag `body.suppress-hover` as a CSS-side belt &
        // braces — cleared on the first mousemove.
        n.blur();
        const _pe = n.style.pointerEvents;
        n.style.pointerEvents = 'none';
        requestAnimationFrame(() => requestAnimationFrame(() => {
          n.style.pointerEvents = _pe;
        }));
        document.body.classList.add('suppress-hover');
        // First pointer move clears the suppression class — by then
        // the browser has dropped sticky :hover or re-evaluated it
        // against the new cursor position. Bound here with `once: true`
        // so it self-removes after firing, instead of running a no-op
        // classList check on every mousemove for the rest of the
        // session.
        document.addEventListener('mousemove', () => {
          document.body.classList.remove('suppress-hover');
        }, { passive: true, once: true });
      });

      // External / initial hash navigation also plays the warp:
      //   - URL with a hash on first load (stashed in <head>, replayed here)
      //   - browser back/forward across hashes
      //   - cross-tab links / pasted URLs
      // Internal nav (header links + spine dots) uses preventDefault and
      // doesn't update location.hash, so it never reaches this listener.
      (function () {
        const pending = window.__obPendingHash;
        if (pending && document.querySelector(pending)) {
          // Hero is the natural starting frame for the warp-in.
          window.scrollTo(0, 0);
          requestAnimationFrame(() => warpTo(pending));
        }
        window.addEventListener('hashchange', () => {
          if (location.hash && document.querySelector(location.hash)) {
            warpTo(location.hash);
          }
        });
      })();
    </script>
  </body>
</html>
