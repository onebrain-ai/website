---
// 3-step session loop: CAPTURE → EVOLVE → WRAPUP, then back to
// CAPTURE. Each cycle the vault grows and the agent learns more
// about you — both sides sharpen. (Install + /onboarding is a
// one-time bootstrap and lives in the Hero install line, not here.)
const steps = [
  {
    n: '01',
    t: 'CAPTURE',
    d: 'Talk to the agent in natural language. It writes, classifies, and links your thoughts in real time.',
    code: '/braindump · /capture · /bookmark',
    accent: '#ff2d92',
  },
  {
    n: '02',
    t: 'EVOLVE',
    d: '/research and /distill expand your knowledge. /learn deepens the agent. The loop tightens.',
    code: '/research · /distill · /learn',
    accent: '#bc13fe',
  },
  {
    n: '03',
    t: 'WRAPUP',
    d: '/wrapup consolidates the session log. /recap promotes lessons to memory.',
    code: '/wrapup · /recap',
    accent: '#00f3ff',
  },
];
---

<section id="how" class="cyber-section reveal" style="--section-accent: #c8ff00;">
  <div class="cyber-section-orb" aria-hidden="true"></div>
  <div class="cyber-section-grid" aria-hidden="true"></div>

  <div class="cyber-section-shell">
    <div class="grid lg:grid-cols-[3fr_2fr] gap-10 lg:gap-16 items-center how-grid">

      <!-- LEFT: header + step list -->
      <div class="how-left">
        <header class="cyber-section-head">
          <div class="cyber-pill">
            <span class="cyber-pill-dot"></span>
            <span>ONEBRAIN // PROTOCOL</span>
          </div>
          <h2 class="cyber-h2">
            Every Session<br/>
            <span class="cyber-h2-stroke">Sharpens Both.</span>
          </h2>
          <p class="cyber-sub">
            <strong class="brand">OneBrain</strong> runs as a tight 3-step loop. Each cycle, both sides sharpen.
          </p>
        </header>

        <ol class="how-steps">
          {steps.map((s) => (
            <li class="how-step" style={`--step-accent: ${s.accent};`}>
              <span class="how-step-num">{s.n}</span>
              <div class="how-step-body">
                <h3 class="how-step-title">{s.t}</h3>
                {s.d && <p class="how-step-desc">{s.d}</p>}
                <code class="how-step-code">{s.code}</code>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <!-- RIGHT: animated triangle loop -->
      <div class="how-loop" role="img" aria-label="Three-step closed loop: 01 CAPTURE flows to 02 EVOLVE, then to 03 WRAPUP, then back to 01. Each revolution sharpens both human and agent.">
        <span class="how-loop-corner how-loop-corner-tl" aria-hidden="true"></span>
        <span class="how-loop-corner how-loop-corner-tr" aria-hidden="true"></span>
        <span class="how-loop-corner how-loop-corner-bl" aria-hidden="true"></span>
        <span class="how-loop-corner how-loop-corner-br" aria-hidden="true"></span>

        <div class="how-loop-band" aria-hidden="true">
          <span class="how-loop-band-dot"></span>
          <span class="how-loop-band-label">CO_EVOLUTION_LOOP · CW</span>
          <span class="how-loop-band-meta">RUNS_FOREVER</span>
        </div>

        <svg class="how-loop-svg" viewBox="-225 -200 450 395" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          <defs>
            <marker id="how-ah-1" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M 0 0 L 10 5 L 0 10 z" fill="#ff2d92"/>
            </marker>
            <marker id="how-ah-2" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M 0 0 L 10 5 L 0 10 z" fill="#bc13fe"/>
            </marker>
            <marker id="how-ah-3" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M 0 0 L 10 5 L 0 10 z" fill="#00f3ff"/>
            </marker>
          </defs>

          <!-- Outer guide ring (slowly rotating dashed circle) -->
          <circle class="how-loop-ring" cx="0" cy="0" r="180" fill="none" stroke="rgba(255, 255, 255, 0.18)" stroke-width="1" stroke-dasharray="3 6"/>
          <circle cx="0" cy="0" r="180" fill="none" stroke="rgba(200, 255, 0, 0.08)" stroke-width="1"/>

          <!-- 01 → 02 (magenta arc) -->
          <g class="how-leg how-leg-1">
            <path id="how-path-1" d="M 27 -83.2 Q 82.2 -47.5 85.6 18.2" fill="none" stroke="#ff2d92" stroke-width="1.6" stroke-opacity="0.6" marker-end="url(#how-ah-1)"/>
            <circle r="5" fill="#ff2d92" class="how-flow-dot how-flow-dot-1">
              <animateMotion dur="6.6s" repeatCount="indefinite" rotate="auto">
                <mpath href="#how-path-1"/>
              </animateMotion>
            </circle>
          </g>

          <!-- 02 → 03 (violet arc) -->
          <g class="how-leg how-leg-2">
            <path id="how-path-2" d="M 58.6 65 Q 0 110 -58.6 65" fill="none" stroke="#bc13fe" stroke-width="1.6" stroke-opacity="0.6" marker-end="url(#how-ah-2)"/>
            <circle r="5" fill="#bc13fe" class="how-flow-dot how-flow-dot-2">
              <animateMotion dur="6.6s" begin="2.2s" repeatCount="indefinite" rotate="auto">
                <mpath href="#how-path-2"/>
              </animateMotion>
            </circle>
          </g>

          <!-- 03 → 01 (cyan arc) — closes the loop -->
          <g class="how-leg how-leg-3">
            <path id="how-path-3" d="M -85.6 18.2 Q -82.2 -47.5 -27 -83.2" fill="none" stroke="#00f3ff" stroke-width="1.6" stroke-opacity="0.6" marker-end="url(#how-ah-3)"/>
            <circle r="5" fill="#00f3ff" class="how-flow-dot how-flow-dot-3">
              <animateMotion dur="6.6s" begin="4.4s" repeatCount="indefinite" rotate="auto">
                <mpath href="#how-path-3"/>
              </animateMotion>
            </circle>
          </g>

          <!-- Node 01 — CAPTURE (top of triangle).
               Number + name go inside the circle; the cmd label sits
               OUTSIDE below the circle so long strings can never
               overflow the disc. -->
          <g class="how-node" transform="translate(0,-130)">
            <circle r="56" fill="rgba(8, 8, 14, 0.95)" stroke="#ff2d92" stroke-width="1.5"/>
            <circle r="56" fill="none" stroke="#ff2d92" stroke-width="1" stroke-opacity="0.4" class="how-node-pulse"/>
            <text x="0" y="-8" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="11" font-weight="700" fill="#ff2d92" letter-spacing="0.18em">01</text>
            <text x="0" y="12" text-anchor="middle" font-family="'Chakra Petch', sans-serif" font-style="italic" font-weight="700" font-size="15" letter-spacing="0.05em" fill="#fff">CAPTURE</text>
            <text x="0" y="74" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="9" letter-spacing="0.24em" fill="#ff2d92">/braindump</text>
          </g>

          <!-- Node 02 — EVOLVE (bottom-right) -->
          <g class="how-node" transform="translate(112.6,65)">
            <circle r="56" fill="rgba(8, 8, 14, 0.95)" stroke="#bc13fe" stroke-width="1.5"/>
            <circle r="56" fill="none" stroke="#bc13fe" stroke-width="1" stroke-opacity="0.4" class="how-node-pulse" style="animation-delay: 1.2s;"/>
            <text x="0" y="-8" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="11" font-weight="700" fill="#bc13fe" letter-spacing="0.18em">02</text>
            <text x="0" y="12" text-anchor="middle" font-family="'Chakra Petch', sans-serif" font-style="italic" font-weight="700" font-size="15" letter-spacing="0.05em" fill="#fff">EVOLVE</text>
            <text x="0" y="74" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="9" letter-spacing="0.24em" fill="#bc13fe">/distill · /learn</text>
          </g>

          <!-- Node 03 — WRAPUP (bottom-left) -->
          <g class="how-node" transform="translate(-112.6,65)">
            <circle r="56" fill="rgba(8, 8, 14, 0.95)" stroke="#00f3ff" stroke-width="1.5"/>
            <circle r="56" fill="none" stroke="#00f3ff" stroke-width="1" stroke-opacity="0.4" class="how-node-pulse" style="animation-delay: 2.4s;"/>
            <text x="0" y="-8" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="11" font-weight="700" fill="#00f3ff" letter-spacing="0.18em">03</text>
            <text x="0" y="12" text-anchor="middle" font-family="'Chakra Petch', sans-serif" font-style="italic" font-weight="700" font-size="15" letter-spacing="0.05em" fill="#fff">WRAPUP</text>
            <text x="0" y="74" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="9" letter-spacing="0.24em" fill="#00f3ff">/wrapup · /recap</text>
          </g>
        </svg>

        <div class="how-loop-foot" aria-hidden="true">
          <span class="how-loop-foot-mute">EVERY_CYCLE_TIGHTENS · BOTH_SIDES_SHARPEN</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Step list (left) — body fonts at the standard section size.
        Three steps (CAPTURE / EVOLVE / WRAPUP) all carry full
        descriptions; no compaction needed. */
  .how-steps {
    margin-top: 0.75rem;
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .how-step {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 12px;
    padding: 9px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    align-items: flex-start;
  }
  .how-step:first-child { border-top: 0; padding-top: 4px; }
  .how-step-num {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: 1.9rem;
    line-height: 1;
    color: var(--step-accent);
    text-shadow: 0 0 24px color-mix(in srgb, var(--step-accent) 45%, transparent);
  }
  .how-step-title {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 4px;
  }
  .how-step-desc {
    margin: 0 0 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.62);
  }
  .how-step-code {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    color: var(--step-accent);
    opacity: 0.85;
  }

  /* ── Loop diagram (right) ─────────────────────────────── */
  .how-loop {
    position: relative;
    padding: 14px 14px 12px;
    background: rgba(8, 8, 14, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .how-loop-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1px solid rgba(255, 255, 255, 0.35);
  }
  .how-loop-corner-tl { top: -1px;    left: -1px;    border-right: 0; border-bottom: 0; }
  .how-loop-corner-tr { top: -1px;    right: -1px;   border-left: 0;  border-bottom: 0; }
  .how-loop-corner-bl { bottom: -1px; left: -1px;    border-right: 0; border-top: 0; }
  .how-loop-corner-br { bottom: -1px; right: -1px;   border-left: 0;  border-top: 0; }

  .how-loop-band {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 4px 8px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.28em;
    color: rgba(255, 255, 255, 0.45);
    text-transform: uppercase;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    margin-bottom: 6px;
  }
  .how-loop-band-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--section-accent);
    box-shadow: 0 0 10px var(--section-accent);
    flex-shrink: 0;
    animation: how-band-pulse 2.4s ease-in-out infinite;
  }
  @keyframes how-band-pulse {
    0%, 100% { opacity: 1;   transform: scale(1);    }
    50%      { opacity: 0.4; transform: scale(0.85); }
  }
  .how-loop-band-meta { margin-left: auto; }

  .how-loop-svg {
    width: 100%;
    /* Cap diagram footprint so a wide laptop column doesn't blow it up.
       The viewBox aspect 450:395 gives a square-ish box; capping width
       at 440 keeps the rendered height around 386px so the loop card
       stays snug inside the section. */
    max-width: 440px;
    aspect-ratio: 450 / 395;
    align-self: center;
    display: block;
    margin: 0 auto;
    /* Marker arrows + node-pulse rings stay inside the viewBox, so we
       can clip overflow to keep the diagram from leaking past the card
       boundary on any container width. */
    overflow: hidden;
  }
  .how-loop {
    display: flex;
    flex-direction: column;
  }

  .how-loop-ring {
    transform-origin: 0 0;
    animation: how-ring-spin 90s linear infinite;
  }
  @keyframes how-ring-spin { to { transform: rotate(360deg); } }

  .how-leg {
    animation: how-leg-pulse 6.6s linear infinite;
  }
  .how-leg-1 { animation-delay: 0s; }
  .how-leg-2 { animation-delay: 2.2s; }
  .how-leg-3 { animation-delay: 4.4s; }
  @keyframes how-leg-pulse {
    0%, 33%, 100% { stroke-opacity: 0.55; }
    10%           { stroke-opacity: 1;    }
  }

  /* No filter on the moving dots — `filter: drop-shadow` on a
     transform/SMIL-animated SVG element triggers per-frame
     re-rasterisation in Safari. */
  .how-flow-dot-1 { color: #ff2d92; }
  .how-flow-dot-2 { color: #bc13fe; }
  .how-flow-dot-3 { color: #00f3ff; }

  .how-node-pulse {
    transform-box: fill-box;
    transform-origin: center;
    animation: how-node-pulse-anim 3.6s ease-in-out infinite;
  }
  @keyframes how-node-pulse-anim {
    0%, 100% { transform: scale(1);    stroke-opacity: 0.4; }
    50%      { transform: scale(1.06); stroke-opacity: 0;   }
  }

  .how-loop-foot {
    margin-top: 6px;
    padding: 8px 4px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.28em;
    color: rgba(255, 255, 255, 0.35);
    text-transform: uppercase;
    text-align: right;
  }

  /* ── Responsive ───────────────────────────────────────── */
  @media (min-width: 1024px) {
    #how { padding: 2.25rem 3rem 1.75rem; }
    #how .cyber-section-head { margin-bottom: 0.75rem; }
  }

  @media (max-width: 1024px) {
    .how-grid { grid-template-columns: 1fr; }
    .how-loop-svg { max-height: 320px; }
  }

  @media (max-width: 720px) {
    .how-step { grid-template-columns: 44px 1fr; gap: 10px; padding: 10px 0; }
    .how-step-num { font-size: 1.9rem; }
    .how-step-desc { font-size: 11px; }
    .how-loop-band-meta,
    .how-loop-foot { display: none; }
    .how-loop { padding: 12px 10px 10px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .how-loop-ring,
    .how-leg,
    .how-node-pulse,
    .how-loop-band-dot { animation: none; }
    .how-flow-dot { display: none; }
  }
</style>
