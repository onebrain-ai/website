---
import { getCliVersion } from '../lib/version';
const cliVersion = await getCliVersion();

const months = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
const now = new Date();
const buildDate = `${String(now.getDate()).padStart(2, '0')}-${months[now.getMonth()]}-${now.getFullYear()}`;
---

<section class="hero" id="top">
  <!-- BACKGROUND LAYERS -->
  <div class="hero-grid" aria-hidden="true"></div>
  <canvas id="hero-particles" aria-hidden="true"></canvas>
  <div class="hero-orb hero-orb-magenta" aria-hidden="true"></div>
  <div class="hero-orb hero-orb-cyan" aria-hidden="true"></div>
  <div class="hero-scanlines" aria-hidden="true"></div>
  <div class="hero-grain" aria-hidden="true"></div>
  <div class="hero-vignette" aria-hidden="true"></div>

  <!-- HUD CORNERS -->
  <div class="hud hud-tl">
    <div>SYS//ONEBRAIN.OS</div>
    <div class="hud-dim">NODE 0x4F2A · v{cliVersion}</div>
  </div>
  <div class="hud hud-tr">
    <div>NETWORK :: <span class="hud-on">ONLINE</span></div>
    <div class="hud-dim">LAT <span id="hud-lat">12</span>ms · TX <span id="hud-tx">873</span></div>
  </div>
  <div class="hud hud-bl">
    <div>UPTIME <span id="hud-uptime">00:00:00</span></div>
    <div class="hud-dim">REGION ASIA-SE-1</div>
  </div>
  <div class="hud hud-br">
    <div class="hud-pulse">SCROLL ↓ TO_BROWSE</div>
  </div>

  <!-- CONTENT -->
  <div class="hero-shell">
    <div class="hero-grid-content">

      <!-- LEFT: HEADLINE + CTAS -->
      <div class="hero-left">
        <div class="hero-pill reveal">
          <span class="hero-pill-dot"></span>
          <span>ONEBRAIN.OS :: CONSOLE_BOOTED</span>
          <span class="hero-pill-meta">// {buildDate}</span>
        </div>

        <h1 class="hero-h1 reveal" style="transition-delay: 100ms;">
          <span class="sr-only">OneBrain — AI thinking partner for Obsidian. </span>
          <span class="hero-word" data-scramble="UNIFIED">UNIFIED</span>
          <span class="hero-word hero-word-stroke stroke-text" data-text="INTELLIGENCE">INTELLIGENCE</span>
        </h1>

        <p class="hero-sub reveal" style="transition-delay: 250ms;">
          <strong class="brand">OneBrain</strong> isn't another second brain — it's a living intelligence layer where you teach the agent and the agent extends you, both evolving inside your Obsidian vault.
        </p>

        <div class="cmd-box reveal" style="transition-delay: 400ms;">
          <span class="cmd-prompt">$</span>
          <code
            class="cmd-text"
            id="cmd-text"
            data-cmd-mac="brew install onebrain-ai/onebrain/onebrain"
            data-cmd-npm="npm install -g @onebrain-ai/cli"
          >brew install onebrain-ai/onebrain/onebrain</code>
          <button class="cmd-copy" id="cmd-copy" type="button" aria-label="Copy install command">
            <svg class="cmd-copy-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="1"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            <svg class="cmd-copy-check" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span class="cmd-copy-label">COPY</span>
          </button>
        </div>

        <div class="cta-row reveal" style="transition-delay: 550ms;">
          <a href="https://github.com/onebrain-ai/onebrain#installation" target="_blank" rel="noopener noreferrer" class="btn-cyber btn-cyber-primary">
            <span>GET_STARTED_</span>
            <span class="btn-cyber-arrow">↗</span>
          </a>
          <a href="#commands" class="btn-cyber btn-cyber-ghost">
            <span>BROWSE_30_COMMANDS</span>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M12 5v14M5 13l7 7 7-7"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- RIGHT: OPERATOR CONSOLE -->
      <div class="hero-right reveal" style="transition-delay: 350ms;">
        <div class="op-console">
          <div class="op-frame-tl"></div>
          <div class="op-frame-tr"></div>
          <div class="op-frame-bl"></div>
          <div class="op-frame-br"></div>

          <div class="op-chrome">
            <div class="op-dots">
              <span class="op-dot op-dot-r"></span>
              <span class="op-dot op-dot-y"></span>
              <span class="op-dot op-dot-g"></span>
            </div>
            <div class="op-title">~/onebrain :: agent_loop_active</div>
            <div class="op-rec"><span class="op-rec-dot"></span>REC</div>
          </div>

          <div class="op-body" id="op-body" aria-hidden="true"></div>

          <div class="op-status">
            <div class="op-stat"><span>MEM</span><strong>warm</strong></div>
            <div class="op-stat"><span>INBOX</span><strong data-rand="inbox">7</strong></div>
            <div class="op-stat"><span>TASKS</span><strong data-rand="tasks">2 due</strong></div>
            <div class="op-stat"><span>VAULT</span><strong data-rand="vault">369 docs</strong></div>
          </div>
        </div>

        <div class="op-caption">
          <span>// LIVE_FEED</span>
          <span class="op-caption-dim">agent telemetry · <span data-rand="sync">sync 4s</span></span>
        </div>
      </div>

    </div>
  </div>

  <script is:inline>
    // HUD `data-rand` randomization is now hoisted to Layout.astro's
    // body inline script (runs after <slot/> parse, before any user-
    // visible paint of the dynamic stats). All `[data-rand="inbox"]` /
    // `[data-rand="tasks"]` / `[data-rand="vault"]` / `[data-rand="sync"]`
    // elements get seeded from a centralized range map — see Layout.

    // Defer the entire hero JS init (particle canvas, scramble loop,
    // op-console scenarios, copy button, HUD telemetry) until the
    // browser is idle. Hero h1 + sub + CTAs render with CSS only —
    // none of this JS is on the LCP critical path. Pushing it past
    // requestIdleCallback frees the main thread for layout + paint
    // and trims the Lighthouse "TBT / forced reflow" budget.
    function __obHeroBoot() {
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1. Particle field — pauses when tab hidden or hero scrolls offscreen.
      // 30fps cap and debounced resize match the neural-canvas + nebula
      // patterns: ambient decoration, no benefit from a 60fps redraw,
      // and mobile address-bar slides shouldn't churn the GPU buffer.
      (function () {
        const canvas = document.getElementById('hero-particles');
        if (!canvas) return;
        const ctx = canvas.getContext('2d', { alpha: true });
        let w, h, dpr, particles = [];
        let running = true;
        let visible = true;
        let rafId = 0;
        let lastFrame = 0;
        function init() {
          if (reduced) return;
          if (rafId) { cancelAnimationFrame(rafId); rafId = 0; }
          dpr = Math.min(window.devicePixelRatio || 1, 1.5);
          w = canvas.parentElement.clientWidth;
          h = canvas.parentElement.clientHeight;
          if (!w || !h) return;
          canvas.width = w * dpr;
          canvas.height = h * dpr;
          ctx.setTransform(1, 0, 0, 1, 0, 0);
          ctx.scale(dpr, dpr);
          canvas.style.width = w + 'px';
          canvas.style.height = h + 'px';
          const count = Math.min(110, Math.floor((w * h) / 13000));
          particles = [];
          for (let i = 0; i < count; i++) {
            const roll = Math.random();
            particles.push({
              x: Math.random() * w,
              y: Math.random() * h,
              vx: (Math.random() - 0.5) * 0.18,
              vy: (Math.random() - 0.5) * 0.18,
              r: Math.random() * 1.3 + 0.3,
              c: roll > 0.88 ? '#ff2d92' : roll > 0.55 ? '#00f3ff' : '#ffffff',
              a: Math.random() * 0.45 + 0.12,
            });
          }
        }
        function draw(now) {
          rafId = 0;
          if (!running || !visible || reduced) return;
          if (now && now - lastFrame < 32) {
            rafId = requestAnimationFrame(draw);
            return;
          }
          lastFrame = now || 0;
          ctx.clearRect(0, 0, w, h);
          const len = particles.length;
          for (let i = 0; i < len; i++) {
            const p = particles[i];
            p.x += p.vx; p.y += p.vy;
            if (p.x < 0 || p.x > w) p.vx *= -1;
            if (p.y < 0 || p.y > h) p.vy *= -1;
            ctx.globalAlpha = p.a;
            ctx.fillStyle = p.c;
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.globalAlpha = 1;
          rafId = requestAnimationFrame(draw);
        }
        function start() { if (!rafId && running && visible && !reduced) rafId = requestAnimationFrame(draw); }
        function stopRaf() { if (rafId) { cancelAnimationFrame(rafId); rafId = 0; } }
        document.addEventListener('visibilitychange', () => {
          visible = !document.hidden;
          if (visible) start(); else stopRaf();
        });
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver((entries) => {
            running = entries[0].isIntersecting;
            if (running) start(); else stopRaf();
          }, { rootMargin: '0px' });
          io.observe(canvas);
        }
        let resizeTimer = 0;
        window.addEventListener('resize', () => {
          if (resizeTimer) clearTimeout(resizeTimer);
          resizeTimer = setTimeout(init, 200);
        }, { passive: true });
        init();
        start();
      })();

      // 2. Headline motion — UNIFIED periodic re-scramble + INTELLIGENCE neon glitch.
      // Two effects on different cadences so the eye never sees a fixed beat.
      // Both gated to hero visibility — when scrolled away from the hero we stop
      // firing entirely so other sections aren't dropping hover events under
      // a hidden RAF loop.
      (function () {
        const CHARS = '!<>-_/[]{}=+*^?#01ABCDEFXZ';
        function scramble(el, target, duration) {
          let frame = 0;
          const total = Math.round(duration / 16);
          const reveal = target.split('').map((_, i) => Math.floor(total * 0.35) + i * 2);
          function step() {
            let out = '';
            for (let i = 0; i < target.length; i++) {
              if (target[i] === ' ') { out += ' '; continue; }
              if (frame >= reveal[i]) out += target[i];
              else out += CHARS[Math.floor(Math.random() * CHARS.length)];
            }
            el.textContent = out;
            frame++;
            if (frame < total + target.length) requestAnimationFrame(step);
            else el.textContent = target;
          }
          step();
        }
        if (reduced) return;

        // Hero visibility gate — when hero is offscreen, neither effect fires.
        let heroVisible = true;
        const heroEl = document.querySelector('.hero');
        if (heroEl && 'IntersectionObserver' in window) {
          const io = new IntersectionObserver((entries) => {
            heroVisible = entries[0].isIntersecting;
          }, { rootMargin: '0px' });
          io.observe(heroEl);
        }

        // UNIFIED — periodic scramble loop only (every 12-20s). The
        // initial scramble pass is removed: the hero h1 is the LCP
        // element, and rolling characters across the first 1.1s of
        // page life made Chrome wait for the text to stabilise before
        // it would mark LCP. The loop still fires later for the
        // cinematic flicker.
        document.querySelectorAll('[data-scramble]').forEach((el) => {
          const t = el.dataset.scramble;
          function loop() {
            // Skip when an AT user has the scramble element focused —
            // rewriting textContent under a focused h1 makes screen
            // readers announce the rolling cipher characters. Also
            // skip when the document itself isn't focused (tab in
            // background) so the loop doesn't queue paint work.
            if (
              heroVisible &&
              document.hasFocus() &&
              document.activeElement !== el
            ) {
              scramble(el, t, 600);
            }
            setTimeout(loop, 12000 + Math.random() * 8000);
          }
          setTimeout(loop, 12000 + Math.random() * 6000);
        });

        // INTELLIGENCE — neon glitch every 5-9s, ~300ms each fire.
        const stroke = document.querySelector('.hero-word-stroke');
        if (stroke) {
          function fire() {
            if (heroVisible) {
              stroke.classList.add('glitch');
              setTimeout(() => stroke.classList.remove('glitch'), 320);
            }
            setTimeout(fire, 5000 + Math.random() * 4000);
          }
          setTimeout(fire, 2500);
        }
      })();

      // 3. Operator console — demo OneBrain skills in action.
      // Each scenario shows a real user → AI interaction so visitors instantly grok the product.
      (function () {
        const body = document.getElementById('op-body');
        if (!body) return;

        const scenarios = [
          {
            prompt: '$', cmd: '/braindump',
            arg: '"cyberpunk redesign — magenta accent, big visual..."',
            results: [
              'captured 6 thoughts · extracted 3 tasks',
              'linked → [[Website Redesign]] [[Design Refs]]',
            ],
          },
          {
            prompt: '$', cmd: '/bookmark',
            arg: 'https://anthropic.com/news/claude-4-7',
            results: [
              'named "Claude 4.7 release notes"',
              'category: ai-tools · saved → Bookmarks.md',
            ],
          },
          {
            prompt: '$', cmd: '/capture',
            arg: '"MCP servers ship docs via skills"',
            results: [
              '→ 03-knowledge/ai/MCP Skills Pattern.md',
              'tagged #mcp #skills · linked [[Plugin Dev]]',
            ],
          },
          {
            prompt: '$', cmd: '/summarize',
            arg: 'https://blog.langchain.dev/agents-2026',
            results: [
              '1,840 words · 4 sections distilled',
              '→ 04-resources/articles/agents-2026.md',
            ],
          },
          {
            prompt: 'cron »', cmd: '/daily',
            arg: 'auto-fire 09:00',
            results: [
              '3 tasks due today · 1 overdue',
              'briefing → telegram channel',
            ],
          },
          {
            prompt: '$', cmd: '/connect',
            arg: '"Operator Console"',
            results: [
              '7 candidates · 4 strong matches',
              'added 3 wikilinks → [[OneBrain UI]]',
            ],
          },
          {
            prompt: '$', cmd: '/distill',
            arg: '"memory layers"',
            results: [
              'aggregated 12 notes from 8 sessions',
              '→ 03-knowledge/ai/Memory Layers.md',
            ],
          },
          {
            prompt: '$', cmd: '/doctor',
            arg: '',
            results: [
              'scanned 369 docs · 0 broken links',
              '2 orphans · 4 stale memory files',
            ],
          },
          {
            prompt: '$', cmd: '/learn',
            arg: '"prefer terse responses, no trailing summary"',
            results: [
              'saved → memory/feedback_terse.md',
              'MEMORY-INDEX updated · 36 → 37 entries',
            ],
          },
          {
            prompt: 'hook »', cmd: 'end-of-session',
            arg: 'detected',
            results: [
              'spawning /wrapup background agent',
              'session_2843 → 07-logs/2026/05/',
            ],
          },
          {
            prompt: '$', cmd: '/research',
            arg: '"agent memory layering 2026"',
            results: [
              '6 sources · 14 references collated',
              '→ 04-resources/research/memory-layers.md',
            ],
          },
          {
            prompt: '$', cmd: '/reading-notes',
            arg: '"Designing Data-Intensive Applications"',
            results: [
              '4 chapters · 18 progressive notes',
              '→ 04-resources/books/ddia.md',
            ],
          },
        ];

        function span(cls, value) {
          const el = document.createElement('span');
          el.className = cls;
          el.textContent = value;
          return el;
        }
        function renderResult(parent, str) {
          // Split on → and [[...]] so we can color them — no innerHTML.
          const parts = str.split(/(→|\[\[[^\]]+\]\])/g);
          for (const p of parts) {
            if (!p) continue;
            if (p === '→') parent.appendChild(span('op-arrow', '→'));
            else if (p.startsWith('[[')) parent.appendChild(span('op-link', p));
            else parent.appendChild(document.createTextNode(p));
          }
        }

        // Live time cursor — scenarios appear with monotonically increasing timestamps.
        let timeCursor = Date.now() - 90000;
        function nextTime() {
          timeCursor += 1500 + Math.random() * 6000;
          const d = new Date(timeCursor);
          return String(d.getHours()).padStart(2, '0') + ':' +
                 String(d.getMinutes()).padStart(2, '0') + ':' +
                 String(d.getSeconds()).padStart(2, '0');
        }

        // Shuffled order so each visit shows a different sequence.
        function shuffle(arr) {
          const a = arr.slice();
          for (let i = a.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [a[i], a[j]] = [a[j], a[i]];
          }
          return a;
        }
        let order = shuffle(scenarios.map((_, i) => i));
        let oi = 0;

        function pushScenario() {
          if (oi >= order.length) { order = shuffle(order); oi = 0; }
          const s = scenarios[order[oi++]];

          const cmdLine = document.createElement('div');
          cmdLine.className = 'op-line';
          cmdLine.appendChild(span('op-time', '[' + nextTime() + ']'));
          cmdLine.appendChild(document.createTextNode(' '));
          cmdLine.appendChild(span(s.prompt === '$' ? 'op-prompt' : 'op-trigger', s.prompt));
          cmdLine.appendChild(document.createTextNode(' '));
          cmdLine.appendChild(span('op-cmd', s.cmd));
          if (s.arg) {
            cmdLine.appendChild(document.createTextNode(' '));
            cmdLine.appendChild(span('op-arg', s.arg));
          }
          body.appendChild(cmdLine);

          for (let i = 0; i < s.results.length; i++) {
            const rLine = document.createElement('div');
            rLine.className = 'op-line op-line-result';
            if (i === s.results.length - 1) rLine.classList.add('op-line-end');
            rLine.appendChild(span('op-ok', '✓'));
            rLine.appendChild(document.createTextNode(' '));
            renderResult(rLine, s.results[i]);
            body.appendChild(rLine);
          }

          while (body.children.length > 24) body.removeChild(body.firstChild);
          body.scrollTop = body.scrollHeight;
        }

        for (let i = 0; i < 4; i++) pushScenario();
        // Pause the scenario rotation the moment hero leaves the viewport.
        // Observe .hero (not just the op-console body) with rootMargin:0 so
        // we stop firing right as the next section snaps in — no burning
        // setInterval + DOM mutations while user is reading other sections.
        let opTimer = null;
        function startOp() { if (!opTimer && !reduced) opTimer = setInterval(pushScenario, 2800); }
        function stopOp()  { if (opTimer) { clearInterval(opTimer); opTimer = null; } }
        const opHeroEl = document.querySelector('.hero');
        if (opHeroEl && 'IntersectionObserver' in window) {
          const io = new IntersectionObserver((entries) => {
            entries[0].isIntersecting ? startOp() : stopOp();
          }, { rootMargin: '0px' });
          io.observe(opHeroEl);
        } else {
          startOp();
        }
        document.addEventListener('visibilitychange', () => {
          document.hidden ? stopOp() : startOp();
        });
      })();

      // 4a. Platform-aware install command. Default render is macOS (brew —
      // dominant developer platform). Detect non-macOS UAs once at boot and
      // swap to the npm wrapper (`@onebrain-ai/cli@3.0.0+`). The data-cmd-mac
      // / data-cmd-npm attributes are the source of truth so we don't have
      // to keep the strings in sync between markup + script.
      (function () {
        const text = document.getElementById('cmd-text');
        if (!text) return;
        const ua = navigator.userAgent || '';
        const platform = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || '';
        const isMac = /Mac|iPhone|iPad|iPod/i.test(platform) || /Macintosh|Mac OS X/i.test(ua);
        if (!isMac) {
          const npmCmd = text.getAttribute('data-cmd-npm');
          if (npmCmd) text.textContent = npmCmd;
        }
      })();

      // 4. Clipboard copy. Modern API first; falls back to a hidden textarea
      // (covers HTTP previews, Safari user-gesture quirks, and old Edge).
      (function () {
        const btn = document.getElementById('cmd-copy');
        const text = document.getElementById('cmd-text');
        if (!btn || !text) return;
        const label = btn.querySelector('.cmd-copy-label');

        function legacyCopy(value) {
          const ta = document.createElement('textarea');
          ta.value = value;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          let ok = false;
          try { ok = document.execCommand('copy'); } catch (_e) { ok = false; }
          document.body.removeChild(ta);
          return ok;
        }

        btn.addEventListener('click', async () => {
          const value = text.textContent.trim();
          let ok = false;
          try {
            if (navigator.clipboard && window.isSecureContext) {
              await navigator.clipboard.writeText(value);
              ok = true;
            } else {
              ok = legacyCopy(value);
            }
          } catch (e) {
            console.warn('[hero] clipboard primary path failed, falling back:', e);
            ok = legacyCopy(value);
          }
          btn.classList.toggle('copied', ok);
          label.textContent = ok ? 'COPIED' : 'ERR';
          btn.setAttribute('aria-label', ok ? 'Copied!' : 'Copy failed');
          setTimeout(() => {
            btn.classList.remove('copied');
            label.textContent = 'COPY';
            btn.setAttribute('aria-label', 'Copy install command');
          }, 1800);
        });
      })();

      // 5. Live HUD telemetry — also paused when hero is offscreen / tab hidden.
      (function () {
        const uptime = document.getElementById('hud-uptime');
        const lat = document.getElementById('hud-lat');
        const tx = document.getElementById('hud-tx');
        if (!uptime && !lat && !tx) return;
        // Seed UPTIME from a random elapsed offset (0–90 minutes) so
        // returning visitors don't see `00:00:00` every load — the
        // ticker then continues forward from there. Without this seed,
        // the HUD reads as freshly booted on every reload, which
        // contradicts the "long-running agent" framing.
        const start = Date.now() - Math.floor(Math.random() * 5400) * 1000;
        function tick() {
          if (uptime) {
            const s = Math.floor((Date.now() - start) / 1000);
            const hh = String(Math.floor(s / 3600)).padStart(2, '0');
            const mm = String(Math.floor((s % 3600) / 60)).padStart(2, '0');
            const ss = String(s % 60).padStart(2, '0');
            uptime.textContent = hh + ':' + mm + ':' + ss;
          }
        }
        function jitter() {
          if (lat) lat.textContent = 9 + Math.floor(Math.random() * 9);
          if (tx) tx.textContent = 820 + Math.floor(Math.random() * 140);
        }
        let tickTimer = null, jitterTimer = null;
        function startHud() {
          if (!tickTimer)   { tick();   tickTimer   = setInterval(tick, 1000); }
          if (!jitterTimer) { jitter(); jitterTimer = setInterval(jitter, 1700); }
        }
        function stopHud() {
          if (tickTimer)   { clearInterval(tickTimer);   tickTimer = null; }
          if (jitterTimer) { clearInterval(jitterTimer); jitterTimer = null; }
        }
        const heroEl = document.querySelector('.hero');
        if (heroEl && 'IntersectionObserver' in window) {
          const io = new IntersectionObserver((entries) => {
            entries[0].isIntersecting ? startHud() : stopHud();
          }, { rootMargin: '0px' });
          io.observe(heroEl);
        } else {
          startHud();
        }
        document.addEventListener('visibilitychange', () => {
          document.hidden ? stopHud() : startHud();
        });
      })();
    }
    if ('requestIdleCallback' in window) {
      requestIdleCallback(__obHeroBoot, { timeout: 1500 });
    } else {
      setTimeout(__obHeroBoot, 200);
    }
  </script>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background: radial-gradient(ellipse at 50% 0%, #0a0a14 0%, #050507 60%, #020204 100%);
    isolation: isolate;
    --section-accent: #ff2d92;
  }
