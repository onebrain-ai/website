---
import Brain from './Brain.astro';

const navLinks = [
  { href: '#features', label: 'Features' },
  { href: '#synergy',  label: 'Synergy'  },
  { href: '#how',      label: 'How'      },
  { href: '#commands', label: 'Commands' },
  { href: '#stack',    label: 'Stack'    },
  { href: '#cloud',    label: 'Cloud'    },
];
---

<header class="sticky top-0 z-50 nav-glass">
  <div class="mx-auto max-w-7xl px-6 flex items-center justify-between h-16">
    <a href="/" class="flex items-center gap-3 group relative">
      <div class="w-9 h-9 relative flex items-center justify-center">
        <div class="absolute inset-0 bg-[var(--color-accent)]/15 blur-md opacity-0 group-hover:opacity-100 transition-opacity rounded-full"></div>
        <Brain size={32} class="relative" ariaLabel="OneBrain" />
      </div>
      <div class="flex flex-col leading-none gap-1.5">
        <span class="nav-wordmark">OneBrain</span>
        <span class="font-mono text-[9px] text-[var(--color-accent-2)] tracking-[0.2em] uppercase opacity-70">Your AI Thinking Partner</span>
      </div>
    </a>

    <div class="hidden lg:flex items-center gap-8 font-mono text-[10px] tracking-[0.25em] uppercase text-[var(--color-muted)]">
      {navLinks.map(l => (
        <a href={l.href} class="hover:text-white transition-colors relative group">
          <span class="text-[var(--color-accent-2)] opacity-0 group-hover:opacity-100 mr-1 transition-opacity">[</span>{l.label}<span class="text-[var(--color-accent-2)] opacity-0 group-hover:opacity-100 ml-1 transition-opacity">]</span>
        </a>
      ))}
    </div>

    <div class="flex items-center gap-4 lg:gap-6">
      <a href="https://github.com/onebrain-ai/onebrain" class="hidden sm:flex font-mono text-[9px] tracking-widest uppercase text-white/40 hover:text-white transition-colors items-center gap-2">
        <span class="w-1 h-1 bg-[var(--color-accent-2)] rounded-full animate-ping"></span>
        GitHub::Repo
      </a>
      <a href="https://github.com/onebrain-ai/onebrain#installation" class="btn-tech h-10 w-32 group">
        <div class="btn-tech-inner">
          <span class="font-mono text-[10px] font-bold tracking-[0.15em] uppercase text-white group-hover:text-black">Initialize_</span>
        </div>
      </a>

      <!-- Mobile hamburger trigger (hidden ≥lg via CSS) -->
      <button
        type="button"
        id="nav-toggle"
        class="nav-toggle"
        aria-label="Open navigation"
        aria-controls="nav-mobile"
        aria-expanded="false"
      >
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile drawer overlay (toggled via [data-open] attr) -->
  <div id="nav-mobile" class="nav-mobile" role="dialog" aria-modal="true" aria-label="Site navigation" aria-hidden="true">
    <div class="nav-mobile-grid" aria-hidden="true"></div>
    <div class="nav-mobile-shell">
      <div class="nav-mobile-pill">
        <span class="nav-mobile-pill-dot"></span>
        <span>ONEBRAIN.OS :: NAVIGATION</span>
      </div>
      <ul class="nav-mobile-list">
        {navLinks.map((l, i) => (
          <li style={`--ob-i: ${i}`}>
            <a href={l.href} data-nav-link>
              <span class="nav-mobile-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="nav-mobile-label">{l.label}</span>
              <span class="nav-mobile-arrow">→</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="nav-mobile-footer">
        <a href="https://github.com/onebrain-ai/onebrain" data-nav-link class="nav-mobile-ext">
          <span>GITHUB::REPO</span><span>↗</span>
        </a>
        <a href="https://github.com/onebrain-ai/onebrain#installation" data-nav-link class="nav-mobile-cta">
          INITIALIZE_ →
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  // Mobile drawer controller. HMR-safe via the boot guard, accessible via
  // focus trap + Escape, and resilient to hash-only navigation.
  (function () {
    if (window.__obNavBooted) return;
    window.__obNavBooted = true;

    const toggle = document.getElementById('nav-toggle');
    const drawer = document.getElementById('nav-mobile');
    const main = document.querySelector('main');
    if (!toggle || !drawer) return;

    const focusables = () =>
      Array.from(drawer.querySelectorAll('[data-nav-link]'));

    function setOpen(open) {
      drawer.dataset.open = open ? 'true' : 'false';
      drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.classList.toggle('is-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
      // Hide background page from AT and disable its tab order while open.
      if (main) {
        if (open) main.setAttribute('inert', '');
        else main.removeAttribute('inert');
      }
      if (open) {
        // Move focus into the drawer so keyboard users land where they expect.
        const first = focusables()[0];
        if (first) first.focus();
      } else {
        toggle.focus();
      }
    }

    toggle.addEventListener('click', () => setOpen(drawer.dataset.open !== 'true'));
    drawer.querySelectorAll('[data-nav-link]').forEach((a) =>
      a.addEventListener('click', () => setOpen(false))
    );
    // Hash navigation (browser back, manual edit, anchor restore) closes the drawer
    // so body overflow can never get stuck.
    window.addEventListener('hashchange', () => {
      if (drawer.dataset.open === 'true') setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (drawer.dataset.open !== 'true') return;
      if (e.key === 'Escape') {
        setOpen(false);
        return;
      }
      // Trap Tab within the drawer.
      if (e.key === 'Tab') {
        const list = focusables();
        if (list.length === 0) return;
        const first = list[0];
        const last = list[list.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  })();
</script>

<style>
  .nav-wordmark {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: 1.1rem;
    color: #fff;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  /* ── Hamburger trigger (mobile only) ── */
  .nav-toggle {
    width: 36px;
    height: 36px;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.12);
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  @media (min-width: 1024px) {
    .nav-toggle { display: none; }
  }
  .nav-toggle:hover { border-color: #00f3ff; background: rgba(0, 243, 255, 0.05); }
  .nav-toggle-bar {
    display: block;
    width: 18px;
    height: 1.5px;
    background: #fff;
    transition: transform 0.25s ease, opacity 0.2s ease;
  }
  .nav-toggle.is-open .nav-toggle-bar:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .nav-toggle.is-open .nav-toggle-bar:nth-child(2) { opacity: 0; }
  .nav-toggle.is-open .nav-toggle-bar:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  /* ── Mobile drawer ── */
  .nav-mobile {
    position: fixed;
    top: 64px;
    left: 0;
    right: 0;
    bottom: 0;
    height: calc(100dvh - 64px);
    background: radial-gradient(ellipse at 50% 0%, #0a0a14 0%, #050507 65%, #020204 100%);
    z-index: 40;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-8px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    overflow-y: auto;
  }
  .nav-mobile[data-open='true'] {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
  .nav-mobile-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse 75% 60% at 50% 50%, black 30%, transparent 100%);
            mask-image: radial-gradient(ellipse 75% 60% at 50% 50%, black 30%, transparent 100%);
    pointer-events: none;
  }
  .nav-mobile-shell {
    position: relative;
    max-width: 560px;
    margin: 0 auto;
    padding: 2.5rem 1.75rem 3rem;
  }
  .nav-mobile-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    background: rgba(255, 45, 146, 0.05);
    border: 1px solid rgba(255, 45, 146, 0.3);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: #ff2d92;
    margin-bottom: 28px;
  }
  .nav-mobile-pill-dot {
    width: 6px;
    height: 6px;
    background: #ff2d92;
    border-radius: 50%;
    box-shadow: 0 0 10px #ff2d92;
  }

  .nav-mobile-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .nav-mobile-list li {
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    transform: translateX(-8px);
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
    transition-delay: calc(var(--ob-i, 0) * 35ms);
  }
  .nav-mobile[data-open='true'] .nav-mobile-list li {
    transform: translateX(0);
    opacity: 1;
  }
  .nav-mobile-list a {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 4px;
    text-decoration: none;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: 1.4rem;
    text-transform: uppercase;
    color: #fff;
    letter-spacing: -0.01em;
    transition: color 0.2s ease, padding-left 0.2s ease;
  }
  .nav-mobile-list a:hover { color: #00f3ff; padding-left: 8px; }
  .nav-mobile-num {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: #ff2d92;
    width: 24px;
  }
  .nav-mobile-label { flex: 1; }
  .nav-mobile-arrow {
    font-style: normal;
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.25);
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .nav-mobile-list a:hover .nav-mobile-arrow {
    color: #00f3ff;
    transform: translateX(4px);
  }

  .nav-mobile-footer {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .nav-mobile-ext {
    display: flex;
    justify-content: space-between;
    padding: 12px 14px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.25em;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
  }
  .nav-mobile-ext:hover { border-color: #00f3ff; color: #00f3ff; }
  .nav-mobile-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 24px;
    background: #ff2d92;
    color: #050507;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-decoration: none;
    clip-path: polygon(6% 0, 100% 0, 100% 75%, 94% 100%, 0 100%, 0 25%);
    box-shadow: 0 0 40px rgba(255, 45, 146, 0.35);
    transition: background 0.2s ease, color 0.2s ease;
  }
  .nav-mobile-cta:hover { background: #fff; color: #ff2d92; }

  @media (min-width: 1024px) {
    .nav-mobile { display: none; }
  }
</style>
