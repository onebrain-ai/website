---
import Brain from './Brain.astro';

// Hash-only links break when the user is on a non-root route like
// /privacy — the browser tries to scroll to an anchor that doesn't
// exist on the current page. Prefix with `/` from any non-root page
// so the link navigates home first, then scrolls. From `/` itself
// the browser treats `/#foo` as same-document fragment (no reload).
const isHome = Astro.url.pathname === '/';
const linkBase = isHome ? '' : '/';

const navLinks = [
  { href: `${linkBase}#features`, label: 'Features' },
  { href: `${linkBase}#synergy`,  label: 'Synergy'  },
  { href: `${linkBase}#stack`,    label: 'Stack'    },
  { href: `${linkBase}#workflow`, label: 'Workflow' },
  { href: `${linkBase}#session`,  label: 'Session'  },
  { href: `${linkBase}#commands`, label: 'Commands' },
  { href: `${linkBase}#open`,     label: 'Open Source' },
];
---

<header class="sticky top-0 z-50 nav-glass">
  <div class="mx-auto max-w-7xl px-6 flex items-center justify-between h-16">
    <a href="/" class="flex items-center gap-3.5 group relative">
      <div class="relative w-10 h-10 flex items-center justify-center">
        <Brain size={40} class="relative" ariaLabel="OneBrain" />
      </div>
      <div class="nav-logo-text">
        <span class="nav-wordmark">OneBrain</span>
        <span class="nav-tagline">Your AI <span class="nav-tagline-pair">Thinking Partner</span></span>
      </div>
    </a>

    <!-- 9 nav links — gap-3.5 (lg) / gap-5 (xl) so the row fits without
         pushing into the right group at 1024–1280px viewports. The hot-
         entry CTA lives in the Hero, not here, so the header bar can
         stay light. -->
    <nav class="hidden lg:flex items-center gap-3.5 xl:gap-5 font-mono text-[10px] tracking-[0.18em] xl:tracking-[0.22em] uppercase text-[var(--color-muted)]">
      {navLinks.map(l => (
        <a href={l.href} class="hover:text-white transition-colors relative group whitespace-nowrap">
          <span class="text-[var(--color-accent-2)] opacity-0 group-hover:opacity-100 mr-1 transition-opacity">[</span>{l.label}<span class="text-[var(--color-accent-2)] opacity-0 group-hover:opacity-100 ml-1 transition-opacity">]</span>
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-4 lg:gap-5">
      <a href="https://github.com/onebrain-ai/onebrain" target="_blank" rel="noopener noreferrer" aria-label="OneBrain on GitHub" class="hidden sm:flex font-mono text-[9px] tracking-widest uppercase text-white/40 hover:text-white transition-colors items-center gap-2">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/>
        </svg>
        <span>Repo</span>
        <span class="w-1 h-1 bg-[var(--color-accent-2)] rounded-full animate-ping"></span>
      </a>

      <!-- Mobile hamburger trigger (hidden ≥lg via CSS) -->
      <button
        type="button"
        id="nav-toggle"
        class="nav-toggle"
        aria-label="Open navigation"
        aria-controls="nav-mobile"
        aria-expanded="false"
        aria-haspopup="dialog"
      >
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile drawer overlay (toggled via [data-open] attr) -->
  <div id="nav-mobile" class="nav-mobile" role="dialog" aria-modal="true" aria-label="Site navigation" aria-hidden="true">
    <div class="nav-mobile-grid" aria-hidden="true"></div>
    <div class="nav-mobile-shell">
      <div class="nav-mobile-pill">
        <span class="nav-mobile-pill-dot"></span>
        <span>ONEBRAIN.OS :: NAVIGATION</span>
      </div>
      <ul class="nav-mobile-list">
        {navLinks.map((l, i) => (
          <li style={`--ob-i: ${i}`}>
            <a href={l.href} data-nav-link>
              <span class="nav-mobile-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="nav-mobile-label">{l.label}</span>
              <span class="nav-mobile-arrow">→</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="nav-mobile-footer">
        <a href="https://github.com/onebrain-ai/onebrain" target="_blank" rel="noopener noreferrer" data-nav-link class="nav-mobile-ext">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/>
          </svg>
          <span>Repo</span><span>↗</span>
        </a>
        <a href="https://github.com/onebrain-ai/onebrain#installation" target="_blank" rel="noopener noreferrer" data-nav-link class="nav-mobile-cta">
          INITIALIZE_ →
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  // Mobile drawer controller. HMR-safe via the boot guard, accessible via
  // focus trap + Escape, and resilient to hash-only navigation.
  (function () {
    if (window.__obNavBooted) return;
    window.__obNavBooted = true;

    const toggle = document.getElementById('nav-toggle');
    const drawer = document.getElementById('nav-mobile');
    if (!toggle || !drawer) return;

    // Background-inert scope: walk from <body> down each ancestor that
    // contains the drawer OR the toggle, inerting every sibling that
    // contains neither. The drawer and the toggle are siblings inside
    // <header>; both subtrees must stay interactive (drawer for its
    // own content, toggle so the user can close the drawer with the
    // same hamburger they opened it from). Sibling subtrees inside
    // <header> — brain-home link, desktop nav, Repo badge — get
    // inerted, as do every <body> child outside <header> (page spine,
    // neural canvas, warp overlays, <main>, <footer>). A single-level
    // body.children walk would skip <header> entirely (it contains
    // both kept subtrees) and leave brain-home + Repo tabbable.
    function siblingsToInert() {
      const out = [];
      function descend(parent) {
        for (const el of parent.children) {
          if (el === drawer || el === toggle) continue;
          if (el.contains(drawer) || el.contains(toggle)) {
            descend(el);
          } else {
            out.push(el);
          }
        }
      }
      descend(document.body);
      return out;
    }

    const focusables = () =>
      Array.from(drawer.querySelectorAll('[data-nav-link]'));

    let _inerted = [];
    function setOpen(open) {
      drawer.dataset.open = open ? 'true' : 'false';
      drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.classList.toggle('is-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
      // Hide background page from AT and disable its tab order while open.
      if (open) {
        _inerted = siblingsToInert();
        _inerted.forEach((el) => el.setAttribute('inert', ''));
      } else {
        _inerted.forEach((el) => el.removeAttribute('inert'));
        _inerted = [];
      }
      if (open) {
        // Defer focus past the next paint so the browser has flipped
        // the drawer to pointer-events:auto + opacity:1 before the
        // focus ring lands. Without this, Safari can paint the focus
        // ring on the link one frame before the drawer's transform
        // finishes, briefly showing the ring behind the still-sliding
        // panel. Double-rAF gives the dataset change time to take
        // effect; full transitionend isn't needed — once the drawer is
        // visible, focus is correct even mid-transition.
        requestAnimationFrame(() => requestAnimationFrame(() => {
          const first = focusables()[0];
          if (first) first.focus();
        }));
      } else {
        toggle.focus();
      }
    }

    toggle.addEventListener('click', () => setOpen(drawer.dataset.open !== 'true'));
    drawer.querySelectorAll('[data-nav-link]').forEach((a) =>
      a.addEventListener('click', () => setOpen(false))
    );
    // Hash navigation (browser back, manual edit, anchor restore) closes the drawer
    // so body overflow can never get stuck.
    window.addEventListener('hashchange', () => {
      if (drawer.dataset.open === 'true') setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (drawer.dataset.open !== 'true') return;
      if (e.key === 'Escape') {
        setOpen(false);
        return;
      }
      // Trap Tab within the drawer.
      if (e.key === 'Tab') {
        const list = focusables();
        if (list.length === 0) return;
        const first = list[0];
        const last = list[list.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  })();
</script>

<style>
  .nav-logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .nav-wordmark {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: 1.4rem;
    color: #fff;
    letter-spacing: -0.01em;
    /* Wordmark lockup renders all-caps per brand CI (ONEBRAIN). Keep
       the DOM text "OneBrain" so SR + SEO read the natural name. */
    text-transform: uppercase;
  }
  .nav-tagline {
    margin-top: 4px;
    font-family: var(--font-mono);
    /* Tagline width-fitted to the ONEBRAIN wordmark per onebrain
       DESIGN.md §8 ("JetBrains Mono bold, wide-tracked, width-fitted
       to the wordmark"). The 24-char tagline is far longer than the
       8-char wordmark, so size + tracking are tuned so its glyph run
       spans the same width as the wordmark above it. JetBrains Mono is
       monospaced, so weight 700 does not change the width. */
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-accent-2);
    text-transform: uppercase;
    opacity: 0.7;
    /* Single line always — nowrap avoids a font-swap reflow breaking
       "Thinking Partner" onto a second line under "Your AI". */
    white-space: nowrap;
  }
  .nav-tagline-pair {
    white-space: nowrap;
  }

  /* Active-section highlight rules live in global.css so they
     compete with Tailwind utilities (opacity-0 on the [ ] bracket
     spans) without Astro's per-component style scoping interfering. */

  /* ── Hamburger trigger (mobile only) ── */
  .nav-toggle {
    width: 44px;
    height: 44px;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.12);
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  @media (min-width: 1024px) {
    .nav-toggle { display: none; }
  }
  .nav-toggle:hover { border-color: #00f3ff; background: rgba(0, 243, 255, 0.05); }
  .nav-toggle-bar {
    display: block;
    width: 18px;
    height: 1.5px;
    background: #fff;
    transition: transform 0.25s ease, opacity 0.2s ease;
  }
  .nav-toggle.is-open .nav-toggle-bar:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .nav-toggle.is-open .nav-toggle-bar:nth-child(2) { opacity: 0; }
  .nav-toggle.is-open .nav-toggle-bar:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  /* ── Mobile drawer ── */
  .nav-mobile {
    position: fixed;
    top: 64px;
    left: 0;
    right: 0;
    bottom: 0;
    height: calc(100dvh - 64px);
    background: radial-gradient(ellipse at 50% 0%, #0a0a14 0%, #050507 65%, #020204 100%);
    z-index: 40;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-8px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    overflow-y: auto;
  }
  .nav-mobile[data-open='true'] {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
  .nav-mobile-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse 75% 60% at 50% 50%, black 30%, transparent 100%);
            mask-image: radial-gradient(ellipse 75% 60% at 50% 50%, black 30%, transparent 100%);
    pointer-events: none;
  }
  .nav-mobile-shell {
    position: relative;
    max-width: 560px;
    margin: 0 auto;
    padding: 2.5rem 1.75rem 3rem;
  }
  .nav-mobile-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    background: rgba(255, 45, 146, 0.05);
    border: 1px solid rgba(255, 45, 146, 0.3);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: #ff2d92;
    margin-bottom: 28px;
  }
  .nav-mobile-pill-dot {
    width: 6px;
    height: 6px;
    background: #ff2d92;
    border-radius: 50%;
    box-shadow: 0 0 10px #ff2d92;
  }

  .nav-mobile-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .nav-mobile-list li {
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    transform: translateX(-8px);
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
    transition-delay: calc(var(--ob-i, 0) * 35ms);
  }
  .nav-mobile[data-open='true'] .nav-mobile-list li {
    transform: translateX(0);
    opacity: 1;
  }
  .nav-mobile-list a {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 4px;
    text-decoration: none;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: 1.4rem;
    text-transform: uppercase;
    color: #fff;
    letter-spacing: -0.01em;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .nav-mobile-list a:hover { color: #00f3ff; transform: translateX(8px); }
  .nav-mobile-num {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: #ff2d92;
    width: 24px;
  }
  .nav-mobile-label { flex: 1; }
  .nav-mobile-arrow {
    font-style: normal;
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.25);
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .nav-mobile-list a:hover .nav-mobile-arrow {
    color: #00f3ff;
    transform: translateX(4px);
  }

  .nav-mobile-footer {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .nav-mobile-ext {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.25em;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
  }
  /* Push the trailing ↗ arrow to the right edge so the row reads
     icon → label … arrow. */
  .nav-mobile-ext > span:last-child { margin-left: auto; }
  .nav-mobile-ext:hover { border-color: #00f3ff; color: #00f3ff; }
  .nav-mobile-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 24px;
    background: #ff2d92;
    color: #050507;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-decoration: none;
    clip-path: polygon(6% 0, 100% 0, 100% 75%, 94% 100%, 0 100%, 0 25%);
    box-shadow: 0 0 40px rgba(255, 45, 146, 0.35);
    transition: background 0.2s ease, color 0.2s ease;
  }
  .nav-mobile-cta:hover { background: #fff; color: #ff2d92; }

  @media (min-width: 1024px) {
    .nav-mobile { display: none; }
  }
</style>
