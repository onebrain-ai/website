---
const harnesses = [
  {
    name: 'Claude Code',
    glyph: '◉',
    bestFor: 'Deep reasoning · long-running agents · skill plugins',
    install: 'npm install -g @anthropic-ai/claude-code',
    runCmd: 'claude',
    instr: 'CLAUDE.md',
    badge: 'RECOMMENDED',
    accent: '#ffb000',
  },
  {
    name: 'Gemini CLI',
    glyph: '◈',
    bestFor: 'Web-grounded research · multimodal · long context',
    install: 'npm install -g @google/gemini-cli',
    runCmd: 'gemini',
    instr: 'GEMINI.md',
    badge: 'NATIVE',
    accent: '#00f3ff',
  },
  {
    name: 'OpenAI Codex',
    glyph: '⌘',
    bestFor: 'Fast loops · code refactor · sandboxed exec',
    install: 'npm install -g @openai/codex',
    runCmd: 'codex',
    instr: 'AGENTS.md',
    badge: 'NATIVE',
    accent: '#ff2d92',
  },
  {
    name: 'Qwen Code',
    glyph: '↯',
    bestFor: 'Open-weights · cost-efficient · self-host',
    install: 'npm install -g @qwen-code/qwen-code',
    runCmd: 'qwen',
    instr: 'AGENTS.md',
    badge: 'NATIVE',
    accent: '#bc13fe',
  },
];

const llmRoutes = [
  { tag: 'LOCAL',  label: 'mlx · ollama · llama.cpp'    },
  { tag: 'CLOUD',  label: 'claude · gemini · gpt · groq' },
  { tag: 'HYBRID', label: 'route by task or by cost'     },
];
---

<section id="harness-setup" class="cyber-section reveal" style="--section-accent: #ffb000;">
  <div class="cyber-section-orb" aria-hidden="true"></div>
  <div class="cyber-section-grid" aria-hidden="true"></div>

  <div class="cyber-section-shell">
    <header class="cyber-section-head">
      <div class="cyber-pill">
        <span class="cyber-pill-dot"></span>
        <span>ONEBRAIN // HARNESS_SETUP</span>
      </div>
      <h2 class="cyber-h2">
        Pick Your<br/>
        <span class="cyber-h2-stroke">Harness.</span>
      </h2>
      <p class="cyber-sub">
        Each harness reads <strong class="brand">OneBrain</strong>'s instructions automatically — install, run inside your vault, the plugin loads on first prompt.
      </p>
    </header>

    <!-- ════════ Side-by-side: Harness install grid (left) + BYO LLM callout (right) ════════ -->
    <div class="harness-content">

      <!-- LEFT: 4 harness install cards in 2×2 -->
      <div class="hc-cards-side">
        <div class="hc-side-eyebrow">// PICK_BY_HARNESS</div>
        <div class="harness-grid">
          {harnesses.map((h) => (
            <article class="harness-card" style={`--card-accent: ${h.accent};`}>
              <span class="hc-stripe" aria-hidden="true"></span>

              <header class="hc-head">
                <span class="hc-glyph" aria-hidden="true">{h.glyph}</span>
                <div class="hc-name-wrap">
                  <h3 class="hc-name">{h.name}</h3>
                  <span class="hc-badge">{h.badge}</span>
                </div>
              </header>

              <p class="hc-best">{h.bestFor}</p>

              <div class="hc-cmd-block">
                <span class="hc-cmd-line"><span class="hc-cmd-prompt">$</span> {h.install}</span>
                <span class="hc-cmd-line"><span class="hc-cmd-prompt">$</span> cd vault &amp;&amp; {h.runCmd}</span>
              </div>

              <footer class="hc-foot">
                <span class="hc-foot-label">READS</span>
                <code class="hc-foot-file">{h.instr}</code>
              </footer>
            </article>
          ))}
        </div>
      </div>

      <!-- RIGHT: BYO LLM — eyebrow OUTSIDE the box, mirroring left side;
           HUD-corner frame (no full border) in cyan to break the
           "everything's a bordered box" pattern. -->
      <div class="hc-byo-side">
        <div class="hc-side-eyebrow byo-side-eyebrow">// BYO_LLM_THROUGH_CLAUDE_CODE</div>

        <div class="byo-llm">
          <span class="byo-corner byo-corner-tl" aria-hidden="true"></span>
          <span class="byo-corner byo-corner-tr" aria-hidden="true"></span>
          <span class="byo-corner byo-corner-bl" aria-hidden="true"></span>
          <span class="byo-corner byo-corner-br" aria-hidden="true"></span>
          <span class="byo-edge byo-edge-l" aria-hidden="true"></span>

          <div class="byo-stack">
            <h3 class="byo-title">
              One harness, <span class="byo-title-stroke">any LLM.</span>
            </h3>
        <p class="byo-sub">
          Point <code>ANTHROPIC_BASE_URL</code> at a router or another provider — Claude stays the harness, the LLM behind swaps per task.
        </p>

        <div class="byo-routes">
          {llmRoutes.map((r) => (
            <div class="byo-route">
              <span class="byo-route-tag">{r.tag}</span>
              <span class="byo-route-label">{r.label}</span>
            </div>
          ))}
        </div>

        <div class="byo-cmd">
          <div class="byo-cmd-header">
            <span class="byo-cmd-dot byo-cmd-dot-r"></span>
            <span class="byo-cmd-dot byo-cmd-dot-y"></span>
            <span class="byo-cmd-dot byo-cmd-dot-g"></span>
            <span class="byo-cmd-title">~/vault · BYO_LLM</span>
          </div>
          <pre class="byo-cmd-body"><code><span class="cmt"># Via claude-code-router (recommended)</span>
npm i -g @musistudio/claude-code-router &amp;&amp; ccr code

<span class="cmt"># Or direct Anthropic-protocol endpoint</span>
<span class="kw">export</span> ANTHROPIC_BASE_URL=<span class="str">https://your-router-host</span>
<span class="kw">export</span> ANTHROPIC_API_KEY=<span class="str">sk-byok</span> &amp;&amp; <span class="kw">cd</span> vault &amp;&amp; claude</code></pre>
            </div>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  /* ── Outer 2-column layout (cards left · BYO right) ────────── */
  .harness-content {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 22px;
    align-items: stretch;
  }
  .hc-cards-side,
  .hc-byo-side {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .hc-side-eyebrow {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.3em;
    color: var(--section-accent);
    text-transform: uppercase;
    margin-bottom: 2px;
  }
  /* Right side eyebrow uses cyan instead of the section's gold accent
     so it doesn't read as the same "// PICK_BY_HARNESS" pill twice. */
  .byo-side-eyebrow {
    color: #00f3ff;
  }
  @media (max-width: 1023px) {
    .harness-content { grid-template-columns: 1fr; gap: 18px; }
  }

  /* ── Harness card grid (2×2 inside left column) ────────────── */
  .harness-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  @media (max-width: 540px) {
    .harness-grid { grid-template-columns: 1fr; }
    /* Trim mobile density: drop the bestFor tagline and the READS row.
       Each card stays useful with name + install/run commands. */
    .hc-best,
    .hc-foot { display: none; }
  }
  .harness-card {
    position: relative;
    padding: 9px 12px 10px;
    background: linear-gradient(180deg, rgba(12, 12, 24, 0.92), rgba(6, 6, 13, 0.92));
    border: 1px solid color-mix(in srgb, var(--card-accent) 25%, rgba(255, 255, 255, 0.06));
    overflow: hidden;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .harness-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--card-accent) 60%, transparent);
    box-shadow: 0 0 22px color-mix(in srgb, var(--card-accent) 18%, transparent);
  }
  .hc-stripe {
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: linear-gradient(90deg,
      var(--card-accent) 0%,
      color-mix(in srgb, var(--card-accent) 30%, transparent) 70%,
      transparent 100%);
    box-shadow: 0 0 10px color-mix(in srgb, var(--card-accent) 60%, transparent);
  }

  .hc-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
  }
  .hc-glyph {
    font-family: var(--font-mono);
    font-size: 18px;
    line-height: 1;
    color: var(--card-accent);
    text-shadow: 0 0 14px var(--card-accent);
    flex-shrink: 0;
  }
  .hc-name-wrap {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .hc-name {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: 1rem;
    color: #fff;
    letter-spacing: 0.02em;
    line-height: 1.1;
  }
  .hc-badge {
    font-family: var(--font-mono);
    font-size: 7.5px;
    letter-spacing: 0.28em;
    color: var(--card-accent);
    text-transform: uppercase;
  }

  .hc-best {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 7px;
    /* clamp to single line so card stays predictable height */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hc-cmd-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 6px 9px;
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-left: 2px solid var(--card-accent);
    margin-bottom: 7px;
  }
  .hc-cmd-line {
    font-family: var(--font-mono);
    font-size: 9.5px;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.85);
    word-break: break-all;
  }
  .hc-cmd-prompt {
    color: var(--card-accent);
    margin-right: 5px;
  }

  .hc-foot {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 6px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }
  .hc-foot-label {
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.3em;
    color: rgba(255, 255, 255, 0.4);
    text-transform: uppercase;
  }
  .hc-foot-file {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--card-accent);
    background: rgba(0, 0, 0, 0.4);
    padding: 2px 6px;
  }

  /* ── BYO LLM callout — different visual language from the left
     cards. Instead of a full bordered tile (which would make it read
     as "another card"), this side uses a subtle dark fill, no full
     border, four cyan HUD corner brackets, and a soft cyan left-edge
     bar. Reads as "console panel" against the cards' "row of tiles". */
  .byo-llm {
    --byo-accent: #00f3ff;
    position: relative;
    padding: 14px 18px 14px 22px;
    background:
      linear-gradient(180deg, rgba(0, 243, 255, 0.05), rgba(8, 8, 14, 0.7) 35%, rgba(8, 8, 14, 0.55));
    border: none;
    overflow: hidden;
    height: 100%;
  }
  .byo-stack {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .byo-corner {
    position: absolute;
    width: 16px;
    height: 16px;
    border: 1px solid var(--byo-accent);
    opacity: 0.85;
  }
  .byo-corner-tl { top: 0;    left: 0;    border-right: 0; border-bottom: 0; }
  .byo-corner-tr { top: 0;    right: 0;   border-left: 0;  border-bottom: 0; }
  .byo-corner-bl { bottom: 0; left: 0;    border-right: 0; border-top: 0; }
  .byo-corner-br { bottom: 0; right: 0;   border-left: 0;  border-top: 0; }
  .byo-edge {
    position: absolute;
    background: linear-gradient(180deg,
      transparent 0%,
      var(--byo-accent) 18%,
      var(--byo-accent) 82%,
      transparent 100%);
    opacity: 0.6;
  }
  .byo-edge-l {
    top: 12%;
    bottom: 12%;
    left: 0;
    width: 1px;
  }
  .byo-title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(1rem, 1.7vw, 1.3rem);
    line-height: 1.1;
    color: #fff;
    letter-spacing: 0.01em;
    margin-top: 0;
  }
  .byo-title-stroke {
    color: transparent;
    -webkit-text-stroke: 1.4px var(--byo-accent);
  }
  .byo-sub {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.6);
  }
  .byo-sub code {
    font-family: var(--font-mono);
    font-size: 0.82em;
    color: var(--byo-accent);
    background: rgba(0, 243, 255, 0.08);
    padding: 1px 6px;
  }

  .byo-routes {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .byo-route {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 4px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }
  .byo-route:first-child { border-top: 0; }
  .byo-route-tag {
    flex-shrink: 0;
    width: 52px;
    font-family: var(--font-mono);
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.26em;
    color: var(--byo-accent);
  }
  .byo-route-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: rgba(255, 255, 255, 0.78);
  }

  /* Right side: terminal mockup */
  .byo-cmd {
    background: #06060c;
    border: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }
  .byo-cmd-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .byo-cmd-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .byo-cmd-dot-r { background: #ff5f57; }
  .byo-cmd-dot-y { background: #ffb000; }
  .byo-cmd-dot-g { background: #28c840; }
  .byo-cmd-title {
    margin-left: 10px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.45);
    text-transform: uppercase;
  }
  .byo-cmd-body {
    margin: 0;
    padding: 8px 12px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.85);
    white-space: pre;
    overflow-x: auto;
  }
  .byo-cmd-body .cmt { color: rgba(255, 255, 255, 0.35); }
  .byo-cmd-body .kw  { color: var(--byo-accent); }
  .byo-cmd-body .str { color: #ff8a3c; }

  /* Section sizing tightening — fit in one viewport. Override default
     desktop section padding (4rem/3rem) so the dense 4-card + BYO grid
     fits below the nav on 700–800px laptop viewports. H2 + sub kept
     close to the global default sizing so this section visually
     matches its siblings (Stack, Workflow, Features). */
  #harness-setup .cyber-section-head { margin-bottom: 0.9rem; }
  #harness-setup .cyber-h2           { font-size: clamp(1.9rem, 4.2vw, 3.4rem); line-height: 0.95; }
  #harness-setup .cyber-sub          { font-size: 0.92rem; max-width: 760px; line-height: 1.55; margin-top: 14px; }
  #harness-setup .cyber-pill         { margin-bottom: 14px; }
  @media (min-width: 1024px) {
    #harness-setup { padding: 1.75rem 3rem 1.5rem; }
  }
</style>
