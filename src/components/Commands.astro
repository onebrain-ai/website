---
// 9 signature skills, ordered as a capture → organise → compound journey.
// Cut from 12: dropped /bookmark (overlaps with /capture), /summarize
// (overlaps with /research), and /daily (overlaps with /weekly).
const commands = [
  // Row 1 — CAPTURE
  { cmd: '/braindump',     desc: 'Capture raw thoughts; agent splits threads and files them.',
    usecase: "You just finished a meeting and have 10 random notes. Use /braindump to feed them all at once; OneBrain will extract tasks and file them into separate project notes automatically." },
  { cmd: '/capture',       desc: 'Quick titled note with auto-linking to related ideas.',
    usecase: 'Reading an interesting article? Use /capture to save a thought about it. OneBrain will automatically link it to your existing research notes on the same topic.' },
  { cmd: '/research',      desc: 'Web research synthesized into a vault note with citations.',
    usecase: "Need to understand 'Large World Models'? Run /research. The agent fetches the latest papers and blog posts, then writes a comprehensive report in your vault." },
  // Row 2 — ORGANISE
  { cmd: '/consolidate',   desc: 'Process inbox into Projects / Areas / Knowledge with one pass.',
    usecase: 'Your inbox is full after a week of work. /consolidate reviews every note and moves them to the correct PARA folders.' },
  { cmd: '/connect',       desc: 'Find unlinked notes that should be connected; propose wikilinks.',
    usecase: "Building a knowledge base? /connect reveals 'hidden' relationships between notes you wrote months apart, creating a dense neural web." },
  { cmd: '/distill',       desc: 'Aggregate sessions on a topic into a structured digest.',
    usecase: "After 5 days of research on a project, /distill synthesizes all session logs into a single 'Source of Truth' knowledge note." },
  // Row 3 — COMPOUND
  { cmd: '/learn',         desc: 'Teach the agent a fact or preference; persists to memory.',
    usecase: "Tell the agent: '/learn I prefer my research reports in bullet points.' It will follow this for all future /research tasks." },
  { cmd: '/weekly',        desc: 'Weekly reflection over what you captured, decided, and shipped.',
    usecase: 'Every Sunday, run /weekly. The agent reviews your progress, surfaces patterns in your thinking, and helps you set intentions for next week.' },
  { cmd: '/doctor',        desc: 'Vault health check: broken links, orphans, stale memory.',
    usecase: 'Run /doctor to identify broken wikilinks or stale memory entries, then use --fix to auto-repair stale confidence scores and broken wikilinks.' },
];
---

<section id="commands" class="cyber-section reveal" style="--section-accent: #ff5e3a;">
  <div class="cyber-section-orb" aria-hidden="true"></div>
  <div class="cyber-section-grid" aria-hidden="true"></div>

  <div class="cyber-section-shell">
    <div class="grid lg:grid-cols-[1fr_1fr] gap-10 lg:gap-14 items-center cmd-grid">

      <!-- LEFT: header + sub + signpost -->
      <div class="cmd-left">
        <header class="cyber-section-head">
          <div class="cyber-pill">
            <span class="cyber-pill-dot"></span>
            <span>ONEBRAIN // COMMANDS</span>
          </div>
          <h2 class="cyber-h2">
            24+ Commands<br/>
            <span class="cyber-h2-stroke">That Think.</span>
          </h2>
          <p class="cyber-sub">
            <strong class="brand">OneBrain</strong> ships 24+ slash commands — vault-aware verbs that wrap deep workflows like research, distill, and weekly review. Tap any card to see what it does.
          </p>
        </header>

        <a
          class="cmd-more"
          href="https://github.com/onebrain-ai/onebrain#commands"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="cmd-more-cta">See full list <span class="cmd-more-arrow">↗</span></span>
        </a>
      </div>

      <!-- RIGHT: 3×3 square card grid -->
      <div class="cmd-grid-cards" role="list">
        {commands.map((c) => (
          <button
            type="button"
            class="cyber-card cmd-card skill-trigger"
            role="listitem"
            data-cmd={c.cmd}
            data-desc={c.desc}
            data-usecase={c.usecase}
          >
            <div class="cmd-row">
              <span class="cmd-prompt">»</span>
              <code class="cmd-name">{c.cmd}</code>
            </div>
            <p class="cyber-card-desc cmd-desc">{c.desc}</p>
          </button>
        ))}
      </div>

    </div>
  </div>

  <!-- Command detail modal -->
  <div id="skill-modal" class="skill-modal" aria-hidden="true">
    <div class="skill-modal-overlay" id="modal-overlay"></div>
    <div class="skill-modal-card" id="modal-content">
      <div class="skill-modal-frame skill-modal-frame-tl"></div>
      <div class="skill-modal-frame skill-modal-frame-tr"></div>
      <div class="skill-modal-frame skill-modal-frame-bl"></div>
      <div class="skill-modal-frame skill-modal-frame-br"></div>

      <div class="skill-modal-head">
        <div>
          <span class="skill-modal-eyebrow">COMMAND_DETAIL</span>
          <h3 id="modal-cmd" class="skill-modal-cmd">Command detail</h3>
        </div>
        <button id="close-modal" type="button" class="skill-modal-close" aria-label="Close">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </div>

      <div class="skill-modal-section">
        <span class="skill-modal-eyebrow">ABSTRACT</span>
        <p id="modal-desc"></p>
      </div>

      <div class="skill-modal-usecase">
        <span class="skill-modal-eyebrow">USE_CASE</span>
        <p id="modal-usecase"></p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const modal = document.getElementById('skill-modal');
    const card = document.getElementById('modal-content');
    const triggers = document.querySelectorAll('.skill-trigger');
    const closeBtn = document.getElementById('close-modal');
    const overlay = document.getElementById('modal-overlay');
    const mCmd = document.getElementById('modal-cmd');
    const mDesc = document.getElementById('modal-desc');
    const mUsecase = document.getElementById('modal-usecase');
    function open(t) {
      mCmd.textContent = t.getAttribute('data-cmd');
      mDesc.textContent = t.getAttribute('data-desc');
      mUsecase.textContent = t.getAttribute('data-usecase');
      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
    function close() {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
    triggers.forEach((t) => t.addEventListener('click', () => open(t)));
    [closeBtn, overlay].forEach((el) => el && el.addEventListener('click', close));
    window.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  })();
</script>

<style>
  /* Section-scoped tightening so the 9-card grid + signpost row fits
     a single viewport on laptop heights, mirroring the Features/
     Workflow pattern. */
  /* Section now uses a 50:50 grid (header left, 3×3 square card grid
     right). Sub copy uses the standard cyber-sub size — no longer
     compressed since the cards moved out of the same column. */
  @media (min-width: 1024px) {
    #commands { padding: 2.25rem 3rem 1.75rem; }
  }
  #commands .cyber-section-head { margin-bottom: 1rem; }

  .cmd-left {
    display: flex;
    flex-direction: column;
  }

  /* 3×3 square grid — each card maintains a 1:1 aspect ratio so the
     right column reads as a 3×3 control panel rather than a list. */
  .cmd-grid-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .cmd-card {
    aspect-ratio: 1 / 1;
    padding: 0.85rem 0.95rem;
    text-align: left;
    cursor: pointer;
    background: rgba(8, 8, 14, 0.5);
    color: inherit;
    width: 100%;
    display: flex;
    flex-direction: column;
  }
  .cmd-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .cmd-prompt {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--section-accent);
    opacity: 0.7;
  }
  .cmd-name {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 12.5px;
    color: var(--section-accent);
    letter-spacing: 0.02em;
  }
  .cmd-desc {
    margin-top: 8px;
    font-size: 10.5px;
    line-height: 1.5;
  }

  /* Mobile / tablet — drop the 50:50 split and the aspect-ratio. The
     cards revert to the original 2/3-col rows-of-rectangles flow. */
  @media (max-width: 1023px) {
    .cmd-grid-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .cmd-card { aspect-ratio: auto; padding: 0.85rem 1rem 0.95rem; }
    .cmd-desc { font-size: 11px; }
  }
  @media (max-width: 540px) {
    .cmd-grid-cards { grid-template-columns: 1fr; }
  }

  /* ── Skill Modal ───────────────────────── */
  .skill-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .skill-modal.open {
    opacity: 1;
    pointer-events: auto;
  }
  .skill-modal-overlay {
    position: absolute;
    inset: 0;
    /* Drop the backdrop-filter blur — opening a fullscreen filter
       layer over a 12-card grid with each card's own hover transitions
       running was a Safari composite hot path. Lift bg alpha 0.78 →
       0.92 so the grid still drops out cleanly behind the modal. */
    background: rgba(2, 2, 4, 0.92);
  }
  .skill-modal-card {
    position: relative;
    width: 100%;
    max-width: 560px;
    margin: 0 1.5rem;
    padding: 2rem 2rem 2.2rem;
    background: rgba(8, 8, 14, 0.92);
    border: 1px solid color-mix(in srgb, var(--section-accent) 35%, transparent);
    box-shadow: 0 0 80px color-mix(in srgb, var(--section-accent) 18%, transparent), 0 30px 60px -20px rgba(0, 0, 0, 0.7);
    transform: scale(0.96);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .skill-modal.open .skill-modal-card { transform: scale(1); }

  .skill-modal-frame {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1px solid var(--section-accent);
  }
  .skill-modal-frame-tl { top: -3px;    left: -3px;    border-right: 0; border-bottom: 0; }
  .skill-modal-frame-tr { top: -3px;    right: -3px;   border-left: 0;  border-bottom: 0; }
  .skill-modal-frame-bl { bottom: -3px; left: -3px;    border-right: 0; border-top: 0; }
  .skill-modal-frame-br { bottom: -3px; right: -3px;   border-left: 0;  border-top: 0; }

  .skill-modal-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    padding-bottom: 1.4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .skill-modal-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--section-accent);
    margin-bottom: 8px;
  }
  .skill-modal-cmd {
    /* Match every other section title — display font italic, not mono.
       Mono italic 900 was reading like a bug rather than a deliberate
       contrast. */
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: 1.8rem;
    color: #fff;
    margin: 0;
    letter-spacing: -0.02em;
  }
  .skill-modal-close {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.5);
    padding: 6px;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .skill-modal-close:hover { color: var(--section-accent); border-color: var(--section-accent); }

  .skill-modal-section {
    margin-top: 1.4rem;
  }
  .skill-modal-section p {
    font-family: var(--font-mono);
    font-size: 13px;
    color: rgba(255, 255, 255, 0.78);
    line-height: 1.65;
    margin: 0;
  }
  .skill-modal-usecase {
    margin-top: 1.4rem;
    padding: 1.1rem 1.2rem;
    border-left: 2px solid var(--section-accent);
    background: color-mix(in srgb, var(--section-accent) 6%, transparent);
  }
  .skill-modal-usecase p {
    font-family: var(--font-mono);
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.7;
    font-style: italic;
    margin: 0;
  }

  /* Footer link below the 9-card grid that signals "this is a curated
     subset, full list lives in the repo." Mirrors the HUD pattern of
     the cyber-pill (mono caps, tracked, dim) without re-using the pill
     styling — it's a signpost, not another section header. */
  /* Small inline signpost link sitting under the sub paragraph in the
     left column. Was previously a full-width dashed row at the bottom
     of the 9-card grid; the 50:50 layout made that row redundant, so
     we shrink to an inline link. */
  .cmd-more {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.6rem;
    margin-top: 1.5rem;
    padding: 8px 14px;
    border: 1px dashed color-mix(in srgb, var(--section-accent) 35%, transparent);
    background: color-mix(in srgb, var(--section-accent) 5%, transparent);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.6);
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .cmd-more:hover {
    color: #fff;
    border-color: var(--section-accent);
    background: color-mix(in srgb, var(--section-accent) 10%, transparent);
  }
  .cmd-more-cta { display: inline-flex; align-items: center; gap: 8px; }
  .cmd-more-arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }
  .cmd-more:hover .cmd-more-arrow { transform: translateX(3px); }

  @media (max-width: 640px) {
    .cmd-more {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
  }
</style>
