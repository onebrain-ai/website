---
// 10 signature skills, ordered as a capture → organise → compound →
// retrieve journey. /search is the newest, promoted as a featured
// wide row (row 4 spans all 3 columns) because retrieval — answering
// "what" and "why" questions across MEMORY.md + memory/ + session
// logs + plan files + vault notes — is the verb most directly tied
// to "AI thinking partner" framing.
//
// Full lineup is 26 user-facing skills (see repo); this grid is the
// curated subset that maps best to a first-time visitor's mental
// model. Anything more would be a docs page, not marketing.
const commands = [
  // Row 1 — CAPTURE
  { cmd: '/braindump',     desc: 'Capture raw thoughts; agent splits threads and files them.',
    usecase: "You just finished a meeting and have 10 random notes. Use /braindump to feed them all at once; OneBrain will extract tasks and file them into separate project notes automatically." },
  { cmd: '/capture',       desc: 'Quick titled note with auto-linking to related ideas.',
    usecase: 'Reading an interesting article? Use /capture to save a thought about it. OneBrain will automatically link it to your existing research notes on the same topic.' },
  { cmd: '/research',      desc: 'Web research synthesized into a vault note with citations.',
    usecase: "Need to understand 'AI agent memory architectures'? Run /research. The agent fetches the latest papers and blog posts, then writes a comprehensive report in your vault." },
  // Row 2 — ORGANISE
  { cmd: '/consolidate',   desc: 'Process inbox into Projects / Areas / Knowledge with one pass.',
    usecase: 'Your inbox is full after a week of work. /consolidate reviews every note and moves them to the correct PARA folders.' },
  { cmd: '/connect',       desc: 'Find unlinked notes that should be connected; propose wikilinks.',
    usecase: "Building a knowledge base? /connect reveals 'hidden' relationships between notes you wrote months apart, creating a dense neural web." },
  { cmd: '/distill',       desc: 'Aggregate sessions on a topic into a structured digest.',
    usecase: "After 5 days of research on a project, /distill synthesizes all session logs into a single 'Source of Truth' knowledge note." },
  // Row 3 — COMPOUND
  { cmd: '/learn',         desc: 'Teach the agent a fact or preference; persists to memory.',
    usecase: "Tell the agent: '/learn I prefer my research reports in bullet points.' It will follow this for all future /research tasks." },
  { cmd: '/weekly',        desc: 'Weekly reflection over what you captured, decided, and shipped.',
    usecase: 'Every Sunday, run /weekly. The agent reviews your progress, surfaces patterns in your thinking, and helps you set intentions for next week.' },
  { cmd: '/doctor',        desc: 'Vault health check: broken links, orphans, stale memory.',
    usecase: 'Run /doctor to spot broken wikilinks, orphan notes, and stale memory files. Add --fix to auto-repair them.' },
  // Row 4 — RETRIEVE (featured wide row, spans all columns)
  { cmd: '/search',        desc: 'Ask "what" and "why" — qmd-powered retrieval across vault + memory + session logs.',
    usecase: "Need to recall a past decision? Run /search 'why did we pick D1 over KV'. OneBrain searches MEMORY.md, memory/, session logs, plan files, and vault notes — qmd hybrid (lex + vec + hyde) under the hood, grep fallback if qmd isn't indexed.",
    featured: true },
];
---

<section id="commands" class="cyber-section reveal" style="--section-accent: #ff5e3a;">
  <div class="cyber-section-orb" aria-hidden="true"></div>
  <div class="cyber-section-grid" aria-hidden="true"></div>

  <div class="cyber-section-shell">
    <div class="grid lg:grid-cols-[1fr_1fr] gap-10 lg:gap-14 items-center cmd-grid">

      <!-- LEFT: header + sub + signpost -->
      <div class="cmd-left">
        <header class="cyber-section-head">
          <div class="cyber-pill">
            <span class="cyber-pill-dot"></span>
            <span>ONEBRAIN // COMMANDS</span>
          </div>
          <h2 class="cyber-h2">
            26 Commands<br/>
            <span class="cyber-h2-stroke">That Think.</span>
          </h2>
          <p class="cyber-sub">
            <strong class="brand">OneBrain</strong> ships 26 slash commands and 5 background agents — vault-aware verbs that wrap real workflows. <strong>/research</strong> builds reports, <strong>/distill</strong> synthesizes weeks of notes, <strong>/doctor</strong> audits your graph.
          </p>
        </header>

        <a
          class="cmd-more"
          href="https://github.com/onebrain-ai/onebrain#commands"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="cmd-more-cta">See full list <span class="cmd-more-arrow">↗</span></span>
        </a>
      </div>

      <!-- RIGHT: 3-col card grid with a featured wide row 4 for
           /search (RETRIEVE). The first 9 cards lay out as a 3×3
           control panel; the 10th card has `.cmd-card-featured`
           which spans all 3 columns and uses a horizontal layout
           (name + desc on one line) to signal "this is the new /
           highlighted command" without breaking the grid rhythm.
           No forced role=list — the native <button> semantics carry
           the trigger meaning, and role=listitem on a <button> is
           invalid ARIA. -->
      <div class="cmd-grid-cards">
        {commands.map((c) => (
          <button
            type="button"
            class:list={[
              'cyber-card cmd-card skill-trigger',
              c.featured && 'cmd-card-featured',
            ]}
            aria-haspopup="dialog"
            aria-controls="skill-modal"
            data-cmd={c.cmd}
            data-desc={c.desc}
            data-usecase={c.usecase}
          >
            {c.featured && (
              /* aria-hidden — the visible "NEW" badge is decorative.
                 Without it, SR users hear "NEW /search ..." which
                 front-loads marketing chrome before the command name.
                 Hiding from AT lets the button announce as just the
                 command + description; sighted users still get the
                 NEW signal visually. */
              <span class="cmd-featured-tag" aria-hidden="true">NEW</span>
            )}
            <div class="cmd-row">
              <span class="cmd-prompt">»</span>
              <code class="cmd-name">{c.cmd}</code>
            </div>
            <p class="cyber-card-desc cmd-desc">{c.desc}</p>
          </button>
        ))}
      </div>

    </div>
  </div>

  <!-- Command detail modal -->
  <div
    id="skill-modal"
    class="skill-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-cmd"
    aria-describedby="modal-desc"
    aria-hidden="true"
  >
    <div class="skill-modal-overlay" id="modal-overlay"></div>
    <div class="skill-modal-card" id="modal-content">
      <div class="skill-modal-frame skill-modal-frame-tl" aria-hidden="true"></div>
      <div class="skill-modal-frame skill-modal-frame-tr" aria-hidden="true"></div>
      <div class="skill-modal-frame skill-modal-frame-bl" aria-hidden="true"></div>
      <div class="skill-modal-frame skill-modal-frame-br" aria-hidden="true"></div>

      <div class="skill-modal-head">
        <div>
          <span class="skill-modal-eyebrow">COMMAND_DETAIL</span>
          <h3 id="modal-cmd" class="skill-modal-cmd">Command detail</h3>
        </div>
        <button id="close-modal" type="button" class="skill-modal-close" aria-label="Close command detail">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </div>

      <div class="skill-modal-section">
        <span class="skill-modal-eyebrow">ABSTRACT</span>
        <p id="modal-desc"></p>
      </div>

      <div class="skill-modal-usecase">
        <span class="skill-modal-eyebrow">USE_CASE</span>
        <p id="modal-usecase"></p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const modal = document.getElementById('skill-modal');
    const triggers = document.querySelectorAll('.skill-trigger');
    const closeBtn = document.getElementById('close-modal');
    const overlay = document.getElementById('modal-overlay');
    const mCmd = document.getElementById('modal-cmd');
    const mDesc = document.getElementById('modal-desc');
    const mUsecase = document.getElementById('modal-usecase');
    if (!modal) return;

    // Background-inert scope: walk from <body> down through each
    // ancestor that contains the modal, inerting every sibling that
    // doesn't. The modal lives inside #commands inside <main> inside
    // <body>, so the chain is body → main → #commands → modal. Direct
    // children of <body> that aren't <main> (page-spine, warp overlays,
    // footer) get inert'd at the top level; main's other section
    // children (Hero, Cloud, Synergy…) get inert'd one level down. A
    // single-level body.children walk would skip <main> entirely
    // (because main contains the modal) and leave every section
    // reachable to AT and pointer events.
    function inertScope() {
      const out = [];
      function descend(parent) {
        for (const el of parent.children) {
          if (el === modal) continue;
          if (el.contains(modal)) {
            descend(el);
          } else {
            out.push(el);
          }
        }
      }
      descend(document.body);
      return out;
    }
    // Tab cycle: every focusable inside the dialog. Re-queried per Tab
    // because content (close button vs trigger) is static but cheap.
    function focusables() {
      return Array.from(
        modal.querySelectorAll(
          'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((el) => !el.hasAttribute('disabled') && el.offsetParent !== null);
    }

    let _lastTrigger = null;
    let _inerted = [];
    function open(t) {
      _lastTrigger = t;
      mCmd.textContent = t.getAttribute('data-cmd');
      mDesc.textContent = t.getAttribute('data-desc');
      mUsecase.textContent = t.getAttribute('data-usecase');
      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      _inerted = inertScope();
      _inerted.forEach((el) => el.setAttribute('inert', ''));
      // Wait one frame so the dialog has applied .open + opacity 1
      // before focus lands; otherwise Safari paints the focus ring
      // briefly on the still-invisible close button.
      requestAnimationFrame(() => {
        if (closeBtn) closeBtn.focus();
      });
    }
    function close() {
      if (modal.getAttribute('aria-hidden') === 'true') return;
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      _inerted.forEach((el) => el.removeAttribute('inert'));
      _inerted = [];
      if (_lastTrigger) {
        _lastTrigger.focus();
        _lastTrigger = null;
      }
    }
    triggers.forEach((t) => t.addEventListener('click', () => open(t)));
    [closeBtn, overlay].forEach((el) => el && el.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (modal.getAttribute('aria-hidden') === 'true') return;
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
        return;
      }
      if (e.key === 'Tab') {
        const list = focusables();
        if (list.length === 0) {
          e.preventDefault();
          return;
        }
        const first = list[0];
        const last = list[list.length - 1];
        // If focus left the dialog (overlay click, etc.), pull it back
        // in instead of letting Tab escape to the inerted background.
        if (!modal.contains(document.activeElement)) {
          e.preventDefault();
          first.focus();
          return;
        }
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  })();
</script>

<style>
  /* Section-scoped tightening so the 9-card grid + signpost row fits
     a single viewport on laptop heights, mirroring the Features/
     Workflow pattern. */
  /* Section now uses a 50:50 grid (header left, 3×3 square card grid
     right). Sub copy uses the standard cyber-sub size — no longer
     compressed since the cards moved out of the same column. */
  @media (min-width: 1024px) {
    #commands { padding: 2.25rem 3rem 1.75rem; }
  }
  #commands .cyber-section-head { margin-bottom: 1rem; }

  .cmd-left {
    display: flex;
    flex-direction: column;
  }

  /* 3×3 square grid — each card maintains a 1:1 aspect ratio so the
     right column reads as a 3×3 control panel rather than a list. */
  .cmd-grid-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .cmd-card {
    aspect-ratio: 1 / 1;
    padding: 0.85rem 0.95rem;
    text-align: left;
    cursor: pointer;
    background: rgba(8, 8, 14, 0.5);
    color: inherit;
    width: 100%;
    display: flex;
    flex-direction: column;
  }
  .cmd-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .cmd-prompt {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--section-accent);
    opacity: 0.7;
  }
  .cmd-name {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 12.5px;
    color: var(--section-accent);
    letter-spacing: 0.02em;
  }
  .cmd-desc {
    margin-top: 8px;
    font-size: 10.5px;
    line-height: 1.5;
  }

  /* Featured wide card — spans all 3 columns on row 4 to highlight
     /search as the RETRIEVE verb. Drops the 1:1 aspect ratio so the
     card stays short (single-row height instead of stacking under a
     normal grid cell), uses a horizontal layout (name + desc inline),
     and gets a NEW tag in the top-right. */
  .cmd-card-featured {
    grid-column: 1 / -1;
    aspect-ratio: auto;
    padding: 1rem 1.1rem;
    position: relative;
    background: color-mix(in srgb, var(--section-accent) 8%, rgba(8, 8, 14, 0.6));
    border-color: color-mix(in srgb, var(--section-accent) 45%, transparent);
  }
  .cmd-card-featured .cmd-row { gap: 8px; }
  .cmd-card-featured .cmd-name { font-size: 14px; }
  .cmd-card-featured .cmd-desc {
    margin-top: 6px;
    font-size: 11.5px;
    line-height: 1.55;
  }
  .cmd-featured-tag {
    position: absolute;
    top: 8px;
    right: 10px;
    padding: 2px 6px;
    font-family: var(--font-mono);
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--section-accent);
    background: color-mix(in srgb, var(--section-accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--section-accent) 45%, transparent);
  }

  /* Mobile / tablet — drop the 50:50 split and the aspect-ratio. The
     cards revert to the original 2/3-col rows-of-rectangles flow.
     The featured card still spans the full row width via the
     `grid-column: 1 / -1` rule above, which works at any column count. */
  @media (max-width: 1023px) {
    .cmd-grid-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .cmd-card { aspect-ratio: auto; padding: 0.85rem 1rem 0.95rem; }
    .cmd-desc { font-size: 11px; }
  }
  @media (max-width: 540px) {
    .cmd-grid-cards { grid-template-columns: 1fr; }
    /* On single-column mobile every card is full-width, so the row-
       spanning behavior alone no longer differentiates the featured
       card from the other 9. Add a left accent stripe + bump the NEW
       tag font size so the row reads as featured at a glance. */
    .cmd-card-featured {
      border-left: 3px solid var(--section-accent);
      padding-left: 0.85rem;
    }
    .cmd-featured-tag { font-size: 10px; padding: 3px 7px; }
  }

  /* ── Skill Modal ───────────────────────── */
  .skill-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .skill-modal.open {
    opacity: 1;
    pointer-events: auto;
  }
  .skill-modal-overlay {
    position: absolute;
    inset: 0;
    /* Drop the backdrop-filter blur — opening a fullscreen filter
       layer over a 12-card grid with each card's own hover transitions
       running was a Safari composite hot path. Lift bg alpha 0.78 →
       0.92 so the grid still drops out cleanly behind the modal. */
    background: rgba(2, 2, 4, 0.92);
  }
  .skill-modal-card {
    position: relative;
    width: 100%;
    max-width: 560px;
    margin: 0 1.5rem;
    padding: 2rem 2rem 2.2rem;
    background: rgba(8, 8, 14, 0.92);
    border: 1px solid color-mix(in srgb, var(--section-accent) 35%, transparent);
    box-shadow: 0 0 80px color-mix(in srgb, var(--section-accent) 18%, transparent), 0 30px 60px -20px rgba(0, 0, 0, 0.7);
    transform: scale(0.96);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .skill-modal.open .skill-modal-card { transform: scale(1); }

  .skill-modal-frame {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1px solid var(--section-accent);
  }
  .skill-modal-frame-tl { top: -3px;    left: -3px;    border-right: 0; border-bottom: 0; }
  .skill-modal-frame-tr { top: -3px;    right: -3px;   border-left: 0;  border-bottom: 0; }
  .skill-modal-frame-bl { bottom: -3px; left: -3px;    border-right: 0; border-top: 0; }
  .skill-modal-frame-br { bottom: -3px; right: -3px;   border-left: 0;  border-top: 0; }

  .skill-modal-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    padding-bottom: 1.4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .skill-modal-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--section-accent);
    margin-bottom: 8px;
  }
  .skill-modal-cmd {
    /* Match every other section title — display font italic, not mono.
       Mono italic 900 was reading like a bug rather than a deliberate
       contrast. */
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: 1.8rem;
    color: #fff;
    margin: 0;
    letter-spacing: -0.02em;
  }
  .skill-modal-close {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.5);
    padding: 6px;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .skill-modal-close:hover { color: var(--section-accent); border-color: var(--section-accent); }

  .skill-modal-section {
    margin-top: 1.4rem;
  }
  .skill-modal-section p {
    font-family: var(--font-mono);
    font-size: 13px;
    color: rgba(255, 255, 255, 0.78);
    line-height: 1.65;
    margin: 0;
  }
  .skill-modal-usecase {
    margin-top: 1.4rem;
    padding: 1.1rem 1.2rem;
    border-left: 2px solid var(--section-accent);
    background: color-mix(in srgb, var(--section-accent) 6%, transparent);
  }
  .skill-modal-usecase p {
    font-family: var(--font-mono);
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.7;
    font-style: italic;
    margin: 0;
  }

  /* Footer link below the 9-card grid that signals "this is a curated
     subset, full list lives in the repo." Mirrors the HUD pattern of
     the cyber-pill (mono caps, tracked, dim) without re-using the pill
     styling — it's a signpost, not another section header. */
  /* Small inline signpost link sitting under the sub paragraph in the
     left column. Was previously a full-width dashed row at the bottom
     of the 9-card grid; the 50:50 layout made that row redundant, so
     we shrink to an inline link. */
  .cmd-more {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.6rem;
    margin-top: 1.5rem;
    padding: 8px 14px;
    border: 1px dashed color-mix(in srgb, var(--section-accent) 35%, transparent);
    background: color-mix(in srgb, var(--section-accent) 5%, transparent);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.6);
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .cmd-more:hover {
    color: #fff;
    border-color: var(--section-accent);
    background: color-mix(in srgb, var(--section-accent) 10%, transparent);
  }
  .cmd-more-cta { display: inline-flex; align-items: center; gap: 8px; }
  .cmd-more-arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }
  .cmd-more:hover .cmd-more-arrow { transform: translateX(3px); }

  @media (max-width: 640px) {
    .cmd-more {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
  }
</style>
