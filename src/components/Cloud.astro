---
const tiers = [
  {
    name: 'FREE',
    tagline: 'Always free & open source',
    desc: 'Local vault · OSS skills · BYOK',
    status: 'AVAILABLE_NOW',
    href: 'https://github.com/onebrain-ai/onebrain#installation',
  },
  { name: 'PRO',  desc: 'Sync · mobile · hosted runtime',  status: 'COMING_SOON' },
  { name: 'TEAM', desc: 'Shared intelligence · team mesh', status: 'COMING_SOON' },
];
---

<section id="cloud" class="cyber-section reveal" style="--section-accent: #00bfff;">
  <div class="cyber-section-orb" aria-hidden="true"></div>
  <div class="cyber-section-grid" aria-hidden="true"></div>

  <div class="cyber-section-shell">
    <div class="grid lg:grid-cols-[7fr_3fr] gap-10 lg:gap-12 items-start">

      <!-- LEFT: heading + tiers -->
      <div>
        <header class="cyber-section-head">
          <div class="cyber-pill">
            <span class="cyber-pill-dot"></span>
            <span>ONEBRAIN // CLOUD</span>
          </div>
          <h2 class="cyber-h2">
            OneBrain<br/>
            <span class="cyber-h2-stroke">Cloud.</span>
          </h2>
          <p class="cyber-sub">
            <strong class="brand">OneBrain</strong> Cloud syncs across every device and hosts the agent runtime — your unified intelligence travels with you.
          </p>
        </header>

        <div class="tiers">
          {tiers.map((t, i) => {
            const Tag = t.href ? 'a' : 'div';
            const props = t.href
              ? { href: t.href, target: '_blank', rel: 'noopener noreferrer' }
              : { 'aria-disabled': 'true' };
            return (
              <Tag class={`cyber-card tier-card ${t.href ? 'tier-card-live' : 'tier-card-soon'}`} {...props}>
                <span class="cyber-card-meta">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="cyber-card-title tier-name">{t.name}</h3>
                {t.tagline && <span class="tier-tagline">// {t.tagline}</span>}
                <p class="cyber-card-desc">{t.desc}</p>
                <span class="tier-status">
                  {t.href && <span class="tier-status-dot" aria-hidden="true"></span>}
                  [ {t.status} ]
                  {t.href && <span class="tier-arrow" aria-hidden="true">→</span>}
                </span>
              </Tag>
            );
          })}
        </div>
      </div>

      <!-- RIGHT: signup console -->
      <div class="waitlist-shell">
        <div class="waitlist-frame waitlist-frame-tl"></div>
        <div class="waitlist-frame waitlist-frame-tr"></div>
        <div class="waitlist-frame waitlist-frame-bl"></div>
        <div class="waitlist-frame waitlist-frame-br"></div>

        <div class="waitlist-head">
          <span class="waitlist-rec-dot"></span>
          <span>CLOUD WAITLIST :: OPEN</span>
        </div>

        <h3 class="waitlist-title">Lock in early access to <strong>PRO + TEAM</strong>.</h3>
        <p class="waitlist-blurb">
          Drop your email and we'll let you know the moment sync, hosted runtime,
          and team mesh ship — no spam, just the launch notice.
        </p>

        <form id="waitlist-form" class="waitlist-form">
          <label class="waitlist-label">
            <span>YOUR EMAIL</span>
            <input
              type="email"
              required
              placeholder="hello@onebrain.run"
              class="waitlist-input"
              autocomplete="email"
            />
          </label>

          <button type="submit" class="waitlist-btn">
            <span>NOTIFY ME AT LAUNCH</span>
            <span class="waitlist-btn-arrow">→</span>
          </button>
        </form>

        <div
          id="waitlist-banner"
          role="status"
          aria-live="polite"
          class="waitlist-banner"
        ></div>

        <p class="waitlist-foot">
          // early signups get priority access when PRO + TEAM go live
        </p>
      </div>

    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const form = document.getElementById('waitlist-form');
    const banner = document.getElementById('waitlist-banner');
    const input = form && form.querySelector('input[type="email"]');
    const button = form && form.querySelector('button[type="submit"]');
    if (!form || !banner || !input || !button) return;

    function showBanner(state, message) {
      banner.dataset.state = state;
      banner.textContent = message;
      banner.classList.add('show');
      banner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = input.value.trim();
      if (!email) return;

      button.disabled = true;
      const originalLabel = button.textContent;
      const labelEl = button.querySelector('span');
      if (labelEl) labelEl.textContent = 'SENDING_';

      try {
        const res = await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          showBanner('success', '✓ Got it. You\'re on the list — we\'ll ping you at launch.');
          form.reset();
        } else if (data.error === 'invalid_email') {
          showBanner('error', '✗ That email looks off. Try again.');
        } else {
          showBanner('error', '✗ Something went wrong. Try again in a moment.');
        }
      } catch (_e) {
        showBanner('error', '✗ Network error. Try again.');
      } finally {
        button.disabled = false;
        if (labelEl) labelEl.textContent = 'NOTIFY ME AT LAUNCH';
        else button.textContent = originalLabel;
      }
    });
  })();
</script>

<style>
  /* Vertical card style: 3 tiers laid out side-by-side, each card
     orientates vertically (meta + name → desc → status). On mobile
     they stack to a single column. */
  .tiers {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .tiers { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .tier-card {
    padding: 1.25rem 1.25rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-decoration: none;
    color: inherit;
    min-height: 170px;
    position: relative;
  }
  .tier-card .cyber-card-meta {
    position: absolute;
    top: 0.85rem;
    right: 1rem;
  }
  .tier-card .cyber-card-desc { margin-top: 0; }
  .tier-name {
    letter-spacing: 0.08em;
    font-size: 1.05rem;
    margin: 0;
  }
  /* Small accent-tinted tagline that sits under the tier name —
     reserved for messaging that needs to land before the dense
     desc line (e.g. FREE's "always free & open source" promise). */
  .tier-tagline {
    display: block;
    margin-top: -2px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--section-accent);
  }
  .tier-status {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.3em;
    color: var(--section-accent);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-top: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  /* ── FREE: live, clickable, brand-glow border ── */
  a.tier-card.tier-card-live {
    position: relative;
    cursor: pointer;
    border-color: color-mix(in srgb, var(--section-accent) 55%, transparent);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--section-accent) 25%, transparent),
      0 0 30px -8px color-mix(in srgb, var(--section-accent) 60%, transparent);
    /* Animate transform + border-color only — the 50px-spread box-shadow
       on hover is a Safari paint hot path; switch it as a static :hover
       value so the transition doesn't repaint the whole card every frame. */
    transition: border-color 0.25s ease, transform 0.25s ease;
  }
  a.tier-card.tier-card-live::before {
    /* Left edge accent rail — same vocabulary as the hero cmd-box. */
    content: '';
    position: absolute;
    top: -1px;
    bottom: -1px;
    left: -1px;
    width: 3px;
    background: var(--section-accent);
    box-shadow: 0 0 12px var(--section-accent);
  }
  a.tier-card.tier-card-live:hover {
    transform: translateY(-2px);
    border-color: var(--section-accent);
    box-shadow:
      0 0 0 1px var(--section-accent),
      0 0 50px -6px color-mix(in srgb, var(--section-accent) 75%, transparent);
  }
  a.tier-card.tier-card-live .tier-name {
    color: #fff;
  }
  .tier-status-dot {
    width: 6px;
    height: 6px;
    background: var(--section-accent);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--section-accent);
    animation: cyber-pulse 1.5s ease-in-out infinite;
  }
  .tier-arrow {
    color: var(--section-accent);
    transition: transform 0.25s ease;
    margin-left: 4px;
  }
  a.tier-card.tier-card-live:hover .tier-arrow { transform: translateX(4px); }

  /* ── PRO / TEAM: dimmed, "coming soon" ── */
  .tier-card.tier-card-soon {
    opacity: 0.55;
    cursor: default;
  }
  .tier-card.tier-card-soon .tier-status {
    color: var(--section-accent);
    letter-spacing: 0.32em;
    animation: tier-soon-blink 2.4s ease-in-out infinite;
  }
  .tier-card.tier-card-soon .cyber-card-desc {
    color: rgba(255, 255, 255, 0.32);
  }
  /* Stagger TEAM relative to PRO so they pulse out of sync — feels like
     two independent "incoming" signals rather than one synchronized banner. */
  .tier-card.tier-card-soon:nth-of-type(3) .tier-status {
    animation-delay: 1.2s;
  }
  @keyframes tier-soon-blink {
    0%, 100% { opacity: 1; }
    48%      { opacity: 0.25; }
    52%      { opacity: 0.25; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tier-card.tier-card-soon .tier-status { animation: none; }
  }

  /* Waitlist console */
  .waitlist-shell {
    position: relative;
    padding: 2rem 2rem 1.6rem;
    background: rgba(8, 8, 14, 0.82);
    border: 1px solid color-mix(in srgb, var(--section-accent) 22%, transparent);
    /* drop heavy backdrop-filter — solid bg keeps the look, frees the compositor */
  }
  .waitlist-frame {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1px solid var(--section-accent);
  }
  .waitlist-frame-tl { top: -3px;    left: -3px;    border-right: 0; border-bottom: 0; }
  .waitlist-frame-tr { top: -3px;    right: -3px;   border-left: 0;  border-bottom: 0; }
  .waitlist-frame-bl { bottom: -3px; left: -3px;    border-right: 0; border-top: 0; }
  .waitlist-frame-br { bottom: -3px; right: -3px;   border-left: 0;  border-top: 0; }

  .waitlist-head {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.3em;
    color: var(--section-accent);
    text-transform: uppercase;
    margin-bottom: 1.4rem;
  }
  .waitlist-rec-dot {
    width: 6px;
    height: 6px;
    background: var(--section-accent);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--section-accent);
    animation: cyber-pulse 1.5s ease-in-out infinite;
  }

  .waitlist-title {
    margin: 0 0 0.7rem;
    /* Match site H2 vocabulary — Chakra Petch italic, just smaller. */
    font-family: 'Chakra Petch', var(--font-display), sans-serif;
    font-style: italic;
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.25;
    color: #fff;
    letter-spacing: -0.01em;
    text-transform: none;
  }
  .waitlist-title strong {
    color: var(--section-accent);
    font-weight: 700;
  }
  .waitlist-blurb {
    /* Match .cyber-sub vocabulary — JetBrains Mono body. */
    margin: 0 0 2rem;
    font-family: 'JetBrains Mono', var(--font-mono), monospace;
    font-size: 12.5px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.6);
    max-width: 44ch;
  }
  .waitlist-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .waitlist-label {
    display: block;
    font-family: var(--font-mono);
  }
  .waitlist-label > span {
    display: block;
    font-size: 9px;
    letter-spacing: 0.4em;
    color: rgba(255, 255, 255, 0.35);
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .waitlist-input {
    width: 100%;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 14px 16px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: #fff;
    letter-spacing: 0.02em;
    transition: border-color 0.25s ease;
  }
  .waitlist-input:focus {
    outline: none;
    border-color: var(--section-accent);
  }
  .waitlist-input::placeholder { color: rgba(255, 255, 255, 0.22); }

  /* Matches Hero's btn-cyber-primary so the waitlist CTA reads as the
     same button family — clip-path bevels, mono caps, accent fill on
     dark text, white-flip on hover. align-self:flex-start drops the
     full-width stretch the form's column flex was forcing — auto-
     width feels less "marketing landing page" and more operator HUD. */
  .waitlist-btn {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 18px 30px;
    background: var(--section-accent);
    color: #050507;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    border: 1px solid var(--section-accent);
    cursor: pointer;
    transition: color 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                background 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    clip-path: polygon(8% 0, 100% 0, 100% 75%, 92% 100%, 0 100%, 0 25%);
    box-shadow: 0 0 40px color-mix(in srgb, var(--section-accent) 35%, transparent);
  }
  .waitlist-btn:hover {
    background: #fff;
    color: var(--section-accent);
    box-shadow: 0 0 70px color-mix(in srgb, var(--section-accent) 60%, transparent);
  }
  .waitlist-btn-arrow { transition: transform 0.3s ease; }
  .waitlist-btn:hover .waitlist-btn-arrow { transform: translateX(4px); }

  .waitlist-banner {
    display: none;
    margin-top: 1rem;
    padding: 12px 16px;
    border: 1px solid color-mix(in srgb, var(--section-accent) 40%, transparent);
    background: color-mix(in srgb, var(--section-accent) 6%, transparent);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.6;
    color: color-mix(in srgb, var(--section-accent) 70%, white);
    letter-spacing: 0.04em;
  }
  .waitlist-banner.show { display: block; }
  .waitlist-banner[data-state="success"] {
    border-color: rgba(40, 201, 63, 0.45);
    background: rgba(40, 201, 63, 0.06);
    color: #6dd47e;
  }
  .waitlist-banner[data-state="error"] {
    border-color: rgba(255, 95, 87, 0.45);
    background: rgba(255, 95, 87, 0.06);
    color: #ff8b85;
  }
  .waitlist-link:hover { color: var(--section-accent); }
  .waitlist-btn:disabled { opacity: 0.5; cursor: wait; }

  .waitlist-foot {
    margin-top: 1.2rem;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.3);
    text-transform: lowercase;
    font-style: italic;
  }
</style>
