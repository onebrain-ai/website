---
import { getGitHubStars, formatStars } from '../lib/gh-stars';

// Cloudflare Turnstile sitekey — public (safe to commit). Override at
// build time with `PUBLIC_TURNSTILE_SITEKEY` env var (`.env.production`
// or Cloudflare Workers Builds environment). The placeholder below is
// the always-pass test sitekey from Cloudflare docs — fine for local
// dev, but in production it accepts every submission without
// challenging, which silently defeats the bot protection. The PR that
// adds this code MUST be paired with setting the real sitekey + the
// matching `TURNSTILE_SECRET` (via `wrangler versions secret put`)
// before the next deploy lands.
const TURNSTILE_SITEKEY =
  import.meta.env.PUBLIC_TURNSTILE_SITEKEY || '1x00000000000000000000AA';

// Discriminated union: `live` tiers carry the link + tagline that the
// card uses to render the active state; `soon` tiers don't. Coupling
// these fields by tag prevents a future edit from adding `href`
// without `tagline` (or vice versa) and rendering a half-broken card.
type Tier =
  | { kind: 'live'; name: string; desc: string; status: string; tagline: string; href: string }
  | { kind: 'soon'; name: string; desc: string; status: string };

const tiers: Tier[] = [
  {
    kind: 'live',
    name: 'FREE',
    tagline: 'Always free & open source',
    desc: 'Local vault · OSS skills · BYOK',
    status: 'AVAILABLE_NOW',
    href: 'https://github.com/onebrain-ai/onebrain#installation',
  },
  { kind: 'soon', name: 'PRO',  desc: 'Sync · mobile · hosted runtime',  status: '~$10/MO · Q3 2026' },
  { kind: 'soon', name: 'TEAM', desc: 'Shared intelligence · team mesh', status: '~$25/MO · Q3 2026' },
];

const stars = await getGitHubStars();
const starsLabel = formatStars(stars);
// Hide the badge entirely if the build-time fetch fell back to 0 —
// rendering "0 stars on GitHub" as social proof is worse than rendering
// nothing.
const showStars = stars > 0;
---

<section id="cloud" class="cyber-section reveal" style="--section-accent: #00bfff;">
  <div class="cyber-section-orb" aria-hidden="true"></div>
  <div class="cyber-section-grid" aria-hidden="true"></div>

  <div class="cyber-section-shell">
    <div class="grid lg:grid-cols-[7fr_3fr] gap-10 lg:gap-12 items-stretch cloud-grid">

      <!-- LEFT: heading + tiers -->
      <div>
        <header class="cyber-section-head">
          <div class="cyber-pill">
            <span class="cyber-pill-dot"></span>
            <span>ONEBRAIN // CLOUD</span>
          </div>
          <h2 class="cyber-h2">
            OneBrain<br/>
            <span class="cyber-h2-stroke">Cloud.</span>
          </h2>
          <p class="cyber-sub">
            <strong class="brand">OneBrain</strong> Cloud hosts your vault + agent runtime so the <em>same</em> memory, skills, and notes follow you from Mac to iPhone to wherever you write next.
          </p>
        </header>

        <div class="tiers">
          {tiers.map((t, i) => {
            const isLive = t.kind === 'live';
            const Tag = isLive ? 'a' : 'div';
            const props = isLive
              ? { href: t.href, target: '_blank', rel: 'noopener noreferrer' }
              : { 'aria-disabled': 'true' };
            return (
              <Tag class={`cyber-card tier-card ${isLive ? 'tier-card-live' : 'tier-card-soon'}`} {...props}>
                <span class="cyber-card-meta">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="cyber-card-title tier-name">{t.name}</h3>
                {isLive && <span class="tier-tagline">// {t.tagline}</span>}
                <p class="cyber-card-desc">{t.desc}</p>
                <span class="tier-status">
                  {isLive && <span class="tier-status-dot" aria-hidden="true"></span>}
                  [ {t.status} ]
                  {isLive && <span class="tier-arrow" aria-hidden="true">→</span>}
                </span>
              </Tag>
            );
          })}
        </div>
      </div>

      <!-- RIGHT: signup console -->
      <div class="waitlist-shell">
        <div class="waitlist-frame waitlist-frame-tl"></div>
        <div class="waitlist-frame waitlist-frame-tr"></div>
        <div class="waitlist-frame waitlist-frame-bl"></div>
        <div class="waitlist-frame waitlist-frame-br"></div>

        <div class="waitlist-head">
          <span class="waitlist-rec-dot"></span>
          <span>CLOUD WAITLIST :: OPEN</span>
        </div>

        <div class="waitlist-proof" aria-label="Social proof">
          {showStars && (
            <>
              <a
                href="https://github.com/onebrain-ai/onebrain"
                target="_blank"
                rel="noopener noreferrer"
                class="waitlist-proof-stars"
                aria-label={`${stars} stars on GitHub`}
              >
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 .587l3.668 7.568L24 9.75l-6 5.848 1.417 8.265L12 19.771 4.583 23.863 6 15.598 0 9.75l8.332-1.595z"/>
                </svg>
                <span class="waitlist-proof-num">{starsLabel}</span>
                <span class="waitlist-proof-tag">stars on github</span>
              </a>
              <span class="waitlist-proof-sep" aria-hidden="true">·</span>
            </>
          )}
          <span class="waitlist-proof-built">
            Built by
            <a href="https://github.com/kengio" target="_blank" rel="noopener noreferrer">@kengio</a>
          </span>
        </div>

        <h3 class="waitlist-title">Early signups get <strong>priority access + founder pricing</strong>.</h3>

        <form id="waitlist-form" class="waitlist-form">
          <label class="waitlist-label" for="waitlist-email">
            <span>YOUR EMAIL</span>
            <input
              id="waitlist-email"
              name="email"
              type="email"
              required
              placeholder="hello@onebrain.run"
              class="waitlist-input"
              autocomplete="email"
              aria-describedby="waitlist-banner"
            />
          </label>

          {/* Honeypot — naive bots fill every <input>; humans never see it
              (visually offscreen, tab-skipped, aria-hidden, autocomplete
              off). A non-empty value triggers a silent 200 server-side
              (no row written, attacker can't distinguish "blocked" from
              "accepted"). 60-80% of script-kiddie spam blocked at zero
              UX cost. */}
          <div class="waitlist-hp" aria-hidden="true">
            <label>
              Company (leave blank)
              <input
                type="text"
                name="company"
                tabindex="-1"
                autocomplete="off"
                value=""
              />
            </label>
          </div>

          {/* Cloudflare Turnstile — `appearance="interaction-only"` is
              the current "invisible" mode (Cloudflare removed
              `size="invisible"` in 2024). Widget auto-runs on page
              load, generates a `cf-turnstile-response` token, and
              hides itself unless the risk model decides to challenge
              the visitor. Submit handler reads the token and sends it
              to /api/waitlist; server verifies via siteverify endpoint.
              The expired callback clears the cached token so a
              long-lingering visitor's submit triggers a fresh
              validation rather than sending a 5-minute-stale token. */}
          <div
            class="cf-turnstile"
            data-sitekey={TURNSTILE_SITEKEY}
            data-appearance="interaction-only"
            data-theme="dark"
            data-callback="onObTurnstileToken"
            data-expired-callback="onObTurnstileExpired"
          ></div>

          <button type="submit" class="waitlist-btn">
            <span>NOTIFY ME AT LAUNCH</span>
            <span class="waitlist-btn-arrow">→</span>
          </button>
        </form>
        {/* Turnstile script — async/defer so it doesn't block hero LCP.
            Loaded scoped to Cloud (below-the-fold) rather than the
            global Layout; Turnstile is only needed for the waitlist
            form on /, not on /privacy or /404. */}
        <script
          src="https://challenges.cloudflare.com/turnstile/v0/api.js"
          async
          defer
        ></script>

        <div
          id="waitlist-banner"
          role="status"
          aria-live="polite"
          class="waitlist-banner"
        ></div>

        <p class="waitlist-foot">// limited slots before PRO opens</p>
      </div>

    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const form = document.getElementById('waitlist-form');
    const banner = document.getElementById('waitlist-banner');
    const input = form && form.querySelector('input[type="email"]');
    const button = form && form.querySelector('button[type="submit"]');
    const honeypot = form && form.querySelector('input[name="company"]');
    if (!form || !banner || !input || !button) return;

    // Form-render timestamp — server compares against submission time
    // to reject sub-1.5s submits. Humans need >1.5s to focus + type +
    // click; bots usually fire under 300ms.
    //
    // Reset the clock on first user interaction (focus/input/keydown
    // on the email field). Without this, returning users with browser
    // autofill saved would land on the page, the form auto-populates
    // instantly, they click submit ~500ms after load — silent reject,
    // never reach D1. By restarting the clock at first-interaction,
    // autofill users get the full 1.5s budget from when they actually
    // engage with the form, while programmatic-submit bots that never
    // dispatch a real user event still hit the original timer.
    let renderedAt = Date.now();
    let armed = false;
    const armOnInteraction = () => {
      if (armed) return;
      armed = true;
      renderedAt = Date.now();
    };
    // Listen at the FORM level (not just the email input) — Chrome
    // and Safari native autofill on page load does NOT fire `input`
    // on the email field until the user interacts. A returning user
    // with saved autofill who clicks submit directly never focuses
    // the email input, so an input-only listener would miss them and
    // they'd still get silent-rejected by the <1.5s gate.
    //
    // `focusin` bubbles (unlike `focus`), so it catches focus on any
    // descendant — submit button focus on click counts. `pointerdown`
    // covers tap/click anywhere in the form before submit fires.
    // Shared `armed` flag means whichever event lands first re-arms,
    // subsequent ones short-circuit.
    form.addEventListener('focusin', armOnInteraction, { passive: true });
    form.addEventListener('pointerdown', armOnInteraction, { passive: true });
    form.addEventListener('keydown', armOnInteraction, { passive: true });

    // Turnstile callbacks (set on the global window so the widget's
    // data-callback attributes can find them). Token cache avoids a
    // race where invisible-mode validation hasn't completed when the
    // user submits — submit handler reads the latest cached token.
    let turnstileToken = '';
    window.onObTurnstileToken = function (t) { turnstileToken = t || ''; };
    window.onObTurnstileExpired = function () { turnstileToken = ''; };

    function showBanner(state, message) {
      banner.dataset.state = state;
      banner.textContent = message;
      banner.classList.add('show');
      // Pair the input with the banner for AT: success clears the
      // invalid state, any non-success state marks the field invalid
      // so SR users hear "invalid entry" on the field itself instead
      // of needing to navigate to the banner separately.
      if (state === 'success') {
        input.removeAttribute('aria-invalid');
      } else {
        input.setAttribute('aria-invalid', 'true');
      }
      banner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = input.value.trim();
      if (!email) return;

      button.disabled = true;
      const labelEl = button.querySelector('span');
      if (labelEl) labelEl.textContent = 'SENDING_';

      // If the widget hasn't produced a token yet (script still
      // loading on a slow network, OR the widget is mid-validation),
      // give it a short window before submitting. Unconditional —
      // gating on `window.turnstile` would skip this wait for users
      // whose script load is just slow, leaving them with an empty
      // token and a server-side silent-reject. 800ms is enough for
      // most slow connections to finish loading + validating; users
      // who never get a token (Turnstile blocked by ad-blocker,
      // upstream down) fall through to server-side reject which is
      // still the same silent-success UX.
      if (!turnstileToken) {
        await new Promise((resolve) => setTimeout(resolve, 800));
      }

      try {
        const res = await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            // Anti-spam signals. Honeypot value is normally '' for
            // humans; t is ms elapsed from form render to submit.
            // Server treats all three (company / t / cf-turnstile-response)
            // as silent-accept-on-tamper — we don't surface the
            // rejection signal to the bot.
            company: honeypot ? honeypot.value : '',
            t: Date.now() - renderedAt,
            'cf-turnstile-response': turnstileToken,
          }),
        });
        let data;
        try {
          data = await res.json();
        } catch (parseErr) {
          console.error('[waitlist] response not JSON:', res.status, parseErr);
          data = {};
        }
        if (res.ok && data.ok) {
          showBanner('success', '✓ Got it. You\'re on the list — we\'ll ping you at launch.');
          form.reset();
        } else if (data.error === 'invalid_email') {
          showBanner('error', '✗ That email looks off. Try again.');
        } else if (data.error === 'rate_limited' || res.status === 429) {
          showBanner('error', '✗ Too many attempts. Wait a few minutes and try again.');
        } else if (data.error === 'server_misconfigured' || res.status === 503) {
          showBanner('error', '✗ Waitlist is temporarily offline. Please try again later.');
        } else {
          console.error('[waitlist] submission failed:', res.status, data);
          showBanner('error', '✗ Something went wrong. Try again in a moment.');
        }
      } catch (err) {
        console.error('[waitlist] network error:', err);
        showBanner('error', '✗ Network error. Try again.');
      } finally {
        button.disabled = false;
        if (labelEl) labelEl.textContent = 'NOTIFY ME AT LAUNCH';
      }
    });
  })();
</script>

<style>
  /* Vertical card style: 3 tiers laid out side-by-side, each card
     orientates vertically (meta + name → desc → status). On mobile
     they stack to a single column. */
  .tiers {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .tiers { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .tier-card {
    padding: 1.25rem 1.25rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-decoration: none;
    color: inherit;
    min-height: 170px;
    position: relative;
  }
  .tier-card .cyber-card-meta {
    position: absolute;
    top: 0.85rem;
    right: 1rem;
  }
  .tier-card .cyber-card-desc { margin-top: 0; }
  .tier-name {
    letter-spacing: 0.08em;
    font-size: 1.05rem;
    margin: 0;
  }
  /* Small accent-tinted tagline that sits under the tier name —
     reserved for messaging that needs to land before the dense
     desc line (e.g. FREE's "always free & open source" promise). */
  .tier-tagline {
    display: block;
    margin-top: -2px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--section-accent);
  }
  .tier-status {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.3em;
    color: var(--section-accent);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-top: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  /* ── FREE: live, clickable, brand-glow border ── */
  a.tier-card.tier-card-live {
    position: relative;
    cursor: pointer;
    border-color: color-mix(in srgb, var(--section-accent) 55%, transparent);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--section-accent) 25%, transparent),
      0 0 30px -8px color-mix(in srgb, var(--section-accent) 60%, transparent);
    /* Animate transform + border-color only — the 50px-spread box-shadow
       on hover is a Safari paint hot path; switch it as a static :hover
       value so the transition doesn't repaint the whole card every frame. */
    transition: border-color 0.25s ease, transform 0.25s ease;
  }
  a.tier-card.tier-card-live::before {
    /* Left edge accent rail — same vocabulary as the hero cmd-box. */
    content: '';
    position: absolute;
    top: -1px;
    bottom: -1px;
    left: -1px;
    width: 3px;
    background: var(--section-accent);
    box-shadow: 0 0 12px var(--section-accent);
  }
  a.tier-card.tier-card-live:hover {
    transform: translateY(-2px);
    border-color: var(--section-accent);
    box-shadow:
      0 0 0 1px var(--section-accent),
      0 0 50px -6px color-mix(in srgb, var(--section-accent) 75%, transparent);
  }
  a.tier-card.tier-card-live .tier-name {
    color: #fff;
  }
  .tier-status-dot {
    width: 6px;
    height: 6px;
    background: var(--section-accent);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--section-accent);
    animation: cyber-pulse 1.5s ease-in-out infinite;
  }
  .tier-arrow {
    color: var(--section-accent);
    transition: transform 0.25s ease;
    margin-left: 4px;
  }
  a.tier-card.tier-card-live:hover .tier-arrow { transform: translateX(4px); }

  /* ── PRO / TEAM: dimmed, "coming soon" ── */
  .tier-card.tier-card-soon {
    opacity: 0.55;
    cursor: default;
  }
  .tier-card.tier-card-soon .tier-status {
    color: var(--section-accent);
    letter-spacing: 0.32em;
    animation: tier-soon-blink 2.4s ease-in-out infinite;
  }
  .tier-card.tier-card-soon .cyber-card-desc {
    color: rgba(255, 255, 255, 0.32);
  }
  /* Stagger TEAM relative to PRO so they pulse out of sync — feels like
     two independent "incoming" signals rather than one synchronized banner. */
  .tier-card.tier-card-soon:nth-of-type(3) .tier-status {
    animation-delay: 1.2s;
  }
  @keyframes tier-soon-blink {
    0%, 100% { opacity: 1; }
    48%      { opacity: 0.25; }
    52%      { opacity: 0.25; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tier-card.tier-card-soon .tier-status { animation: none; }
    .tier-status-dot { animation: none; }
    .waitlist-rec-dot { animation: none; }
  }

  /* Waitlist console */
  .waitlist-shell {
    position: relative;
    padding: 2rem 2rem 1.6rem;
    background: rgba(8, 8, 14, 0.82);
    border: 1px solid color-mix(in srgb, var(--section-accent) 22%, transparent);
    /* drop heavy backdrop-filter — solid bg keeps the look, frees the compositor */

    /* Bottom-align with the tier card row on the left column.
       The grid uses items-stretch so this column's track height matches
       the headline + tier row; align-self: end pushes the card to the
       bottom of that track so its lower edge lines up with the tier
       cards instead of floating mid-column. */
    align-self: end;
  }
  .waitlist-frame {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1px solid var(--section-accent);
  }
  .waitlist-frame-tl { top: -3px;    left: -3px;    border-right: 0; border-bottom: 0; }
  .waitlist-frame-tr { top: -3px;    right: -3px;   border-left: 0;  border-bottom: 0; }
  .waitlist-frame-bl { bottom: -3px; left: -3px;    border-right: 0; border-top: 0; }
  .waitlist-frame-br { bottom: -3px; right: -3px;   border-left: 0;  border-top: 0; }

  .waitlist-head {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.3em;
    color: var(--section-accent);
    text-transform: uppercase;
    margin-bottom: 1.4rem;
  }
  .waitlist-rec-dot {
    width: 6px;
    height: 6px;
    background: var(--section-accent);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--section-accent);
    animation: cyber-pulse 1.5s ease-in-out infinite;
  }

  /* Social proof — compact one-line strip between waitlist head and
     title. GitHub star count + "built by" attribution. Same mono
     vocabulary as the rest of the console, dim by default so it
     doesn't compete with the H3. */
  .waitlist-proof {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 14px;
    margin: -0.4rem 0 1.4rem;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.45);
    text-transform: uppercase;
  }
  .waitlist-proof a {
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .waitlist-proof a:hover { color: var(--section-accent); }
  .waitlist-proof-stars {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .waitlist-proof-stars svg {
    color: var(--section-accent);
    flex-shrink: 0;
    transform: translateY(-1px);
  }
  .waitlist-proof-num {
    color: #fff;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .waitlist-proof-tag { letter-spacing: 0.22em; }
  .waitlist-proof-sep { color: rgba(255, 255, 255, 0.18); }
  .waitlist-proof-built a {
    color: var(--section-accent);
    border-bottom: 1px dotted color-mix(in srgb, var(--section-accent) 40%, transparent);
  }
  .waitlist-proof-built a:hover {
    color: #fff;
    border-bottom-color: rgba(255, 255, 255, 0.5);
  }

  .waitlist-title {
    margin: 0 0 0.7rem;
    /* Match site H2 vocabulary — Chakra Petch italic, just smaller. */
    font-family: 'Chakra Petch', var(--font-display), sans-serif;
    font-style: italic;
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.25;
    color: #fff;
    letter-spacing: -0.01em;
    text-transform: none;
  }
  .waitlist-title strong {
    color: var(--section-accent);
    font-weight: 700;
  }
  .waitlist-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  /* Honeypot — visually hidden but in the DOM so naive bots fill it.
     Pure off-screen positioning is intentional: avoid `display:none`,
     `visibility:hidden`, `opacity:0`, and `pointer-events:none` —
     modern headless tooling explicitly skips fields with those signals.
     Keyboard skip is handled by `tabindex="-1"` on the input; AT skip
     by `aria-hidden` on the wrapper. */
  .waitlist-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .waitlist-label {
    display: block;
    font-family: var(--font-mono);
  }
  .waitlist-label > span {
    display: block;
    font-size: 9px;
    letter-spacing: 0.4em;
    color: rgba(255, 255, 255, 0.35);
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .waitlist-input {
    width: 100%;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 14px 16px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: #fff;
    letter-spacing: 0.02em;
    transition: border-color 0.25s ease;
  }
  .waitlist-input:focus-visible {
    outline: 2px solid var(--section-accent);
    outline-offset: 2px;
    border-color: var(--section-accent);
  }
  .waitlist-input:focus:not(:focus-visible) {
    outline: none;
    border-color: var(--section-accent);
  }
  .waitlist-input::placeholder { color: rgba(255, 255, 255, 0.22); }

  /* Matches Hero's btn-cyber-primary so the waitlist CTA reads as the
     same button family — clip-path bevels, mono caps, accent fill on
     dark text, white-flip on hover. align-self:flex-start drops the
