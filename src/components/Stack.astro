---
// 4-layer architecture diagram. Structure mirrors the README
// harness-os-stack, but the website uses a Pantone-style monochrome
// cyan palette tuned to the section accent (#00f3ff) — diverges from
// the README's per-layer hue palette intentionally so the diagram
// reads as part of the dark cyber theme, not a separate UI module.
---

<section id="stack" class="cyber-section reveal" style="--section-accent: #00f3ff;">
  <div class="cyber-section-orb" aria-hidden="true"></div>
  <div class="cyber-section-grid" aria-hidden="true"></div>

  <div class="cyber-section-shell">
    <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- LEFT: Headline + manifesto -->
      <header>
        <div class="cyber-pill">
          <span class="cyber-pill-dot"></span>
          <span>ONEBRAIN // HARNESS_OS</span>
        </div>
        <h2 class="cyber-h2">
          Multi-Harness<br/>
          <span class="cyber-h2-stroke">Orchestration.</span>
        </h2>
        <p class="cyber-sub">
          <strong class="brand">OneBrain</strong> doesn't build harnesses — it orchestrates them. Bring Claude Code, Gemini CLI, Codex, Qwen — or a raw API key — and switch any time. Your vault stays the constant; the harness is the variable.
        </p>

        <div class="manifesto">
          <div class="manifesto-row">
            <span class="manifesto-tag">PICK_BY</span>
            <span class="manifesto-text"><strong>familiarity</strong> — use the harness you already love</span>
          </div>
          <div class="manifesto-row">
            <span class="manifesto-tag">PICK_BY</span>
            <span class="manifesto-text"><strong>task</strong> — research with one, code with another</span>
          </div>
          <div class="manifesto-row">
            <span class="manifesto-tag">PICK_BY</span>
            <span class="manifesto-text"><strong>cost</strong> — local LLM for routine, premium API for the hard problems</span>
          </div>
          <div class="manifesto-row manifesto-row-emph">
            <span class="manifesto-tag manifesto-tag-emph">RESULT</span>
            <span class="manifesto-text"><strong>context never breaks</strong> when you switch</span>
          </div>
        </div>
      </header>

      <!-- RIGHT: 4-layer architecture diagram (synced from README) -->
      <figure class="harness-stack">
        <span class="hs-corner hs-corner-tl" aria-hidden="true"></span>
        <span class="hs-corner hs-corner-tr" aria-hidden="true"></span>
        <span class="hs-corner hs-corner-bl" aria-hidden="true"></span>
        <span class="hs-corner hs-corner-br" aria-hidden="true"></span>

        <div class="hs-band" aria-hidden="true">
          <span class="hs-band-dot"></span>
          <span class="hs-band-label">HARNESS_OS_STACK · 4_LAYERS</span>
          <span class="hs-band-meta">RUNS_LOCAL</span>
        </div>

        <img
          src="/diagrams/harness-os-stack.svg"
          alt="OneBrain Harness OS — four stacked layers from top to bottom: OneBrain plugin and CLI (OS layer), Harness runtime, LLM intelligence source, and Obsidian Vault as the foundation."
          class="hs-svg"
          width="880"
          height="585"
          loading="lazy"
          decoding="async"
        />

        <div class="hs-foot" aria-hidden="true">
          <span class="hs-foot-mute">BYO_HARNESS · VAULT_STAYS_CONSTANT</span>
        </div>
      </figure>

    </div>
  </div>
</section>

<style>
  /* Section-scoped sizing — match the 4rem cap used by other diagram
     sections so headlines render at a consistent maximum across cyber-h2. */
  #stack .cyber-h2 { font-size: clamp(2rem, 4.4vw, 4rem); }

  /* Manifesto rows (left column) */
  .manifesto {
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .manifesto-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 7px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.5;
  }
  .manifesto-row:first-child { border-top: 0; }
  .manifesto-tag {
    font-size: 9px;
    letter-spacing: 0.3em;
    color: rgba(255, 255, 255, 0.45);
    flex-shrink: 0;
    width: 60px;
    text-transform: uppercase;
  }
  .manifesto-tag-emph { color: var(--section-accent); }
  .manifesto-text { color: rgba(255, 255, 255, 0.7); }
  .manifesto-text strong { color: #fff; font-weight: 600; }
  .manifesto-row-emph {
    margin-top: 4px;
    padding-top: 10px;
    border-top: 1px solid rgba(0, 243, 255, 0.18);
  }

  /* Harness stack frame (right column) — corner brackets + band header
     + foot caption wrap the synced SVG, mirroring the HowItWorks loop
     diagram so the two cyber-frames feel like a matched pair. */
  .harness-stack {
    position: relative;
    margin: 0;
    display: flex;
    flex-direction: column;
    padding: 14px 14px 12px;
    background: rgba(8, 8, 14, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .hs-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1px solid var(--section-accent);
  }
  .hs-corner-tl { top: -1px;    left: -1px;    border-right: 0; border-bottom: 0; }
  .hs-corner-tr { top: -1px;    right: -1px;   border-left: 0;  border-bottom: 0; }
  .hs-corner-bl { bottom: -1px; left: -1px;    border-right: 0; border-top: 0; }
  .hs-corner-br { bottom: -1px; right: -1px;   border-left: 0;  border-top: 0; }

  .hs-band {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 4px 8px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.28em;
    color: rgba(255, 255, 255, 0.45);
    text-transform: uppercase;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    margin-bottom: 6px;
  }
  .hs-band-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--section-accent);
    box-shadow: 0 0 10px var(--section-accent);
    flex-shrink: 0;
    animation: hs-band-pulse 2.4s ease-in-out infinite;
  }
  @keyframes hs-band-pulse {
    0%, 100% { opacity: 1;   transform: scale(1);    }
    50%      { opacity: 0.4; transform: scale(0.85); }
  }
  .hs-band-meta { margin-left: auto; }

  .hs-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .hs-foot {
    margin-top: 6px;
    padding: 8px 4px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.28em;
    color: rgba(255, 255, 255, 0.35);
    text-transform: uppercase;
    text-align: right;
  }

  /* Mobile — hide band meta/foot caption + trim manifesto to 2 rows so the
     diagram and manifesto stay balanced when the layout stacks vertically. */
  @media (max-width: 720px) {
    .hs-band-meta,
    .hs-foot { display: none; }
    .harness-stack { padding: 12px 10px 10px; }
    .manifesto-tag { width: 48px; font-size: 8px; }
    .manifesto-row:nth-child(1),
    .manifesto-row:nth-child(3) { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hs-band-dot { animation: none; }
  }

  /* Tighten section padding at desktop so the diagram + manifesto fit
     comfortably below the nav even on 700–800px laptop viewports. */
  @media (min-width: 1024px) {
    #stack { padding: 2.25rem 3rem 1.75rem; }
  }
</style>
