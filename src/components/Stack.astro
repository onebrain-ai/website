---
const layers = [
  {
    idx: '01',
    name: 'OBSIDIAN VAULT',
    role: 'COGNITIVE_INTERFACE',
    desc: 'Plain Markdown — your single source of truth.',
    sub: 'Notes · memory · decisions · knowledge graph',
    tag: 'USER_FACING',
    accent: '#00f3ff',
  },
  {
    idx: '02',
    name: 'ONEBRAIN PLUGIN',
    role: 'SKILLS_AND_HOOKS',
    desc: '24+ skills + lifecycle hooks. Loaded into any harness.',
    sub: 'braindump · capture · research · distill · doctor · ...',
    tag: 'BEHAVIOR_DEF',
    accent: '#ff2d92',
  },
  {
    idx: '03',
    name: 'ONEBRAIN CLI',
    role: 'HARNESS_ORCHESTRATOR',
    desc: 'Vault sync · indexing · checkpoints · routing.',
    sub: 'The OS layer that keeps every harness on the same page.',
    tag: 'CONTEXT_BRIDGE',
    accent: '#ffb000',
  },
  {
    idx: '04',
    name: 'HARNESS',
    role: 'AGENTIC_RUNTIME',
    desc: 'Bring your own. Pick by task, by skill, by cost.',
    sub: 'claude code · gemini cli · codex · qwen · cursor · ...',
    tag: 'BYO_HARNESS',
    accent: '#bc13fe',
  },
  {
    idx: '05',
    name: 'LLM',
    role: 'INTELLIGENCE_SOURCE',
    desc: 'Whatever powers the harness — OneBrain stays consistent.',
    sub: 'local (mlx · ollama) · cloud (claude · gemini · gpt) · raw api',
    tag: 'RAW_TOKENS',
    accent: '#c8ff00',
  },
];
---

<section id="stack" class="cyber-section reveal" style="--section-accent: #00f3ff;">
  <div class="cyber-section-orb" aria-hidden="true"></div>
  <div class="cyber-section-grid" aria-hidden="true"></div>

  <div class="cyber-section-shell">
    <div class="grid lg:grid-cols-[0.85fr_1.15fr] gap-12 lg:gap-16 items-center">

      <!-- LEFT: Headline + manifesto -->
      <header>
        <div class="cyber-pill">
          <span class="cyber-pill-dot"></span>
          <span>ONEBRAIN // HARNESS_OS</span>
        </div>
        <h2 class="cyber-h2">
          Multi-Harness<br/>
          <span class="cyber-h2-stroke">Orchestration.</span>
        </h2>
        <p class="cyber-sub">
          We don't build a harness. We orchestrate them. Bring Claude Code, Gemini CLI, Codex, Qwen — or a raw API key — and switch any time. Your vault is the constant; the harness is the variable.
        </p>

        <div class="manifesto">
          <div class="manifesto-row">
            <span class="manifesto-tag">PICK_BY</span>
            <span class="manifesto-text"><strong>familiarity</strong> — use the harness you already love</span>
          </div>
          <div class="manifesto-row">
            <span class="manifesto-tag">PICK_BY</span>
            <span class="manifesto-text"><strong>task</strong> — research with one, code with another</span>
          </div>
          <div class="manifesto-row">
            <span class="manifesto-tag">PICK_BY</span>
            <span class="manifesto-text"><strong>cost</strong> — local LLM for routine, premium API for the hard problems</span>
          </div>
          <div class="manifesto-row manifesto-row-emph">
            <span class="manifesto-tag manifesto-tag-emph">RESULT</span>
            <span class="manifesto-text"><strong>context never breaks</strong> when you switch</span>
          </div>
        </div>
      </header>

      <!-- RIGHT: Animated 5-layer architecture diagram -->
      <div class="harness-stack" role="img" aria-label="Five-layer architecture: Obsidian Vault, OneBrain Plugin, OneBrain CLI, Harness, LLM — top to bottom.">
        <span class="hs-corner hs-corner-tl" aria-hidden="true"></span>
        <span class="hs-corner hs-corner-tr" aria-hidden="true"></span>
        <span class="hs-corner hs-corner-bl" aria-hidden="true"></span>
        <span class="hs-corner hs-corner-br" aria-hidden="true"></span>

        <div class="hs-band hs-band-top" aria-hidden="true">
          <span class="hs-band-dot"></span>
          <span class="hs-band-label">HARNESS_OS_STACK · ↑ INTERFACE</span>
          <span class="hs-band-meta">ARCH_v1.0 · 05_LAYERS</span>
        </div>

        <div class="hs-layers">
          <div class="hs-spine" aria-hidden="true">
            <span class="hs-particle hs-particle-down" style="animation-delay: 0s;"></span>
            <span class="hs-particle hs-particle-down" style="animation-delay: 1.4s;"></span>
            <span class="hs-particle hs-particle-down" style="animation-delay: 2.8s;"></span>
            <span class="hs-particle hs-particle-up" style="animation-delay: 0.7s;"></span>
            <span class="hs-particle hs-particle-up" style="animation-delay: 2.1s;"></span>
          </div>

          {layers.map((l, i) => (
            <div
              class="hs-layer"
              style={`--layer-accent: ${l.accent}; --layer-delay: ${i * 0.08}s;`}
            >
              <span class="hs-stripe" aria-hidden="true"></span>
              <span class="hs-edge hs-edge-tl" aria-hidden="true"></span>
              <span class="hs-edge hs-edge-br" aria-hidden="true"></span>

              <div class="hs-layer-left">
                <div class="hs-layer-idx">LAYER_{l.idx}</div>
                <div class="hs-layer-name">{l.name}</div>
                <div class="hs-layer-role">{l.role}</div>
              </div>

              <div class="hs-layer-mid">
                <div class="hs-layer-desc">{l.desc}</div>
                <div class="hs-layer-sub">{l.sub}</div>
              </div>

              <div class="hs-layer-right">
                <span class="hs-chip">{l.tag}</span>
              </div>
            </div>
          ))}
        </div>

        <div class="hs-band hs-band-bottom" aria-hidden="true">
          <span class="hs-band-meta-mute">↓ INTELLIGENCE</span>
          <span class="hs-band-meta-mute">CONTEXT_FLOWS_BOTH_WAYS · VAULT_AGNOSTIC</span>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Manifesto rows (left column) */
  .manifesto {
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .manifesto-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 7px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.5;
  }
  .manifesto-row:first-child { border-top: 0; }
  .manifesto-tag {
    font-size: 9px;
    letter-spacing: 0.3em;
    color: rgba(255, 255, 255, 0.45);
    flex-shrink: 0;
    width: 60px;
    text-transform: uppercase;
  }
  .manifesto-tag-emph { color: var(--section-accent); }
  .manifesto-text { color: rgba(255, 255, 255, 0.7); }
  .manifesto-text strong { color: #fff; font-weight: 600; }
  .manifesto-row-emph {
    margin-top: 4px;
    padding-top: 10px;
    border-top: 1px solid rgba(0, 243, 255, 0.18);
  }

  /* Harness stack diagram (right column) */
  .harness-stack {
    position: relative;
    padding: 16px 14px 14px;
    background: rgba(8, 8, 14, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .hs-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1px solid rgba(255, 255, 255, 0.35);
  }
  .hs-corner-tl { top: -1px;    left: -1px;    border-right: 0; border-bottom: 0; }
  .hs-corner-tr { top: -1px;    right: -1px;   border-left: 0;  border-bottom: 0; }
  .hs-corner-bl { bottom: -1px; left: -1px;    border-right: 0; border-top: 0; }
  .hs-corner-br { bottom: -1px; right: -1px;   border-left: 0;  border-top: 0; }

  .hs-band {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 4px 8px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.28em;
    color: rgba(255, 255, 255, 0.45);
    text-transform: uppercase;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .hs-band-top { margin-bottom: 8px; }
  .hs-band-bottom {
    border-bottom: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding: 8px 4px 0;
    margin-top: 8px;
    justify-content: space-between;
  }
  .hs-band-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--section-accent);
    box-shadow: 0 0 10px var(--section-accent);
    flex-shrink: 0;
    animation: hs-band-pulse 2.4s ease-in-out infinite;
  }
  @keyframes hs-band-pulse {
    0%, 100% { opacity: 1;   transform: scale(1);    }
    50%      { opacity: 0.4; transform: scale(0.85); }
  }
  .hs-band-meta { margin-left: auto; }
  .hs-band-meta-mute { color: rgba(255, 255, 255, 0.35); }

  .hs-layers {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* Animated spine (vertical with travelling particles) */
  .hs-spine {
    position: absolute;
    left: 14px;
    top: 0;
    bottom: 0;
    width: 2px;
    pointer-events: none;
    background: linear-gradient(180deg,
      rgba(0, 243, 255, 0.5) 0%,
      rgba(255, 45, 146, 0.5) 25%,
      rgba(255, 176, 0, 0.5) 50%,
      rgba(188, 19, 254, 0.5) 75%,
      rgba(200, 255, 0, 0.5) 100%);
    mask-image: repeating-linear-gradient(180deg, #000 0 4px, transparent 4px 9px);
    -webkit-mask-image: repeating-linear-gradient(180deg, #000 0 4px, transparent 4px 9px);
  }
  .hs-particle {
    position: absolute;
    left: -2px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.9), 0 0 18px rgba(0, 243, 255, 0.6);
  }
  .hs-particle-down { animation: hs-travel-down 4.2s linear infinite; }
  .hs-particle-up   { animation: hs-travel-up   5.6s linear infinite; }
  @keyframes hs-travel-down {
    0%   { top: -2%;  opacity: 0;   }
    8%   {           opacity: 0.95; }
    92%  {           opacity: 0.95; }
    100% { top: 102%; opacity: 0;   }
  }
  @keyframes hs-travel-up {
    0%   { top: 102%; opacity: 0;   }
    8%   {           opacity: 0.85; }
    92%  {           opacity: 0.85; }
    100% { top: -2%;  opacity: 0;   }
  }

  /* Layer block */
  .hs-layer {
    position: relative;
    display: grid;
    grid-template-columns: 158px 1fr auto;
    gap: 14px;
    padding: 9px 14px 9px 30px;
    background: linear-gradient(180deg, rgba(12, 12, 24, 0.92), rgba(6, 6, 13, 0.92));
    border: 1px solid color-mix(in srgb, var(--layer-accent) 35%, transparent);
    align-items: center;
    overflow: hidden;
    transition: transform 0.35s ease, border-color 0.35s ease, background 0.35s ease, box-shadow 0.35s ease;
    transform: translateX(20px);
    opacity: 0;
  }
  .cyber-section.active .hs-layer {
    animation: hs-layer-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--layer-delay);
  }
  @keyframes hs-layer-in {
    to { transform: translateX(0); opacity: 1; }
  }

  .hs-stripe {
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: linear-gradient(90deg,
      var(--layer-accent) 0%,
      color-mix(in srgb, var(--layer-accent) 40%, transparent) 60%,
      transparent 100%);
    box-shadow: 0 0 12px color-mix(in srgb, var(--layer-accent) 75%, transparent);
  }
  .hs-stripe::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.85) 50%, transparent 100%);
    transform: translateX(-100%);
    animation: hs-stripe-sweep 6.5s ease-in-out infinite;
    animation-delay: var(--layer-delay);
  }
  @keyframes hs-stripe-sweep {
    0%, 70%, 100% { transform: translateX(-100%); }
    85%           { transform: translateX(100%);  }
  }

  .hs-edge {
    position: absolute;
    width: 8px;
    height: 8px;
    border: 1px solid var(--layer-accent);
  }
  .hs-edge-tl { top: 0;    left: 0;    border-right: 0; border-bottom: 0; }
  .hs-edge-br { bottom: 0; right: 0;   border-left: 0;  border-top: 0; }

  .hs-layer:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--layer-accent) 75%, transparent);
    background: linear-gradient(180deg,
      color-mix(in srgb, var(--layer-accent) 8%, rgba(12, 12, 24, 0.92)),
      rgba(6, 6, 13, 0.92));
    box-shadow:
      0 0 24px color-mix(in srgb, var(--layer-accent) 22%, transparent),
      inset 0 0 0 1px color-mix(in srgb, var(--layer-accent) 30%, transparent);
  }

  .hs-layer-idx {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    color: var(--layer-accent);
    letter-spacing: 0.1em;
    margin-bottom: 2px;
  }
  .hs-layer-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-style: italic;
    font-size: 0.95rem;
    color: #fff;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.05;
  }
  .hs-layer-role {
    margin-top: 3px;
    font-family: var(--font-mono);
    font-size: 8.5px;
    letter-spacing: 0.26em;
    color: var(--layer-accent);
    text-transform: uppercase;
  }
  .hs-layer-desc {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.78);
  }
  .hs-layer-sub {
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.45);
  }
  .hs-chip {
    display: inline-block;
    padding: 3px 8px;
    font-family: var(--font-mono);
    font-size: 8.5px;
    letter-spacing: 0.18em;
    color: var(--layer-accent);
    background: color-mix(in srgb, var(--layer-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--layer-accent) 40%, transparent);
  }

  /* Tablet — drop the right chip column to give middle column more room */
  @media (max-width: 1024px) {
    .hs-layer { grid-template-columns: 150px 1fr; }
    .hs-layer-right { display: none; }
  }

  /* Mobile — collapse to single column inside layer */
  @media (max-width: 720px) {
    .harness-stack { padding: 14px 12px 12px; }
    .hs-layer {
      grid-template-columns: 1fr;
      gap: 6px;
      padding: 10px 14px 10px 26px;
    }
    .hs-band-meta-mute:last-child { display: none; }
    .hs-band-bottom { justify-content: flex-start; }
    .manifesto-tag { width: 48px; font-size: 8px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hs-band-dot,
    .hs-particle,
    .hs-stripe::after { animation: none; }
    .hs-particle { display: none; }
  }

  /* Tighten section padding at desktop so the diagram + manifesto fit
     comfortably below the nav even on 700–800px laptop viewports. */
  @media (min-width: 1024px) {
    #stack { padding: 2.25rem 3rem 1.75rem; }
  }
</style>
