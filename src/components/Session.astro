---
// 3-step session loop: CAPTURE → EVOLVE → WRAPUP, then back to
// CAPTURE. Each cycle the vault grows and the agent learns more
// about you — both sides sharpen. (Install + /onboarding is a
// one-time bootstrap and lives in the Hero install line, not here.)
const steps = [
  {
    n: '01',
    t: 'CAPTURE',
    d: 'Talk to the agent in natural language. It writes, classifies, and links your thoughts in real time.',
    code: '/braindump · /capture · /bookmark',
  },
  {
    n: '02',
    t: 'EVOLVE',
    d: '/research and /distill expand your knowledge. /learn deepens the agent. The loop tightens.',
    code: '/research · /distill · /learn',
  },
  {
    n: '03',
    t: 'WRAPUP',
    d: '/wrapup consolidates the session log. /recap promotes lessons to memory.',
    code: '/wrapup · /recap',
  },
];
---

<section id="session" class="cyber-section reveal" style="--section-accent: #c8ff00;">
  <div class="cyber-section-orb" aria-hidden="true"></div>
  <div class="cyber-section-grid" aria-hidden="true"></div>

  <div class="cyber-section-shell">
    <div class="grid md:grid-cols-2 gap-10 lg:gap-16 items-center how-grid">

      <!-- LEFT: header + step list -->
      <div class="how-left">
        <header class="cyber-section-head">
          <div class="cyber-pill">
            <span class="cyber-pill-dot"></span>
            <span>ONEBRAIN // SESSION</span>
          </div>
          <h2 class="cyber-h2">
            Every Session<br/>
            <span class="cyber-h2-stroke">Sharpens Both.</span>
          </h2>
          <p class="cyber-sub">
            <strong class="brand">OneBrain</strong> runs as a tight 3-step loop. Each cycle feeds the next: the agent gets smarter and the vault gets richer, every round.
          </p>
        </header>

        <ol class="how-steps">
          {steps.map((s) => (
            <li class="how-step">
              <span class="how-step-num">{s.n}</span>
              <div class="how-step-body">
                <h3 class="how-step-title">{s.t}</h3>
                {s.d && <p class="how-step-desc">{s.d}</p>}
                <code class="how-step-code">{s.code}</code>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <!-- RIGHT: triangle loop diagram (synced from README coevo-loop) -->
      <figure class="how-loop">
        <span class="how-loop-corner how-loop-corner-tl" aria-hidden="true"></span>
        <span class="how-loop-corner how-loop-corner-tr" aria-hidden="true"></span>
        <span class="how-loop-corner how-loop-corner-bl" aria-hidden="true"></span>
        <span class="how-loop-corner how-loop-corner-br" aria-hidden="true"></span>

        <div class="how-loop-band" aria-hidden="true">
          <span class="how-loop-band-dot"></span>
          <span class="how-loop-band-label">CO_EVOLUTION_LOOP · CW</span>
          <span class="how-loop-band-meta">RUNS_FOREVER</span>
        </div>

        <img
          src="/diagrams/coevo-loop.svg"
          alt="Three-step session loop: 01 CAPTURE at top, 02 EVOLVE at bottom-right, 03 WRAPUP at bottom-left, with curved arrows flowing clockwise."
          class="how-loop-svg"
          width="450"
          height="395"
          loading="lazy"
          decoding="async"
        />

        <div class="how-loop-foot" aria-hidden="true">
          <span class="how-loop-foot-mute">EVERY_CYCLE_TIGHTENS · BOTH_SIDES_SHARPEN</span>
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  /* Step list (left column) */
  .how-steps {
    margin-top: 0.75rem;
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .how-step {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 12px;
    padding: 9px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    align-items: flex-start;
  }
  .how-step:first-child { border-top: 0; padding-top: 4px; }
  .how-step-num {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: 1.9rem;
    line-height: 1;
    color: var(--section-accent);
    opacity: 0.85;
    text-shadow: 0 0 24px color-mix(in srgb, var(--section-accent) 45%, transparent);
  }
  .how-step-title {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 4px;
  }
  .how-step-desc {
    margin: 0 0 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.62);
  }
  .how-step-code {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    color: var(--section-accent);
    opacity: 0.85;
  }

  /* ── Loop diagram (right) ─────────────────────────────── */
  .how-loop {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 14px 14px 12px;
    background: rgba(8, 8, 14, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .how-loop-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1px solid var(--section-accent);
  }
  .how-loop-corner-tl { top: -1px;    left: -1px;    border-right: 0; border-bottom: 0; }
  .how-loop-corner-tr { top: -1px;    right: -1px;   border-left: 0;  border-bottom: 0; }
  .how-loop-corner-bl { bottom: -1px; left: -1px;    border-right: 0; border-top: 0; }
  .how-loop-corner-br { bottom: -1px; right: -1px;   border-left: 0;  border-top: 0; }

  .how-loop-band {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 4px 8px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.28em;
    color: rgba(255, 255, 255, 0.45);
    text-transform: uppercase;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    margin-bottom: 6px;
  }
  .how-loop-band-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--section-accent);
    box-shadow: 0 0 10px var(--section-accent);
    flex-shrink: 0;
    animation: how-band-pulse 2.4s ease-in-out infinite;
  }
  @keyframes how-band-pulse {
    0%, 100% { opacity: 1;   transform: scale(1);    }
    50%      { opacity: 0.4; transform: scale(0.85); }
  }
  .how-loop-band-meta { margin-left: auto; }

  .how-loop-svg {
    display: block;
    width: 100%;
    max-width: 440px;
    height: auto;
    margin: 0 auto;
  }

  .how-loop-foot {
    margin-top: 6px;
    padding: 8px 4px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.28em;
    color: rgba(255, 255, 255, 0.35);
    text-transform: uppercase;
    text-align: right;
  }

  /* Section-scoped sizing — keep "Sharpens Both." on a single line at md+ */
  #session .cyber-h2 { font-size: clamp(2rem, 4.4vw, 4rem); }

  /* Zigzag rhythm: at md+ the loop diagram sits on the LEFT, text on the
     right, alternating with Stack so the section run isn't all text-left.
     Below md the column stacks step-list-first. */
  @media (min-width: 768px) {
    .how-grid > .how-left { order: 2; }
  }

  /* ── Responsive ───────────────────────────────────────── */
  @media (min-width: 1024px) {
    #session { padding: 2.25rem 3rem 1.75rem; }
    #session .cyber-section-head { margin-bottom: 0.75rem; }
  }

  @media (max-width: 720px) {
    .how-step { grid-template-columns: 44px 1fr; gap: 10px; padding: 10px 0; }
    .how-step-num { font-size: 1.9rem; }
    .how-step-desc { font-size: 11px; }
    .how-loop-band-meta,
    .how-loop-foot { display: none; }
    .how-loop { padding: 12px 10px 10px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .how-loop-band-dot { animation: none; }
  }
</style>
