---
const features = [
  { icon: '◉', t: 'Persistent Memory',     d: 'Four tiers: working, episodic, semantic, knowledge. Across every session.',           c: 'MEM_LAYER' },
  { icon: '↘', t: 'Frictionless Capture',  d: 'Braindump, capture, or bookmark, whichever matches your thought.',                     c: 'INTAKE_OS' },
  { icon: '◈', t: 'Semantic Search',       d: 'QMD hybrid keyword + vector search. Recall any idea in seconds.',                       c: 'VEC_MATRIX' },
  { icon: '⌘', t: 'Auto-Linking',          d: 'Every new note gets wikilinks pulled from your existing knowledge graph.',              c: 'LINK_SYNC' },
  { icon: '↯', t: 'Skills System',         d: '30+ slash commands wrap deep workflows like /research, /distill, /search, and /schedule-add.', c: 'SKILL_API' },
  { icon: '▦', t: 'PARA Native',           d: 'Ready-made structure for Projects, Areas, Resources, and Knowledge folders.',           c: 'FS_STRUCT' },
];
---

<section id="features" class="cyber-section reveal">
  <div class="cyber-section-orb" aria-hidden="true"></div>
  <div class="cyber-section-grid" aria-hidden="true"></div>

  <div class="cyber-section-shell">
    <header class="cyber-section-head">
      <div class="cyber-pill">
        <span class="cyber-pill-dot"></span>
        <span>ONEBRAIN // FEATURES</span>
      </div>
      <h2 class="cyber-h2">
        Built for<br/>
        <span class="cyber-h2-stroke">Synergetic Thinking.</span>
      </h2>
      <p class="cyber-sub">
        <strong class="brand">OneBrain</strong> works your markdown as a shared workspace. Every feature exists to make you and the agent better at each other's job.
      </p>
    </header>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {features.map((f) => (
        <div class="cyber-card feature-card">
          <span class="cyber-card-meta">{f.c}</span>
          <div class="feature-icon" aria-hidden="true">{f.icon}</div>
          <h3 class="cyber-card-title">{f.t}</h3>
          <p class="cyber-card-desc">{f.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Features-specific tightening — 6 cards across 2 rows + a sizable
     header was overflowing the visible viewport on laptop heights. Trim
     the H2 a touch, the head margin, and card padding so both rows
     centre cleanly inside the section without spilling below the fold. */
  #features .cyber-h2          { font-size: clamp(2rem, 4.6vw, 4rem); }
  /* Full-width grid section: center the header above the grid so it reads
     differently from the left-aligned headers in the split sections. */
  #features .cyber-section-head {
    margin-bottom: 1.25rem;
    text-align: center;
    max-width: 760px;
    margin-inline: auto;
  }
  #features .cyber-pill         { margin-bottom: 18px; }
  #features .cyber-sub          { margin-inline: auto; }

  .feature-card { padding: 1.25rem 1.25rem 1.4rem; }
  .feature-icon {
    font-family: var(--font-mono);
    font-size: 22px;
    color: var(--section-accent);
    line-height: 1;
    margin-bottom: 14px;
    text-shadow: 0 0 16px var(--section-accent);
  }
</style>
