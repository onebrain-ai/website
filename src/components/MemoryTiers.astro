---
// Mirrors the README "Memory System" section. Two stacked visuals:
//  1. Bidirectional flow header (Human ↔ Agent) — sets the "engine" frame.
//  2. Four-tier persistence stack — the "infrastructure" beneath the engine.
//
// Accent palette per tier mirrors the README memory-tiers SVG so the
// gradient reads top→bottom: magenta → violet → lime → cyan.
const tiers = [
  {
    idx: '01',
    name: 'WORKING',
    location: '00-inbox · current session',
    desc: 'Raw captures, unprocessed thoughts.',
    promoters: '/braindump · /capture · /bookmark',
    chip: 'EPHEMERAL',
    glyph: 'IN',
    accent: '#ff2d92',
  },
  {
    idx: '02',
    name: 'EPISODIC',
    location: '07-logs · session + checkpoint',
    desc: 'What happened — sessions, decisions, narrative.',
    promoters: '/wrapup · auto-checkpoints',
    chip: 'PER_SESSION',
    glyph: 'LG',
    accent: '#bc13fe',
  },
  {
    idx: '03',
    name: 'SEMANTIC',
    location: '05-agent · MEMORY.md + memory/',
    desc: 'Identity, preferences, recurring patterns.',
    promoters: '/learn · /recap · /memory-review',
    chip: 'CROSS_SESSION',
    glyph: 'MX',
    accent: '#c8ff00',
  },
  {
    idx: '04',
    name: 'KNOWLEDGE',
    location: '03-knowledge · distilled notes',
    desc: 'Crystallized insights — what you know forever.',
    promoters: '/distill · /connect · /weekly',
    chip: 'FOREVER',
    glyph: 'KB',
    accent: '#00f3ff',
  },
];
---

<section id="memory" class="cyber-section reveal" style="--section-accent: #ff66c4;">
  <div class="cyber-section-orb" aria-hidden="true"></div>
  <div class="cyber-section-grid" aria-hidden="true"></div>

  <div class="cyber-section-shell">
    <header class="cyber-section-head">
      <div class="cyber-pill">
        <span class="cyber-pill-dot"></span>
        <span>ONEBRAIN // MEMORY_SYSTEM</span>
      </div>
      <h2 class="cyber-h2">
        Memory That<br/>
        <span class="cyber-h2-stroke">Compounds.</span>
      </h2>
      <p class="cyber-sub">
        Knowledge sinks downward as it earns trust. The agent recalls upward on demand. Every session, both sides get sharper.
      </p>
    </header>

    <!-- ════════ 1. Bidirectional flow — engine ════════ -->
    <div class="bidir" role="img" aria-label="Bidirectional flow: Human sends preferences, decisions, and corrections to Agent. Agent returns captures, links, and synthesis. Each interaction sharpens both.">
      <span class="bidir-corner bidir-corner-tl" aria-hidden="true"></span>
      <span class="bidir-corner bidir-corner-tr" aria-hidden="true"></span>
      <span class="bidir-corner bidir-corner-bl" aria-hidden="true"></span>
      <span class="bidir-corner bidir-corner-br" aria-hidden="true"></span>

      <div class="bidir-band" aria-hidden="true">
        <span class="bidir-band-dot"></span>
        <span class="bidir-band-label">CO_EVOLUTION_ENGINE</span>
        <span class="bidir-band-meta">// SHARPENS_BOTH_SIDES</span>
      </div>

      <div class="bidir-stage">
        <!-- Human core (left, cyan) -->
        <div class="bidir-core bidir-core-human" aria-hidden="true">
          <span class="bidir-core-ring"></span>
          <span class="bidir-core-eyebrow">YOU</span>
          <span class="bidir-core-name">HUMAN</span>
        </div>

        <!-- Bidirectional arcs SVG -->
        <svg class="bidir-arcs" viewBox="0 0 720 220" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          <defs>
            <marker id="bidir-ah-pink" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M 0 0 L 10 5 L 0 10 z" fill="#ff2d92"/>
            </marker>
            <marker id="bidir-ah-cyan" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M 0 0 L 10 5 L 0 10 z" fill="#00f3ff"/>
            </marker>
          </defs>

          <!-- HUMAN → AGENT (top arc, pink) -->
          <g class="bidir-arc bidir-arc-down">
            <path
              id="bidir-path-down"
              d="M 110 110 Q 360 -20 610 110"
              fill="none"
              stroke="#ff2d92"
              stroke-width="1.6"
              stroke-opacity="0.5"
              stroke-dasharray="5 6"
              marker-end="url(#bidir-ah-pink)"
            />
            <text class="bidir-arc-label bidir-arc-label-down" text-anchor="middle">
              <textPath href="#bidir-path-down" startOffset="50%">
                PREFERENCES · DECISIONS · CORRECTIONS
              </textPath>
            </text>
            <circle class="bidir-flow-dot bidir-flow-dot-down" r="4" fill="#ff2d92">
              <animateMotion dur="4.8s" repeatCount="indefinite" rotate="auto">
                <mpath href="#bidir-path-down"/>
              </animateMotion>
            </circle>
            <circle class="bidir-flow-dot bidir-flow-dot-down" r="3" fill="#ff85c1" opacity="0.7">
              <animateMotion dur="4.8s" begin="1.6s" repeatCount="indefinite" rotate="auto">
                <mpath href="#bidir-path-down"/>
              </animateMotion>
            </circle>
            <circle class="bidir-flow-dot bidir-flow-dot-down" r="3" fill="#ff85c1" opacity="0.5">
              <animateMotion dur="4.8s" begin="3.2s" repeatCount="indefinite" rotate="auto">
                <mpath href="#bidir-path-down"/>
              </animateMotion>
            </circle>
          </g>

          <!-- AGENT → HUMAN (bottom arc, cyan) -->
          <g class="bidir-arc bidir-arc-up">
            <path
              id="bidir-path-up"
              d="M 610 130 Q 360 260 110 130"
              fill="none"
              stroke="#00f3ff"
              stroke-width="1.6"
              stroke-opacity="0.5"
              stroke-dasharray="5 6"
              marker-end="url(#bidir-ah-cyan)"
            />
            <text class="bidir-arc-label bidir-arc-label-up" text-anchor="middle">
              <textPath href="#bidir-path-up" startOffset="50%">
                CAPTURES · LINKS · SYNTHESIS
              </textPath>
            </text>
            <circle class="bidir-flow-dot bidir-flow-dot-up" r="4" fill="#00f3ff">
              <animateMotion dur="5.4s" begin="0.4s" repeatCount="indefinite" rotate="auto">
                <mpath href="#bidir-path-up"/>
              </animateMotion>
            </circle>
            <circle class="bidir-flow-dot bidir-flow-dot-up" r="3" fill="#7af0ff" opacity="0.7">
              <animateMotion dur="5.4s" begin="2.2s" repeatCount="indefinite" rotate="auto">
                <mpath href="#bidir-path-up"/>
              </animateMotion>
            </circle>
            <circle class="bidir-flow-dot bidir-flow-dot-up" r="3" fill="#7af0ff" opacity="0.5">
              <animateMotion dur="5.4s" begin="3.8s" repeatCount="indefinite" rotate="auto">
                <mpath href="#bidir-path-up"/>
              </animateMotion>
            </circle>
          </g>
        </svg>

        <!-- Agent core (right, magenta) -->
        <div class="bidir-core bidir-core-agent" aria-hidden="true">
          <span class="bidir-core-ring"></span>
          <span class="bidir-core-eyebrow">ONEBRAIN</span>
          <span class="bidir-core-name">AGENT</span>
        </div>
      </div>
    </div>

    <!-- ════════ 2. Four-tier persistence stack — infrastructure ════════ -->
    <!-- No role="img" here — each tier carries real text content (name,
         location, description, promoters) that should land in the AT
         tree naturally. Only the decorative spine + arrow column are
         marked aria-hidden. -->
    <div class="mt-stack">
      <span class="mt-corner mt-corner-tl" aria-hidden="true"></span>
      <span class="mt-corner mt-corner-tr" aria-hidden="true"></span>
      <span class="mt-corner mt-corner-bl" aria-hidden="true"></span>
      <span class="mt-corner mt-corner-br" aria-hidden="true"></span>

      <div class="mt-band mt-band-top" aria-hidden="true">
        <span class="mt-band-dot"></span>
        <span class="mt-band-label">PERSISTENCE_STACK · ↓ PROMOTE  ↑ RECALL</span>
        <span class="mt-band-meta">04_TIERS · KNOWLEDGE_SINKS_DOWN</span>
      </div>

      <div class="mt-tiers">
        <!-- Animated spine running left of the tiers -->
        <div class="mt-spine" aria-hidden="true">
          <span class="mt-particle mt-particle-down" style="animation-delay: 0s;"></span>
          <span class="mt-particle mt-particle-down" style="animation-delay: 1.6s;"></span>
          <span class="mt-particle mt-particle-down" style="animation-delay: 3.2s;"></span>
          <span class="mt-particle mt-particle-up" style="animation-delay: 0.8s;"></span>
          <span class="mt-particle mt-particle-up" style="animation-delay: 2.4s;"></span>
        </div>

        {tiers.map((t, i) => (
          <>
            <div
              class="mt-tier"
              style={`--tier-accent: ${t.accent}; --tier-delay: ${i * 0.1}s;`}
            >
              <span class="mt-tier-stripe" aria-hidden="true"></span>
              <span class="mt-tier-edge mt-tier-edge-tl" aria-hidden="true"></span>
              <span class="mt-tier-edge mt-tier-edge-br" aria-hidden="true"></span>

              <div class="mt-tier-glyph" aria-hidden="true">{t.glyph}</div>

              <div class="mt-tier-left">
                <div class="mt-tier-idx">TIER_{t.idx}</div>
                <div class="mt-tier-name">{t.name}</div>
                <div class="mt-tier-loc">{t.location}</div>
              </div>

              <div class="mt-tier-mid">
                <div class="mt-tier-desc">{t.desc}</div>
                <div class="mt-tier-promoters">{t.promoters}</div>
              </div>

              <div class="mt-tier-right">
                <span class="mt-tier-chip">{t.chip}</span>
              </div>
            </div>
            {i < tiers.length - 1 && (
              <div class="mt-arrows" aria-hidden="true" style={`--gap-delay: ${i * 0.4}s;`}>
                <span class="mt-arrow mt-arrow-down" title="promote">↓</span>
                <span class="mt-arrow-label-down">PROMOTE</span>
                <span class="mt-arrow-spacer"></span>
                <span class="mt-arrow-label-up">RECALL</span>
                <span class="mt-arrow mt-arrow-up" title="recall">↑</span>
              </div>
            )}
          </>
        ))}
      </div>

      <div class="mt-band mt-band-bottom" aria-hidden="true">
        <span class="mt-band-meta-mute">FOUR_TIERS_ACROSS_EVERY_SESSION</span>
        <span class="mt-band-meta-mute">VAULT_AS_TRUTH · MARKDOWN_FOREVER</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* ─────────────── Bidirectional flow header ─────────────── */
  .bidir {
    position: relative;
    margin-top: 1.5rem;
    padding: 14px 18px 12px;
    background: rgba(8, 8, 14, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .bidir-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1px solid rgba(255, 255, 255, 0.35);
  }
  .bidir-corner-tl { top: -1px;    left: -1px;    border-right: 0; border-bottom: 0; }
  .bidir-corner-tr { top: -1px;    right: -1px;   border-left: 0;  border-bottom: 0; }
  .bidir-corner-bl { bottom: -1px; left: -1px;    border-right: 0; border-top: 0; }
  .bidir-corner-br { bottom: -1px; right: -1px;   border-left: 0;  border-top: 0; }

  .bidir-band {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 4px 8px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.28em;
    color: rgba(255, 255, 255, 0.45);
    text-transform: uppercase;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    margin-bottom: 6px;
  }
  .bidir-band-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--section-accent);
    box-shadow: 0 0 10px var(--section-accent);
    flex-shrink: 0;
    animation: bidir-band-pulse 2.4s ease-in-out infinite;
  }
  @keyframes bidir-band-pulse {
    0%, 100% { opacity: 1;   transform: scale(1);    }
    50%      { opacity: 0.4; transform: scale(0.85); }
  }
  .bidir-band-meta { margin-left: auto; }

  .bidir-stage {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 10px;
    min-height: 200px;
  }

  .bidir-core {
    position: relative;
    width: 124px;
    height: 124px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }
  .bidir-core-ring {
    position: absolute;
    inset: 8px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    /* Static glow baked in once — animating box-shadow is a Safari
       paint hot path, so the ring's pulse uses transform + opacity on
       the ::after halo instead. */
    box-shadow: inset 0 0 24px color-mix(in srgb, currentColor 35%, transparent);
  }
  .bidir-core-ring::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, currentColor 30%, transparent) 0%, transparent 70%);
    opacity: 0.55;
    pointer-events: none;
  }
  .bidir-core-human { color: #00f3ff; }
  .bidir-core-agent { color: #ff2d92; }
  /* Stagger breathe — human inhales while agent exhales, sells the
     reciprocal flow without needing the arcs to do all the work.
     Compositor-only properties: transform on the ring + opacity on
     the ::after halo. */
  .bidir-core-human .bidir-core-ring { animation: bidir-breathe 5.2s ease-in-out infinite; }
  .bidir-core-agent .bidir-core-ring { animation: bidir-breathe 5.2s ease-in-out infinite; animation-delay: 2.6s; }
  .bidir-core-human .bidir-core-ring::after { animation: bidir-breathe-glow 5.2s ease-in-out infinite; }
  .bidir-core-agent .bidir-core-ring::after { animation: bidir-breathe-glow 5.2s ease-in-out infinite; animation-delay: 2.6s; }
  @keyframes bidir-breathe {
    0%, 100% { transform: scale(1);    }
    50%      { transform: scale(1.06); }
  }
  @keyframes bidir-breathe-glow {
    0%, 100% { opacity: 0.4; }
    50%      { opacity: 1;   }
  }
  .bidir-core-eyebrow {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.32em;
    color: currentColor;
    margin-bottom: 4px;
    text-transform: uppercase;
  }
  .bidir-core-name {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: 0.04em;
    color: #fff;
    text-transform: uppercase;
  }

  .bidir-arcs {
    width: 100%;
    height: 220px;
    overflow: visible;
  }
  .bidir-arc-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.24em;
    fill: rgba(255, 255, 255, 0.62);
    text-transform: uppercase;
  }
  .bidir-arc-label-down { fill: rgba(255, 45, 146, 0.85); }
  .bidir-arc-label-up   { fill: rgba(0, 243, 255, 0.85); }

  /* No filter on the moving dots — `filter: drop-shadow` on a
     transform/SMIL-animated SVG element forces Safari to re-rasterise
     the layer every frame. The dots ride the dashed arc and the arc
     itself carries the visible "flow" — solid dots are enough. */
  .bidir-flow-dot-down { color: #ff2d92; }
  .bidir-flow-dot-up   { color: #00f3ff; }

  /* ─────────────── Four-tier stack ─────────────── */
  .mt-stack {
    position: relative;
    margin-top: 1.5rem;
    padding: 16px 14px 14px;
    background: rgba(8, 8, 14, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .mt-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1px solid rgba(255, 255, 255, 0.35);
  }
  .mt-corner-tl { top: -1px;    left: -1px;    border-right: 0; border-bottom: 0; }
  .mt-corner-tr { top: -1px;    right: -1px;   border-left: 0;  border-bottom: 0; }
  .mt-corner-bl { bottom: -1px; left: -1px;    border-right: 0; border-top: 0; }
  .mt-corner-br { bottom: -1px; right: -1px;   border-left: 0;  border-top: 0; }

  .mt-band {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 4px 8px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.28em;
    color: rgba(255, 255, 255, 0.45);
    text-transform: uppercase;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .mt-band-top { margin-bottom: 8px; }
  .mt-band-bottom {
    border-bottom: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding: 8px 4px 0;
    margin-top: 8px;
    justify-content: space-between;
  }
  .mt-band-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--section-accent);
    box-shadow: 0 0 10px var(--section-accent);
    flex-shrink: 0;
    animation: mt-band-pulse 2.4s ease-in-out infinite;
  }
  @keyframes mt-band-pulse {
    0%, 100% { opacity: 1;   transform: scale(1);    }
    50%      { opacity: 0.4; transform: scale(0.85); }
  }
  .mt-band-meta { margin-left: auto; }
  .mt-band-meta-mute { color: rgba(255, 255, 255, 0.35); }

  .mt-tiers {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* Animated spine — gradient runs t1→t4 accent ladder */
  .mt-spine {
    position: absolute;
    left: 14px;
    top: 0;
    bottom: 0;
    width: 2px;
    pointer-events: none;
    background: linear-gradient(180deg,
      rgba(255, 45, 146, 0.5) 0%,
      rgba(188, 19, 254, 0.5) 33%,
      rgba(200, 255, 0, 0.5) 66%,
      rgba(0, 243, 255, 0.5) 100%);
    mask-image: repeating-linear-gradient(180deg, #000 0 4px, transparent 4px 9px);
    -webkit-mask-image: repeating-linear-gradient(180deg, #000 0 4px, transparent 4px 9px);
  }
  .mt-particle {
    position: absolute;
    left: -2px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fff;
    /* Glow grounded in the bottom-tier cyan accent — same pattern as
       Stack.astro's hs-particle, so both spines feel like siblings. */
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.9), 0 0 18px rgba(0, 243, 255, 0.6);
  }
  .mt-particle-down { animation: mt-travel-down 4.4s linear infinite; }
  .mt-particle-up   { animation: mt-travel-up   5.6s linear infinite; }
  @keyframes mt-travel-down {
    0%   { top: -2%;  opacity: 0;   }
    8%   {           opacity: 0.95; }
    92%  {           opacity: 0.95; }
    100% { top: 102%; opacity: 0;   }
  }
  @keyframes mt-travel-up {
    0%   { top: 102%; opacity: 0;   }
    8%   {           opacity: 0.85; }
    92%  {           opacity: 0.85; }
    100% { top: -2%;  opacity: 0;   }
  }

  .mt-tier {
    position: relative;
    display: grid;
    /* Left col width matches Stack's hs-layer (170px on tablet, ~158px
       on desktop) so the two spine diagrams scan as siblings. */
    grid-template-columns: 36px 170px 1fr auto;
    gap: 14px;
    padding: 10px 14px 10px 30px;
    background: linear-gradient(180deg, rgba(12, 12, 24, 0.92), rgba(6, 6, 13, 0.92));
    border: 1px solid color-mix(in srgb, var(--tier-accent) 35%, transparent);
    align-items: center;
    overflow: hidden;
    transition: transform 0.35s ease, border-color 0.35s ease, background 0.35s ease, box-shadow 0.35s ease;
    transform: translateX(20px);
    opacity: 0;
  }
  .cyber-section.active .mt-tier {
    animation: mt-tier-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--tier-delay);
  }
  @keyframes mt-tier-in {
    to { transform: translateX(0); opacity: 1; }
  }

  .mt-tier-stripe {
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: linear-gradient(90deg,
      var(--tier-accent) 0%,
      color-mix(in srgb, var(--tier-accent) 40%, transparent) 60%,
      transparent 100%);
    box-shadow: 0 0 12px color-mix(in srgb, var(--tier-accent) 75%, transparent);
  }
  .mt-tier-stripe::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.85) 50%, transparent 100%);
    transform: translateX(-100%);
    animation: mt-tier-stripe-sweep 7s ease-in-out infinite;
    animation-delay: var(--tier-delay);
  }
  @keyframes mt-tier-stripe-sweep {
    0%, 70%, 100% { transform: translateX(-100%); }
    85%           { transform: translateX(100%);  }
  }

  .mt-tier-edge {
    position: absolute;
    width: 8px;
    height: 8px;
    border: 1px solid var(--tier-accent);
  }
  .mt-tier-edge-tl { top: 0;    left: 0;    border-right: 0; border-bottom: 0; }
  .mt-tier-edge-br { bottom: 0; right: 0;   border-left: 0;  border-top: 0; }

  .mt-tier:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--tier-accent) 75%, transparent);
    background: linear-gradient(180deg,
      color-mix(in srgb, var(--tier-accent) 8%, rgba(12, 12, 24, 0.92)),
      rgba(6, 6, 13, 0.92));
    box-shadow:
      0 0 24px color-mix(in srgb, var(--tier-accent) 22%, transparent),
      inset 0 0 0 1px color-mix(in srgb, var(--tier-accent) 30%, transparent);
  }

  .mt-tier-glyph {
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--tier-accent) 60%, transparent);
    color: var(--tier-accent);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    background: color-mix(in srgb, var(--tier-accent) 8%, transparent);
  }

  .mt-tier-idx {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    color: var(--tier-accent);
    letter-spacing: 0.1em;
    margin-bottom: 2px;
  }
  .mt-tier-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-style: italic;
    font-size: 1rem;
    color: #fff;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.05;
  }
  .mt-tier-loc {
    margin-top: 3px;
