---
---

<section id="synergy" class="cyber-section reveal" style="--section-accent: #ff2d92;">
  <div class="cyber-section-orb" aria-hidden="true"></div>
  <div class="cyber-section-grid" aria-hidden="true"></div>

  <div class="cyber-section-shell">
    <div class="grid lg:grid-cols-[1.3fr_1fr] gap-12 lg:gap-16 items-center">

      <!-- LEFT: Headline + benefit cards -->
      <div>
        <header>
          <div class="cyber-pill">
            <span class="cyber-pill-dot"></span>
            <span>ONEBRAIN // SYNERGY</span>
          </div>
          <h2 class="cyber-h2">
            Beyond a<br/>
            <span class="cyber-h2-stroke">Second Brain.</span>
          </h2>
          <p class="cyber-sub">
            <strong class="brand">OneBrain</strong> doesn't ask you to query an AI — it co-evolves with you. Every preference you teach sharpens the agent, every link it surfaces sharpens you.
          </p>
        </header>

        <div class="synergy-cards mt-6 grid sm:grid-cols-2 gap-4">
          <div class="cyber-card synergy-card">
            <span class="cyber-card-meta">01</span>
            <div class="synergy-icon" aria-hidden="true">🧠</div>
            <h3 class="cyber-card-title">HUMAN → AGENT</h3>
            <p class="cyber-card-desc">Every correction becomes lasting memory. The agent learns you over time.</p>
          </div>
          <div class="cyber-card synergy-card">
            <span class="cyber-card-meta">02</span>
            <div class="synergy-icon" aria-hidden="true">⚡</div>
            <h3 class="cyber-card-title">AGENT → HUMAN</h3>
            <p class="cyber-card-desc">Captures and links the noise of your day. You stay on what only you can do.</p>
          </div>
        </div>
      </div>

      <!-- RIGHT: Animated knowledge nebula (lg+) -->
      <div class="hidden lg:block">
        <div class="nebula-frame">
          <div class="nebula-corner nebula-corner-tl"></div>
          <div class="nebula-corner nebula-corner-tr"></div>
          <div class="nebula-corner nebula-corner-bl"></div>
          <div class="nebula-corner nebula-corner-br"></div>

          <div class="nebula-band" aria-hidden="true">
            <span class="nebula-band-dot"></span>
            <span class="nebula-band-label">KNOWLEDGE_GRAPH · LIVE</span>
            <span class="nebula-band-meta">CO_EVOLVING</span>
          </div>

          <div class="nebula-stage">
            <canvas id="nebula-graph" aria-hidden="true"></canvas>
            <div class="nebula-core" aria-hidden="true">
              <div class="nebula-breath"></div>
            </div>
          </div>

          <div class="nebula-readout">
            <span>NODES <strong id="nebula-nodes">000</strong></span>
            <span>EDGES <strong id="nebula-edges">000</strong></span>
            <span>CYCLE <strong>active</strong></span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const canvas = document.getElementById('nebula-graph');
    if (!canvas) return;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ctx = canvas.getContext('2d', { alpha: true });
    const nodesEl = document.getElementById('nebula-nodes');
    const edgesEl = document.getElementById('nebula-edges');
    let width, height, dpr;
    let nodes = [];
    // 130 nodes ≈ 8.4k edge checks/frame (vs 200 = 19.9k). Visually still
    // a dense cluster; cuts the O(n²) inner loop ~58%. Combined with the
    // 30fps draw cap below this halves the per-second canvas work.
    const maxNodes = 130;
    const maxDist = 85;            // connection range → cluster overlap
    const maxDistSq = maxDist * maxDist;
    // Tonal magenta palette so the nebula reads as the Synergy section's
    // accent (#ff2d92) rather than a rainbow that competes with every
    // other section's colour. White synapse sparks stay for contrast and
    // depth so the graph still feels alive, not monochrome.
    const SECTION_PALETTE = [
      '#ff2d92', // synergy core (brand magenta)
      '#ff5fad', // lighter magenta (soft tone)
      '#d6217a', // darker magenta (deep tone)
      '#ff85c1', // pink wash
      '#ffffff', // white synapse spark
    ];
    const seedCount = 18;          // pre-seed scaled with maxNodes
    const seedInterval = 60;       // gentler cadence for seed phase
    // Per-frame constants doubled vs the 60fps original — the draw loop
    // is now capped at 30fps below, so 0.022 → 0.044 preserves the
    // original ~750ms halo decay, 0.013 → 0.026 preserves ~1.3s exhale,
    // and the 0.04 → 0.08 fade-in (in draw()) preserves ~300ms.
    const pulseDecay = 0.044;      // ~750ms full decay (at 30fps)
    const idleAfterFull = 1800;    // briefly admire the full cluster
    const fadeOutDuration = 1800;  // gentle exhale — matches fade rate below
    const fadeOutRate = 0.026;     // per-frame opacity decay (~1.3s for 1.0→0 at 30fps)
    let spawnTimeout = null;       // recursive setTimeout handle for live phase
    const mouse = { x: null, y: null, radius: 110 };
    let spawnTimer = null;
    let isResetting = false;

    // Visibility/lifecycle state — declared up-front so draw()/start() never hit a TDZ.
    let rafId = 0;
    let running = true;
    let visible = true;
    let lastFrame = 0;             // ms timestamp of last drawn frame (30fps gate)

    function init() {
      // Reduced-motion: leave canvas blank, skip every allocation. The
      // .nebula-breath orb (CSS-static under reduced) is the visual.
      if (reduced) return;
      // Cancel any queued frame and any pending spawn timers — init()
      // is the new source of truth. Both calls are idempotent + safe to
      // run before the zero-size early-return; without doing them up-
      // front, an init() that early-returns on `.hidden lg:block`
      // collapse would leak the old timers/RAF, and the loop-reset
      // setTimeout(init, ...) would re-fire with stale state.
      if (rafId) { cancelAnimationFrame(rafId); rafId = 0; }
      clearSpawnTimers();
      dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      width = canvas.offsetWidth;
      height = canvas.offsetHeight;
      // Skip allocating a zero-sized GPU buffer — happens when the
      // .hidden lg:block parent collapses on mobile. State is now
      // fully quiesced (no RAF, no timers) so an IO/visibility re-
      // enter at the next desktop-size paint cleanly re-inits.
      if (!width || !height) return;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.scale(dpr, dpr);
      nodes = [];
      startSpawning();
      // Re-arm RAF here so every entry path (bootstrap, loop-reset
      // setTimeout(init, ...), debounced resize, IO/visibility re-enter)
      // automatically continues drawing. Without this, the loop-reset
      // path would silently stop the animation after fadeOutDuration.
      start();
    }
    // Random delay between live spawns — mimics actual OneBrain use:
    // mostly normal-paced thoughts, occasional thinking pauses, rare bursts of insight.
    function randomSpawnDelay() {
      const r = Math.random();
      if (r < 0.7) return 450 + Math.random() * 400;   // ~70% normal: 450–850ms
      if (r < 0.9) return 1100 + Math.random() * 900;  // ~20% pause: 1100–2000ms ("thinking")
      return 200 + Math.random() * 200;                // ~10% burst: 200–400ms ("insight")
    }
    function spawnOne(withPulse) {
      const cx = width / 2;
      const cy = height / 2;
      const angle = Math.random() * Math.PI * 2;
      const radius = Math.pow(Math.random(), 0.8) * (width * 0.42);
      nodes.push({
        x: cx + Math.cos(angle) * (radius + 18),
        y: cy + Math.sin(angle) * (radius + 18),
        angle,
        // Doubled vs the 60fps original (0.000512 + 0.001432) so the
        // perceived orbital speed survives the 30fps draw cap. Frame-
        // rate-coupled — must change in lock-step with the gate above.
        orbitSpeed: 0.001024 + Math.random() * 0.002864,
        orbitRadius: radius,
        size: Math.random() * 1.4 + 1.1,
        // Random pick from the magenta-tonal palette — see SECTION_PALETTE comment above.
        color: SECTION_PALETTE[Math.floor(Math.random() * SECTION_PALETTE.length)],
        opacity: 0,                             // always fade in — never pop
        targetOpacity: 0.55 + Math.random() * 0.4,
        pulse: withPulse ? 1 : 0,               // synapse fire — decays over ~750ms
      });
    }
    function startSpawning() {
      isResetting = false;
      let count = 0;

      function spawnLive() {
        if (count >= maxNodes) {
          // Brief pause for the user to admire the full cluster, then reset → loop
          spawnTimeout = setTimeout(() => {
            isResetting = true;
            spawnTimeout = setTimeout(init, fadeOutDuration);
          }, idleAfterFull);
          return;
        }
        spawnOne(true);
        count++;
        if (nodesEl) nodesEl.textContent = String(count).padStart(3, '0');
        spawnTimeout = setTimeout(spawnLive, randomSpawnDelay());
      }

      function spawnSeed() {
        if (count >= seedCount) {
          clearInterval(spawnTimer);
          spawnTimer = null;
          // Brief pause before live phase begins, then start the random-paced spawning
          spawnTimeout = setTimeout(spawnLive, 600);
          return;
        }
        spawnOne(false);
        count++;
        if (nodesEl) nodesEl.textContent = String(count).padStart(3, '0');
      }

      // Phase 1 (seed): nodes appear at gentle constant cadence — graph waking up
      // Phase 2 (live): each new node fires synapses, with random timing — knowledge arriving naturally
      spawnTimer = setInterval(spawnSeed, seedInterval);
    }
    // 30fps cap — nebula is ambient decoration, full 60 burns GPU for
    // motion the eye can't distinguish. Mirrors the neural-canvas pattern.
    function draw(now) {
      rafId = 0;
      if (!running || !visible || reduced) return;
      if (now && now - lastFrame < 32) {
        rafId = requestAnimationFrame(draw);
        return;
      }
      lastFrame = now || 0;
      ctx.clearRect(0, 0, width, height);
      const cx = width / 2;
      const cy = height / 2;
      const len = nodes.length;
      let edgeCount = 0;

      // Edges first — flashing layer driven by node pulses (max of either endpoint).
      // Base edge: soft cool-white network (Obsidian graph vibe) so clusters stay readable at rest.
      // Flash: bright white synapse fire, fades back into the cluster.
      for (let i = 0; i < len; i++) {
        const a = nodes[i];
        for (let j = i + 1; j < len; j++) {
          const b = nodes[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const dsq = dx * dx + dy * dy;
          if (dsq < maxDistSq) {
            edgeCount++;
            const d = Math.sqrt(dsq);
            const proximity = 1 - d / maxDist;
            const baseAlpha = proximity * 0.5 * a.opacity;
            const pulse = a.pulse > b.pulse ? a.pulse : b.pulse;
            const flashAlpha = baseAlpha + pulse * proximity * 0.55;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.strokeStyle = pulse > 0.35 ? '#ffffff' : 'rgba(225, 235, 255, 1)';
            ctx.lineWidth = 0.85 + pulse * 1.1;
            ctx.globalAlpha = flashAlpha < 0.95 ? flashAlpha : 0.95;
            ctx.stroke();
          }
        }
      }

      // Nodes + halo + decay
      const mx = mouse.x;
      const my = mouse.y;
      const mr = mouse.radius;
      const mrSq = mr * mr;
      for (let k = 0; k < len; k++) {
        const n = nodes[k];
        if (!isResetting && n.opacity < n.targetOpacity) n.opacity += 0.08;
        if (isResetting && n.opacity > 0) n.opacity -= fadeOutRate;
        if (n.opacity < 0) n.opacity = 0;
        if (n.pulse > 0) {
          n.pulse -= pulseDecay;
          if (n.pulse < 0) n.pulse = 0;
        }
        n.angle += n.orbitSpeed;
        const tx = cx + Math.cos(n.angle) * n.orbitRadius;
        const ty = cy + Math.sin(n.angle) * n.orbitRadius;
        // Lerp coefficient bumped from 0.1 → 0.19 to match the 30fps
        // gate. Two 60fps lerps of 0.1 leave a residual of 0.81 of the
        // gap; 1 − 0.9² = 0.19 gives the same per-second tracking. The
        // original 0.1 felt visibly trail-y at 30fps.
        n.x += (tx - n.x) * 0.19;
        n.y += (ty - n.y) * 0.19;
        if (mx !== null) {
          const mdx = n.x - mx;
          const mdy = n.y - my;
          const mdSq = mdx * mdx + mdy * mdy;
          if (mdSq < mrSq) {
            const md = Math.sqrt(mdSq);
            const f = (mr - md) / mr;
            // Guard md=0 (cursor exactly on a node) to avoid NaN drift.
            if (md > 0) {
              n.x += (mdx / md) * f * 5;
              n.y += (mdy / md) * f * 5;
            }
          }
        }
        // Halo on freshly fired node — gives the "spark" feel
        if (n.pulse > 0.15) {
          ctx.beginPath();
          ctx.arc(n.x, n.y, n.size + n.pulse * 5, 0, Math.PI * 2);
          ctx.fillStyle = '#ffffff';
          ctx.globalAlpha = n.pulse * 0.35;
          ctx.fill();
        }
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.size, 0, Math.PI * 2);
        ctx.fillStyle = n.color;
        ctx.globalAlpha = n.opacity;
        ctx.fill();
      }
      ctx.globalAlpha = 1;

      if (edgesEl) edgesEl.textContent = String(edgeCount).padStart(3, '0');
      rafId = requestAnimationFrame(draw);
    }
    function start() { if (!rafId && running && visible && !reduced) rafId = requestAnimationFrame(draw); }
    function clearSpawnTimers() {
      if (spawnTimer)   { clearInterval(spawnTimer);   spawnTimer = null; }
      if (spawnTimeout) { clearTimeout(spawnTimeout);  spawnTimeout = null; }
    }
    function stopAll() {
      clearSpawnTimers();
      if (rafId) { cancelAnimationFrame(rafId); rafId = 0; }
    }
    // Tear down the spawn lifecycle when the section leaves the
    // viewport / tab is hidden, then restart it on re-show. The user
    // sees the network bloom from scratch each time they scroll back —
    // matches the "load + run again on screen" model the user asked
    // for. Restarting is cheap (init() resets nodes + reseeds).
    // Always stopAll() then init() on re-entry — both are idempotent and
    // the previous "skip init() when timers exist" optimization left a
    // race window during the loop-reset's fadeOut: spawnTimeout was the
    // pending init() reset, so re-entry skipped a fresh init() and
    // re-armed RAF against stale `isResetting=true` state.
    document.addEventListener('visibilitychange', () => {
      visible = !document.hidden;
      if (visible && running) {
        stopAll();
        init();
      } else {
        stopAll();
      }
    });
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        const wasRunning = running;
        running = entries[0].isIntersecting;
        if (running && !wasRunning && visible) {
          stopAll();
          init();
        } else if (!running) {
          stopAll();
        }
      }, { rootMargin: '0px' });
      io.observe(canvas);
    }
    // Debounced resize — every mobile address-bar slide / dev-tools
    // toggle would otherwise re-allocate the GPU buffer + reset nodes
    // on every event. 200ms swallow window keeps the actual work to
    // one init() per resize gesture.
    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      if (resizeTimer) clearTimeout(resizeTimer);
      resizeTimer = setTimeout(init, 200);
    }, { passive: true });
    // event.offsetX/Y are already canvas-local — drop the per-event
    // getBoundingClientRect() (forced layout). Throttle to ~30Hz so
    // the repulsion math doesn't run on every native pointer event.
    // Assumption: no CSS transform on the canvas or any ancestor of
    // .nebula-stage. Adding one would make offsetX/Y disagree with
    // the canvas's local coordinate space — switch back to a cached
    // getBoundingClientRect path if that ever changes.
    let mouseTick = 0;
    canvas.addEventListener('mousemove', (e) => {
      const now = performance.now();
      if (now - mouseTick < 32) return;
      mouseTick = now;
      mouse.x = e.offsetX;
      mouse.y = e.offsetY;
    }, { passive: true });
    canvas.addEventListener('mouseleave', () => { mouse.x = null; mouse.y = null; });
    init();
  })();
</script>

<style>
  /* Section-scoped sizing — keep left column compact so the square
     nebula frame on the right can vertically center against it
     without leaving large empty bands above/below. */
  #synergy .cyber-h2 { font-size: clamp(2rem, 4.4vw, 4rem); }
  #synergy .cyber-sub { margin-top: 0.5rem; }
  .synergy-cards .cyber-card { padding: 14px 16px; }
  .synergy-cards .cyber-card-desc { font-size: 11.5px; line-height: 1.5; }

  /* Synergy cards — emoji icon sits between the meta number and the
     title; glows soft magenta to align with the section accent. */
  .synergy-icon {
    font-size: 26px;
    line-height: 1;
    margin: 8px 0 14px;
    filter: drop-shadow(0 0 12px rgba(255, 45, 146, 0.45));
  }

  .nebula-frame {
    position: relative;
    aspect-ratio: 1 / 1;
    display: flex;
    flex-direction: column;
    padding: 14px 14px 12px;
    background: rgba(8, 8, 14, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .nebula-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1px solid var(--section-accent);
    z-index: 3;
  }
  .nebula-corner-tl { top: -1px;    left: -1px;    border-right: 0; border-bottom: 0; }
  .nebula-corner-tr { top: -1px;    right: -1px;   border-left: 0;  border-bottom: 0; }
  .nebula-corner-bl { bottom: -1px; left: -1px;    border-right: 0; border-top: 0; }
  .nebula-corner-br { bottom: -1px; right: -1px;   border-left: 0;  border-top: 0; }

  .nebula-band {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 4px 8px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.28em;
    color: rgba(255, 255, 255, 0.45);
    text-transform: uppercase;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    margin-bottom: 6px;
  }
  .nebula-band-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--section-accent);
    box-shadow: 0 0 10px var(--section-accent);
    flex-shrink: 0;
    animation: nebula-band-pulse 2.4s ease-in-out infinite;
  }
  @keyframes nebula-band-pulse {
    0%, 100% { opacity: 1;   transform: scale(1);    }
    50%      { opacity: 0.4; transform: scale(0.85); }
  }
  .nebula-band-meta { margin-left: auto; }

  .nebula-stage {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  #nebula-graph {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: crosshair;
  }
  .nebula-core {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  /* Breathing orb — soft inhale/exhale behind the network graph. The
     `filter: blur(32px)` is baked in via a wider radial-gradient so we
     can drop the runtime CSS filter, and the animation moves to
     opacity-only — animating transform on a filter:blur surface forces
     WebKit to re-rasterise the blur kernel every frame, leaking paint
     cost onto scroll-snap glides. */
  .nebula-breath {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: radial-gradient(circle,
      rgba(255, 45, 146, 0.4) 0%,
      rgba(255, 133, 193, 0.18) 28%,
      rgba(255, 45, 146, 0.06) 55%,
      transparent 80%);
    animation: nebula-breathe 5s ease-in-out infinite;
  }
  @keyframes nebula-breathe {
    0%, 100% { opacity: 0.55; }
    50%      { opacity: 1;    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nebula-breath  { animation: none; opacity: 0.7; }
    .nebula-band-dot { animation: none; }
  }
  .nebula-readout {
    margin-top: 6px;
    padding: 8px 4px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.3em;
    color: rgba(255, 255, 255, 0.4);
    text-transform: uppercase;
  }
  .nebula-readout strong {
    color: #fff;
    font-weight: 700;
    margin-left: 6px;
  }
</style>
