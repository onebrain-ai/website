---
// Tight 3-beat summary that lives below the sub paragraph on the left.
// Each line is one short sentence — the long-form beat cards were
// pulled in favour of the animation getting top-half real estate.
const beats = [
  'Read once, understand all — agent context lives in one place, never re-explained.',
  'Code in repos, orchestration in vault — agent dispatches from here to wherever the work actually lives.',
  'Markdown replaces Slack / Linear / Notion — version-controlled, AI-readable, yours forever.',
];

// Hub-and-spokes map of where the agent dispatches FROM the vault.
// Each entry includes:
//  - label-anchor hint so SVG text doesn't run off the diagram edge
//  - duration + inbound flag so each particle has its own pace
//    (varied 2.6–4.6s) and direction. inbound=true → data flows
//    outer→centre (project sending into vault); inbound=false →
//    data flows centre→outer (vault dispatching to project).
// 8 nodes evenly spaced at 45° intervals around the ring.
// Travel takes 25% of the cycle, so cycle 3.2s → 800ms travel,
// cycle 8s → 2000ms travel. Initial spread across the range.
const dispatches = [
  { angle: -90, label: 'CLI / REPO',    anchor: 'middle', duration: 5.5, inbound: false },
  { angle: -45, label: 'WEBSITE',       anchor: 'start',  duration: 4.2, inbound: true  },
  { angle:   0, label: 'CLOUD INFRA',   anchor: 'start',  duration: 6.8, inbound: false },
  { angle:  45, label: 'SOCIAL MEDIA',  anchor: 'start',  duration: 4.8, inbound: true  },
  { angle:  90, label: 'OFFICE DOCS',   anchor: 'middle', duration: 6.0, inbound: false },
  { angle: 135, label: 'PROJECT NOTES', anchor: 'end',    duration: 3.6, inbound: true  },
  { angle: 180, label: 'RESEARCH',      anchor: 'end',    duration: 7.5, inbound: false },
  { angle: 225, label: 'MCP SERVER',    anchor: 'end',    duration: 5.0, inbound: true  },
];
---

<section id="workflow" class="cyber-section reveal" style="--section-accent: #ff5e3a;">
  <div class="cyber-section-orb" aria-hidden="true"></div>
  <div class="cyber-section-grid" aria-hidden="true"></div>

  <div class="cyber-section-shell">

    <!-- 50:50 — header + bullet recap on the left, animated hub on
         the right. The animation owns the right half so the
         "command center → many destinations" idea reads visually
         before the user reads any copy. -->
    <div class="workflow-top">
      <div class="workflow-text">
        <header class="cyber-section-head">
          <div class="cyber-pill">
            <span class="cyber-pill-dot"></span>
            <span>ONEBRAIN // WORKFLOW</span>
          </div>
          <h2 class="cyber-h2">
            One Vault,<br/>
            <span class="cyber-h2-stroke">All Projects.</span>
          </h2>
          <p class="cyber-sub">
            Obsidian becomes your <strong>command center</strong> — research, planning, agent memory, project state, all in one place. No tab juggling. No tool sprawl.
          </p>
        </header>

        <ul class="workflow-recap">
          {beats.map((b) => (
            <li>
              <span class="workflow-recap-mark">»</span>
              <span>{b}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Hub-and-spokes diagram with inline labels + animated
           data-flow particles. Each spoke gets one particle that
           travels centre↔outer-node on a loop, staggered so the
           pulses feel alive without strobing. -->
      <div class="workflow-hub" aria-hidden="true">
        <svg viewBox="-280 -200 560 400" class="workflow-hub-svg">
          <!-- Outer ring -->
          <circle cx="0" cy="0" r="150" class="hub-ring" />

          <!-- Spokes + outer nodes + arrival pings + labels.
               The ping is a second circle behind the node that
               expands outward and fades on each cycle, synced to
               the particle's arrival at this spoke's outer
               endpoint (50% of cycle for outbound, 0%/100% for
               inbound). animation-duration + delay match the
               particle so they stay in lockstep. -->
          {dispatches.map((d, i) => {
            const rad = (d.angle * Math.PI) / 180;
            const nodeR = 150;
            const labelR = 175;
            const nx = Math.cos(rad) * nodeR;
            const ny = Math.sin(rad) * nodeR;
            const lx = Math.cos(rad) * labelR;
            const ly = Math.sin(rad) * labelR
              + (d.anchor === 'middle' ? (Math.sin(rad) > 0 ? 14 : -8) : 4);
            const delay = ((i * 0.37) % d.duration).toFixed(2);
            const pingDir = d.inbound ? 'hub-node-ping-in' : 'hub-node-ping-out';
            return (
              <g>
                <line x1="0" y1="0" x2={nx} y2={ny} class="hub-spoke" />
                <circle
                  cx={nx} cy={ny} r="5"
                  class={`hub-node-ping ${pingDir}`}
                  data-spoke={i}
                  style={`animation-duration: ${d.duration}s; animation-delay: ${delay}s;`}
                />
                <circle cx={nx} cy={ny} r="5" class="hub-node" />
                <text x={lx} y={ly} text-anchor={d.anchor} class="hub-node-label">{d.label}</text>
              </g>
            );
          })}

          <!-- Data-flow particles — one per spoke. Each carries its
               own duration + direction, so the eight pulses don't
               sync into a strobe. CSS --tx/--ty hold each spoke's
               outer endpoint; the .hub-particle-in / -out class
               picks which keyframe to follow (inbound vs outbound). -->
          {dispatches.map((d, i) => {
            const rad = (d.angle * Math.PI) / 180;
            const tx = Math.cos(rad) * 150;
            const ty = Math.sin(rad) * 150;
            // Stagger via prime-ish multiplier so identical durations
            // don't realign every cycle.
            const delay = ((i * 0.37) % d.duration).toFixed(2);
            const dir = d.inbound ? 'hub-particle-in' : 'hub-particle-out';
            return (
              <circle
                r="3.5"
                class={`hub-particle ${dir}`}
                data-spoke={i}
                style={`--tx: ${tx.toFixed(1)}px; --ty: ${ty.toFixed(1)}px; animation-duration: ${d.duration}s; animation-delay: ${delay}s;`}
              />
            );
          })}

          <!-- Centre: Obsidian vault as command center. Breath
               on the stroke is the only "alive" cue at the core —
               the surrounding particle traffic carries the rest. -->
          <circle cx="0" cy="0" r="52" class="hub-core" />
          <text x="0" y="-3" text-anchor="middle" class="hub-core-label">OBSIDIAN</text>
          <text x="0" y="13" text-anchor="middle" class="hub-core-sub">vault</text>
        </svg>
      </div>

    </div>
  </div>
</section>

<script is:inline>
  /* Per-cycle duration randomization for the workflow particles +
     pings. Without this, each spoke loops on a fixed duration and
     the diagram falls into a visible pattern within ~10 seconds.
     On every animationiteration we re-roll the duration in a
     2.4–5.8s range and apply the same value to the spoke's particle
     AND its corresponding ping so they stay in lockstep. */
  (function () {
    const particles = document.querySelectorAll('.hub-particle');
    if (!particles.length) return;
    /* Travel = 25% of cycle, so cycle 3.2s ↔ 8s gives a travel
       leg of 800ms ↔ 2000ms — snappy enough to feel like data
       moving, slow enough to follow with the eye. Held constant
       for the whole cycle (linear timing function). */
    function randomDur() { return (3.2 + Math.random() * 4.8).toFixed(2); }
    particles.forEach((p) => {
      const idx = p.dataset.spoke;
      const ping = document.querySelector(`.hub-node-ping[data-spoke="${idx}"]`);
      p.addEventListener('animationiteration', () => {
        const d = randomDur() + 's';
        p.style.animationDuration = d;
        if (ping) ping.style.animationDuration = d;
      });
    });
  })();
</script>

<style>
  /* Section-scoped tightening so header + recap + hub fit one
     viewport. */
  #workflow .cyber-h2           { font-size: clamp(2rem, 4.6vw, 4rem); }
  #workflow .cyber-pill         { margin-bottom: 18px; }
  #workflow .cyber-section-head { margin-bottom: 1rem; }

  /* 50:50 split. Left column carries the message (header + recap
     bullets); right column carries the animated hub diagram. */
  .workflow-top {
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .workflow-top {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  .workflow-text {
    display: flex;
    flex-direction: column;
  }
  /* Recap bullets — three short lines that summarise the beats the
     long-form cards used to spell out, kept lean so the section
     fits. */
  .workflow-recap {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 1rem;
  }
  .workflow-recap li {
    display: grid;
    grid-template-columns: 14px 1fr;
    gap: 10px;
    align-items: start;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.78);
  }
  .workflow-recap-mark {
    color: var(--section-accent);
    font-weight: 700;
  }

  /* ── RIGHT: hub diagram with inline labels ── */

  .workflow-hub {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }
  .workflow-hub-svg {
    width: 100%;
    max-width: 520px;
    aspect-ratio: 1.4 / 1;
    overflow: visible;
  }

  .hub-ring {
    fill: none;
    stroke: color-mix(in srgb, var(--section-accent) 18%, transparent);
    stroke-width: 1;
    stroke-dasharray: 3 5;
    /* Rotate around the ring's own centre regardless of layout. */
    transform-box: fill-box;
    transform-origin: center;
  }
  .cyber-section.active .hub-ring {
    animation: hub-ring-spin 80s linear infinite;
  }
  @keyframes hub-ring-spin {
    to { transform: rotate(360deg); }
  }
  .hub-spoke {
    stroke: color-mix(in srgb, var(--section-accent) 35%, transparent);
    stroke-width: 1;
  }
  .hub-node {
    fill: var(--section-accent);
  }
  /* Arrival-ping ring on each outer node — fires when "its" particle
     reaches the spoke endpoint, so the diagram reads as a packet
     landing rather than just dots travelling. transform-box+origin
     pin the scale to each circle's own centre. */
  .hub-node-ping {
    fill: none;
    stroke: var(--section-accent);
    stroke-width: 1.5;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .cyber-section.active .hub-node-ping-out {
    animation-name: hub-node-ping-out;
    animation-iteration-count: infinite;
    animation-timing-function: ease-out;
  }
  .cyber-section.active .hub-node-ping-in {
    animation-name: hub-node-ping-in;
    animation-iteration-count: infinite;
    animation-timing-function: ease-out;
  }
  /* Outbound: TWO pulses per cycle.
       1. Arrival pulse at 30% — particle reaches outer node.
       2. Release pulse at 65% — node sends particle back. */
  @keyframes hub-node-ping-out {
    0%, 27%   { transform: scale(1);   opacity: 0;    stroke-width: 2; }
    30%       { transform: scale(1);   opacity: 0.95; stroke-width: 2; }
    50%       { transform: scale(2.4); opacity: 0;    stroke-width: 0.5; }
    62%       { transform: scale(1);   opacity: 0;    stroke-width: 2; }
    65%       { transform: scale(1);   opacity: 0.95; stroke-width: 2; }
    85%, 100% { transform: scale(2.4); opacity: 0;    stroke-width: 0.5; }
  }
  /* Inbound: TWO pulses per cycle, mirrored.
       1. Release pulse at 0% — outer node releases particle to
          vault.
       2. Arrival pulse at 95% — particle arrives back at outer. */
  @keyframes hub-node-ping-in {
    0%        { transform: scale(1);   opacity: 0.95; stroke-width: 2; }
    20%       { transform: scale(2.4); opacity: 0;    stroke-width: 0.5; }
    92%       { transform: scale(1);   opacity: 0;    stroke-width: 2; }
    95%       { transform: scale(1);   opacity: 0.95; stroke-width: 2; }
    100%      { transform: scale(2.4); opacity: 0;    stroke-width: 0.5; }
  }
  .hub-node-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    fill: rgba(255, 255, 255, 0.85);
  }
  .hub-core {
    fill: rgba(2, 2, 4, 0.92);
    stroke: var(--section-accent);
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
  }
  /* Slow inhale/exhale on the vault core. 5.5s = the median
     particle cycle (range 3.2–8s) so breath + traffic feel like
     one tempo. */
  .cyber-section.active .hub-core {
    animation: hub-core-breathe 5.5s ease-in-out infinite;
  }
  @keyframes hub-core-breathe {
    0%, 100% { stroke-width: 1.5; stroke-opacity: 0.55; }
    50%      { stroke-width: 3;   stroke-opacity: 1;    }
  }
  .hub-core-label {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    fill: #fff;
  }
  .hub-core-sub {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.32em;
    fill: var(--section-accent);
  }

  /* Data-flow particles. White dots = "data packets in transit",
     visually distinct from the coral structure (spokes, nodes,
     ring). Each particle has its own direction, duration, and
     stagger delay (set inline) so the eight pulses feel like
     asynchronous traffic, not a strobe.

     Lifecycle (per cycle): fade in at origin → travel to
     destination → fade out at destination → brief pause invisible
     → fade in at destination → travel home → fade out at origin.
     ease-in-out timing function carries the deceleration so the
     keyframe stays at the minimum number of stops. */
  .hub-particle {
    fill: #ffffff;
    opacity: 0;
    will-change: transform, opacity;
  }
  /* Linear timing function so the particle moves at a CONSTANT
     speed within each cycle — speed only changes at the cycle
     boundary (when the JS re-rolls duration). Symmetric outbound
     vs inbound legs (both 31% of cycle) so direction never feels
     faster than the other. */
  .cyber-section.active .hub-particle-out {
    animation-name: hub-particle-flow-out;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  .cyber-section.active .hub-particle-in {
    animation-name: hub-particle-flow-in;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  /* Outbound: vault → project. Symmetric stages:
       0–5%   fade in at vault
       5–30%  travel out (25% — gives 800ms–2000ms over 3.2–8s cycle)
       30–35% fade out at destination (delivered)
       35–65% pause invisible at destination (30%)
       65–70% fade in at destination
       70–95% travel back (25%)
       95–100% fade out at vault */
  @keyframes hub-particle-flow-out {
    0%   { transform: translate(0, 0);                 opacity: 0; }
    5%   { transform: translate(0, 0);                 opacity: 1; }
    30%  { transform: translate(var(--tx), var(--ty)); opacity: 1; }
    35%  { transform: translate(var(--tx), var(--ty)); opacity: 0; }
    65%  { transform: translate(var(--tx), var(--ty)); opacity: 0; }
    70%  { transform: translate(var(--tx), var(--ty)); opacity: 1; }
    95%  { transform: translate(0, 0);                 opacity: 1; }
    100% { transform: translate(0, 0);                 opacity: 0; }
  }
  /* Inbound: project → vault. Same shape, mirrored. */
  @keyframes hub-particle-flow-in {
    0%   { transform: translate(var(--tx), var(--ty)); opacity: 0; }
    5%   { transform: translate(var(--tx), var(--ty)); opacity: 1; }
    30%  { transform: translate(0, 0);                 opacity: 1; }
    35%  { transform: translate(0, 0);                 opacity: 0; }
    65%  { transform: translate(0, 0);                 opacity: 0; }
    70%  { transform: translate(0, 0);                 opacity: 1; }
    95%  { transform: translate(var(--tx), var(--ty)); opacity: 1; }
    100% { transform: translate(var(--tx), var(--ty)); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cyber-section.active .hub-particle-in,
    .cyber-section.active .hub-particle-out,
    .cyber-section.active .hub-ring,
    .cyber-section.active .hub-core,
    .cyber-section.active .hub-node-ping-in,
    .cyber-section.active .hub-node-ping-out { animation: none; }
  }
</style>
