---
const beats = [
  'Read once, understand all — agent context lives in one place, never re-explained.',
  'Code in repos, orchestration in vault — agent dispatches from here to wherever the work actually lives.',
  'Markdown replaces Slack / Linear / Notion — version-controlled, AI-readable, yours forever.',
];
---

<section id="workflow" class="cyber-section reveal" style="--section-accent: #7c3aed;">
  <div class="cyber-section-orb" aria-hidden="true"></div>
  <div class="cyber-section-grid" aria-hidden="true"></div>

  <div class="cyber-section-shell">
    <div class="workflow-top">
      <div class="workflow-text">
        <header class="cyber-section-head">
          <div class="cyber-pill">
            <span class="cyber-pill-dot"></span>
            <span>ONEBRAIN // WORKFLOW</span>
          </div>
          <h2 class="cyber-h2">
            One Vault,<br/>
            <span class="cyber-h2-stroke">All Projects.</span>
          </h2>
          <p class="cyber-sub">
            <strong class="brand">OneBrain</strong> turns Obsidian into your command center — research, planning, agent memory, project state, all in one place. No tab juggling. No tool sprawl.
          </p>
        </header>

        <ul class="workflow-recap">
          {beats.map((b) => (
            <li>
              <span class="workflow-recap-mark">»</span>
              <span>{b}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Hub-and-spokes diagram (synced from README vault-hub) -->
      <figure class="workflow-hub">
        <span class="workflow-hub-corner workflow-hub-corner-tl" aria-hidden="true"></span>
        <span class="workflow-hub-corner workflow-hub-corner-tr" aria-hidden="true"></span>
        <span class="workflow-hub-corner workflow-hub-corner-bl" aria-hidden="true"></span>
        <span class="workflow-hub-corner workflow-hub-corner-br" aria-hidden="true"></span>

        <div class="workflow-hub-band" aria-hidden="true">
          <span class="workflow-hub-band-dot"></span>
          <span class="workflow-hub-band-label">VAULT_HUB · OBSIDIAN</span>
          <span class="workflow-hub-band-meta">8_SPOKES_LIVE</span>
        </div>

        <img
          src="/diagrams/vault-hub.svg"
          alt="Hub-and-spoke diagram. Obsidian vault sits at the center, with eight spokes radiating outward to CLI/repo, website, cloud infra, social media, office docs, project notes, research, and MCP server."
          class="workflow-hub-svg"
          width="640"
          height="480"
          loading="lazy"
          decoding="async"
        />

        <div class="workflow-hub-foot" aria-hidden="true">
          <span class="workflow-hub-foot-mute">ONE_VAULT · ALL_PROJECTS</span>
        </div>
      </figure>

    </div>
  </div>
</section>

<style>
  /* Section-scoped sizing */
  #workflow .cyber-h2           { font-size: clamp(2rem, 4.6vw, 4rem); }
  #workflow .cyber-pill         { margin-bottom: 18px; }
  #workflow .cyber-section-head { margin-bottom: 1rem; }

  .workflow-top {
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .workflow-top {
      grid-template-columns: 3fr 2fr;
      gap: 3rem;
    }
  }

  .workflow-text {
    display: flex;
    flex-direction: column;
  }
  .workflow-recap {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 1rem;
  }
  .workflow-recap li {
    display: grid;
    grid-template-columns: 14px 1fr;
    gap: 10px;
    align-items: start;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.78);
  }
  .workflow-recap-mark {
    color: var(--section-accent);
    font-weight: 700;
  }

  /* ── RIGHT: hub diagram ── */
  /* Border + band + foot mirror the HowItWorks loop card so the two
     section diagrams read as one visual family — corner brackets at
     each edge, a header with pulsing dot + label + meta on the right,
     a muted footer line. The SVG sits between band and foot. */
  .workflow-hub {
    position: relative;
    padding: 14px 14px 12px;
    background: rgba(8, 8, 14, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  .workflow-hub-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1px solid rgba(255, 255, 255, 0.35);
  }
  .workflow-hub-corner-tl { top: -1px;    left: -1px;    border-right: 0; border-bottom: 0; }
  .workflow-hub-corner-tr { top: -1px;    right: -1px;   border-left: 0;  border-bottom: 0; }
  .workflow-hub-corner-bl { bottom: -1px; left: -1px;    border-right: 0; border-top: 0; }
  .workflow-hub-corner-br { bottom: -1px; right: -1px;   border-left: 0;  border-top: 0; }

  .workflow-hub-band {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 4px 8px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.28em;
    color: rgba(255, 255, 255, 0.45);
    text-transform: uppercase;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    margin-bottom: 6px;
  }
  .workflow-hub-band-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--section-accent);
    box-shadow: 0 0 10px var(--section-accent);
    flex-shrink: 0;
    animation: workflow-band-pulse 2.4s ease-in-out infinite;
  }
  @keyframes workflow-band-pulse {
    0%, 100% { opacity: 1;   transform: scale(1);    }
    50%      { opacity: 0.4; transform: scale(0.85); }
  }
  .workflow-hub-band-meta { margin-left: auto; }

  .workflow-hub-svg {
    display: block;
    width: 100%;
    max-width: 520px;
    height: auto;
    margin: 0 auto;
  }

  .workflow-hub-foot {
    margin-top: 6px;
    padding: 8px 4px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.28em;
    color: rgba(255, 255, 255, 0.35);
    text-transform: uppercase;
    text-align: right;
  }

  /* Mobile: trim the third recap beat so the section settles in fewer
     screens — first 2 beats already carry the "vault as command center"
     idea. */
  @media (max-width: 720px) {
    .workflow-recap li:nth-child(3) { display: none; }
    .workflow-hub-band-meta,
    .workflow-hub-foot { display: none; }
    .workflow-hub { padding: 12px 10px 10px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .workflow-hub-band-dot { animation: none; }
  }
</style>
