---
const beats = [
  {
    n: '01',
    label: 'CONTEXT POOL',
    body: 'Every project, decision, research thread, and agent memory lives in the vault. The agent reads one place and understands the whole picture — no context switching, no re-explaining.',
  },
  {
    n: '02',
    label: 'DISPATCH',
    body: 'Agent goes from the vault to the repo, the website source, the infra dashboard, the API spec — wherever the work actually lives. Code stays in its place; orchestration stays here.',
  },
  {
    n: '03',
    label: 'NO TOOL SPRAWL',
    body: 'Slack threads, Linear tickets, Notion docs, scattered spreadsheets — all collapse into one place: plain markdown in your vault. Version-controlled, AI-readable, yours forever.',
  },
];

// Hub-and-spokes map of where the agent dispatches FROM the vault.
// Each entry includes:
//  - label-anchor hint so SVG text doesn't run off the diagram edge
//  - duration + inbound flag so each particle has its own pace
//    (varied 2.6–4.6s) and direction. inbound=true → data flows
//    outer→centre (project sending into vault); inbound=false →
//    data flows centre→outer (vault dispatching to project).
const dispatches = [
  { angle: -90, label: 'CLI / REPO',    anchor: 'middle', duration: 3.4, inbound: false },
  { angle: -52, label: 'WEBSITE',       anchor: 'start',  duration: 2.8, inbound: true  },
  { angle: -16, label: 'CLOUD INFRA',   anchor: 'start',  duration: 4.2, inbound: false },
  { angle:  22, label: 'SOCIAL MEDIA',  anchor: 'start',  duration: 3.0, inbound: true  },
  { angle:  62, label: 'OFFICE DOCS',   anchor: 'start',  duration: 3.8, inbound: false },
  { angle: 110, label: 'PROJECT NOTES', anchor: 'middle', duration: 2.6, inbound: true  },
  { angle: 152, label: 'RESEARCH',      anchor: 'end',    duration: 4.6, inbound: false },
  { angle: 200, label: 'MCP SERVER',    anchor: 'end',    duration: 3.2, inbound: true  },
];
---

<section id="workflow" class="cyber-section reveal" style="--section-accent: #ff5e3a;">
  <div class="cyber-section-orb" aria-hidden="true"></div>
  <div class="cyber-section-grid" aria-hidden="true"></div>

  <div class="cyber-section-shell">

    <!-- Top row: 50:50 split — section header on the left, the three
         narrative beats on the right. Lifts the beats up alongside
         the headline so the right half of the section above the
         diagram isn't dead space. -->
    <div class="workflow-top">
      <header class="cyber-section-head">
        <div class="cyber-pill">
          <span class="cyber-pill-dot"></span>
          <span>ONEBRAIN // WORKFLOW</span>
        </div>
        <h2 class="cyber-h2">
          One Vault.<br/>
          <span class="cyber-h2-stroke">All Your Projects.</span>
        </h2>
        <p class="cyber-sub">
          Obsidian becomes your <strong>command center</strong> — research, planning, agent memory, project state, all in one place. No tab juggling. No tool sprawl.
        </p>
      </header>

      <div class="workflow-beats">
        {beats.map((b) => (
          <div class="cyber-card workflow-beat">
            <span class="workflow-beat-num">{b.n}</span>
            <h3 class="cyber-card-title workflow-beat-label">{b.label}</h3>
            <p class="cyber-card-desc workflow-beat-body">{b.body}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Bottom: hub diagram, centred and full-width below the
         header row. -->
    <div class="workflow-hub-wrap">

      <!-- Hub-and-spokes diagram with inline labels + animated
           data-flow particles. Each spoke gets one particle that
           travels centre↔outer-node on a loop, staggered so the
           pulses feel alive without strobing. -->
      <div class="workflow-hub" aria-hidden="true">
        <svg viewBox="-280 -200 560 400" class="workflow-hub-svg">
          <!-- Outer ring -->
          <circle cx="0" cy="0" r="150" class="hub-ring" />

          <!-- Spokes + outer nodes + labels -->
          {dispatches.map((d) => {
            const rad = (d.angle * Math.PI) / 180;
            const nodeR = 150;
            const labelR = 175;
            const nx = Math.cos(rad) * nodeR;
            const ny = Math.sin(rad) * nodeR;
            const lx = Math.cos(rad) * labelR;
            const ly = Math.sin(rad) * labelR
              + (d.anchor === 'middle' ? (Math.sin(rad) > 0 ? 14 : -8) : 4);
            return (
              <g>
                <line x1="0" y1="0" x2={nx} y2={ny} class="hub-spoke" />
                <circle cx={nx} cy={ny} r="5" class="hub-node" />
                <text x={lx} y={ly} text-anchor={d.anchor} class="hub-node-label">{d.label}</text>
              </g>
            );
          })}

          <!-- Data-flow particles — one per spoke. Each carries its
               own duration + direction, so the eight pulses don't
               sync into a strobe. CSS --tx/--ty hold each spoke's
               outer endpoint; the .hub-particle-in / -out class
               picks which keyframe to follow (inbound vs outbound). -->
          {dispatches.map((d, i) => {
            const rad = (d.angle * Math.PI) / 180;
            const tx = Math.cos(rad) * 150;
            const ty = Math.sin(rad) * 150;
            // Stagger via prime-ish multiplier so identical durations
            // don't realign every cycle.
            const delay = ((i * 0.37) % d.duration).toFixed(2);
            const dir = d.inbound ? 'hub-particle-in' : 'hub-particle-out';
            return (
              <circle
                r="3.5"
                class={`hub-particle ${dir}`}
                style={`--tx: ${tx.toFixed(1)}px; --ty: ${ty.toFixed(1)}px; animation-duration: ${d.duration}s; animation-delay: ${delay}s;`}
              />
            );
          })}

          <!-- Centre: Obsidian vault as command center -->
          <circle cx="0" cy="0" r="52" class="hub-core" />
          <text x="0" y="-3" text-anchor="middle" class="hub-core-label">OBSIDIAN</text>
          <text x="0" y="13" text-anchor="middle" class="hub-core-sub">vault</text>
        </svg>
      </div>

    </div>
  </div>
</section>

<style>
  /* Section-scoped tightening — the workflow section's diagram + 3
     stacked beats was running taller than the visible viewport on
     laptop heights, mirroring the Features-section issue. Trim the
     header rhythm and the beat padding so everything centres in
     view without spilling below the fold. */
  #workflow .cyber-h2          { font-size: clamp(2rem, 4.6vw, 4rem); }
  #workflow .cyber-pill         { margin-bottom: 18px; }
  /* Margin-bottom on the section-head is handled by .workflow-top
     gap on desktop (where header sits left, beats sit right) and
     on mobile (where they stack). Reset the default margin so it
     doesn't push beats unevenly down on the desktop split. */
  #workflow .cyber-section-head { margin-bottom: 0; }

  /* Top row: 50:50 — header + sub on the left, three beats on the
     right. On mobile they stack so the section still reads cleanly. */
  .workflow-top {
    display: grid;
    gap: 1.5rem;
    align-items: start;
    margin-bottom: 1.75rem;
  }
  @media (min-width: 1024px) {
    .workflow-top {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
      align-items: center;
    }
  }

  /* ── BOTTOM: hub diagram, full-width centred ── */

  .workflow-hub-wrap {
    display: flex;
    justify-content: center;
  }
  .workflow-hub {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }
  .workflow-hub-svg {
    width: 100%;
    max-width: 720px;
    aspect-ratio: 1.55 / 1;
    overflow: visible;
  }

  .hub-ring {
    fill: none;
    stroke: color-mix(in srgb, var(--section-accent) 18%, transparent);
    stroke-width: 1;
    stroke-dasharray: 3 5;
  }
  .hub-spoke {
    stroke: color-mix(in srgb, var(--section-accent) 35%, transparent);
    stroke-width: 1;
  }
  .hub-node {
    fill: var(--section-accent);
  }
  .hub-node-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    fill: rgba(255, 255, 255, 0.85);
  }
  .hub-core {
    fill: rgba(2, 2, 4, 0.92);
    stroke: var(--section-accent);
    stroke-width: 1.5;
  }
  .hub-core-label {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    fill: #fff;
  }
  .hub-core-sub {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.32em;
    fill: var(--section-accent);
  }

  /* Data-flow particles. White dots so they read clearly against
     the accent-coloured spokes — they're "data packets in transit",
     not part of the structure. Each particle has its own direction
     (in or out), duration, and stagger delay (set inline) so the
     eight pulses feel like asynchronous traffic, not a strobe.
     Animation gated to .cyber-section.active so off-screen workflow
     doesn't leak paint cost onto scroll-snap glides. */
  .hub-particle {
    fill: #ffffff;
    opacity: 0;
    will-change: transform, opacity;
  }
  .cyber-section.active .hub-particle-out {
    animation-name: hub-particle-flow-out;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }
  .cyber-section.active .hub-particle-in {
    animation-name: hub-particle-flow-in;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }
  /* Outbound: vault dispatches to project — start at centre,
     travel to outer node, return. */
  @keyframes hub-particle-flow-out {
    0%   { transform: translate(0, 0);                 opacity: 0; }
    8%   {                                             opacity: 1; }
    50%  { transform: translate(var(--tx), var(--ty)); opacity: 1; }
    92%  {                                             opacity: 1; }
    100% { transform: translate(0, 0);                 opacity: 0; }
  }
  /* Inbound: project pushes data to vault — start at outer, travel
     to centre, return. */
  @keyframes hub-particle-flow-in {
    0%   { transform: translate(var(--tx), var(--ty)); opacity: 0; }
    8%   {                                             opacity: 1; }
    50%  { transform: translate(0, 0);                 opacity: 1; }
    92%  {                                             opacity: 1; }
    100% { transform: translate(var(--tx), var(--ty)); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cyber-section.active .hub-particle-in,
    .cyber-section.active .hub-particle-out { animation: none; }
  }

  /* ── RIGHT: 3 beats ── */

  .workflow-beats {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .workflow-beat {
    padding: 0.95rem 1.2rem;
    position: relative;
    border-left: 2px solid color-mix(in srgb, var(--section-accent) 50%, transparent);
  }
  .workflow-beat-num {
    position: absolute;
    top: 0.8rem;
    right: 1rem;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.32em;
    color: rgba(255, 255, 255, 0.3);
  }
  .workflow-beat-label {
    color: var(--section-accent);
    letter-spacing: 0.16em;
    margin: 0 0 6px;
    font-size: 0.9rem;
  }
  .workflow-beat-body {
    margin: 0;
    line-height: 1.55;
    font-size: 12px;
  }
</style>
